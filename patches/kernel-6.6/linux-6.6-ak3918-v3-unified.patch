+/**
+ * 根据 SENSOR 4A/4C/4F 三个值获取 BLC Gb 的值。
+ */
+static int get_blc_gb (int reg0x4a, int reg0x4c, int reg0x4f) {
+
+	int blc_gb = 0;
+
+	reg0x4a >>= 6;
+	reg0x4a &= 0x01; ///< 0X4A BIT6
+	reg0x4f >>= 2;
+	reg0x4f &= 0x03; ///< 0X4F BIT[3:2]
+	reg0x4c &= 0xff;
+
+	blc_gb = (reg0x4a << 10) | (reg0x4f << 8) | reg0x4c;
+	return blc_gb;
+
+}
