+/*
+ * Config-block word indices that moved between the two parts. EV200 has two
+ * output channels where EV300 has three, so every word after a dropped
+ * channel-3 word shifts down. Both builds place the blocks at byte-identical
+ * offsets from isp->area, so an index maps 1:1 to a hardware register and
+ * getting one wrong is an absolute error, not an offset error.
+ */
+#ifdef CONFIG_CPU_AK3918EV200
+#define     R1_STAT_ADDR2           49      /* .. 51, then 52 reserved */
+#define     R1_TNR_YADDR            53      /* .. 58 */
+#define     R5_STAT_ADDR1           31
+#define     R5_ENABLE               32
+#define     R4_OSD_COLOR_TABLE      11      /* .. 22 */
+#define     R4_MASK_COLOR           23
+#define     R4_MAIN_OSD             24      /* .. 26, one region */
+#define     R4_SUB_OSD              27      /* .. 29, one region */
+#define     R4_MAIN_SCALE           30      /* rate, then dst */
+#define     R4_SUB_SCALE            32
+#define     R4_FRAME_CTRL           34
+#else
+#define     R1_STAT_ADDR2           58
+#define     R1_TNR_YADDR            61
+#define     R5_STAT_ADDR1           34
+#define     R5_ENABLE               35
+#define     R4_OSD_COLOR_TABLE      16
+#define     R4_MASK_COLOR           28
+#define     R4_MAIN_OSD             29      /* .. 37, three regions */
+#define     R4_SUB_OSD              38      /* .. 46, three regions */
+#define     R4_MAIN_SCALE           47
+#define     R4_SUB_SCALE            49
+#define     R4_FRAME_CTRL           51
+#endif
+
+#endif
diff --git a/drivers/media/platform/anyka-isp/ak39_vi.c b/drivers/media/platform/anyka-isp/ak39_vi.c
new file mode 100644
index 000000000..42f5fa12c
--- /dev/null
+++ b/drivers/media/platform/anyka-isp/ak39_vi.c
@@ -0,0 +1,910 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Anyka AK3918EV300 video input (ISP2 + MIPI CSI-2 receiver), V4L2/vb2.
+ *
+ * Linux 6.6 replacement for the 4.4 soc_camera host (ak_camera.c), which
+ * mainline no longer has. The ISP core (ak39_isp2*.c), its tuning loader
+ * (ak_isp_char.c, /dev/isp_char) and the sensor callbacks
+ * (sensor_f22_f23_f28_f35_f37.c) are the 4.4 sources unchanged; this file
+ * only does what ak_camera.c did around them:
+ *
+ *  - board bring-up: sensor pads, CIS clock, MIPI D-PHY (2 lanes for the
+ *    TC100's JX-F23), as the stock akcamera.ko does;
+ *  - sensor identification over I2C, then ak_isp_acquire()/ak_isp_prepare()
+ *    which load /lib/firmware/anyka/isp.conf and write the sensor's init list;
+ *  - the ISP's four output slots in continuous mode, each a vb2 buffer;
+ *  - the AE/AWB work after every frame.
+ *
+ * One buffer holds the main channel (NV12, the format size) followed by the
+ * sub channel (NV12, sub-width x sub-height, 640x360 by default): what the
+ * vendor encoder pipeline expects. bytesused covers both; the sub channel
+ * starts at width*height*3/2.
+ *
+ * Lessons from the 4.4 port (TC100, 2026-10-21):
+ *  - SHAREPIN_CON2 (SYSCTRL 0x78) bits 19-24 must be clear on EV300, or
+ *    the ISP never gets a frame;
+ *  - F23 runs at 768 Mbps, THS-SETTLE index 9;
+ *  - the ISP core is released on close so the next open re-runs the sensor
+ *    init list.
+ */
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-fh.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include <plat-anyka/ak_isp_drv.h>
+#include <plat-anyka/ak_sensor.h>
+#include <plat-anyka/ak_sensor_i2c.h>
+#include <plat-anyka/ak_isp_lifecycle.h>
+#include <mach-anyka/ispdrv_interface.h>
+#include <uapi/linux/ak39_vi.h>
+
+#define DRV_NAME	"ak39-vi"
+#define NUM_SLOTS	4
+#define SUB_W		640
+#define SUB_H		360
+
+/* program the 640x360 sub channel at stream start (the hardware sub picture of tc100_rtsp); ak39_vi.sub_channel=0 on
+ * the kernel command line turns it off */
+static int sub_channel = 1;
+static int guard;
+module_param(guard, int, 0444);
+MODULE_PARM_DESC(guard, "debug: fill the buffer tails with 0xA5 and report ISP writes past the main frame");
+module_param(sub_channel, int, 0444);
+MODULE_PARM_DESC(sub_channel, "program the ISP sub channel (640x360) at stream start");
+
+/* SYSCTRL */
+#define SYS_PERI_CTRL1	0x14
+#define SYS_PERI_CTRL2	0x18
+#define SYS_RESET	0x20
+#define SYS_SHARE0	0x74
+#define SYS_SHARE1	0x78
+#define RST_MIPI	16
+#define RST_ISP		19
+
+extern struct device *ak_isp_dma_dev;
+int ak_sensor_i2c_set_client(struct i2c_client *client);
+void ak_sensor_set_sensor_cb(AK_ISP_SENSOR_CB *cb);
+
+struct ak39_vi_buf {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+	bool primed, tripped;	/* guard mode */
+};
+
+struct ak39_vi {
+	struct device *dev;
+	struct v4l2_device v4l2;
+	struct video_device vdev;
+	struct vb2_queue q;
+	struct mutex lock;
+	spinlock_t slock;
+	struct list_head active;	/* in the ISP slots, oldest first */
+
+	void __iomem *sys;
+	void __iomem *mipi;
+	int irq;
+	struct i2c_adapter *adap;
+	struct i2c_client *client;
+	AK_ISP_SENSOR_CB *scb;
+	bool isp_owned;
+
+	u32 width, height, sizeimage;
+	u32 seq;
+	unsigned int mclk_mhz;
+	u32 share0_set, share_board[4];
+
+	void *ref_y, *ref_uv;
+	dma_addr_t ref_y_dma, ref_uv_dma;
+	size_t ref_y_bytes, ref_uv_bytes;
+
+	struct delayed_work ae_work, awb_work, guard_work;
+	size_t guard_last[4];
+	unsigned long irq_jiffies;
+	u32 frames, lost;
+};
+
+static inline struct ak39_vi_buf *to_vi_buf(struct vb2_v4l2_buffer *v)
+{
+	return container_of(v, struct ak39_vi_buf, vb);
+}
+
+/* --------------------------------------------------------------- clocks -- */
+
+static unsigned long peri_pll_mhz(struct ak39_vi *vi)
+{
+	u32 v = readl(vi->sys + SYS_PERI_CTRL1);
+	unsigned long m = v & 0xff, n = (v >> 8) & 0xf, od = (v >> 12) & 3;
+
+	if (!n)
+		return 600;
+	return 12 * m / (n * (1 << od));
+}
+
+static void sys_bit(struct ak39_vi *vi, u32 off, int bit, int on)
+{
+	u32 v = readl(vi->sys + off);
+
+	writel(on ? v | BIT(bit) : v & ~BIT(bit), vi->sys + off);
+}
+
+static void soft_reset(struct ak39_vi *vi, int bit)
+{
+	sys_bit(vi, SYS_RESET, bit, 1);
+	mdelay(5);
+	sys_bit(vi, SYS_RESET, bit, 0);
+}
+
+static void set_cis_sclk(struct ak39_vi *vi, unsigned int mhz)
+{
+	u32 v = readl(vi->sys + SYS_PERI_CTRL2);
+	u32 div = peri_pll_mhz(vi) / mhz - 1;
+
+	v &= ~(0x3f << 10);
+	v |= div << 10;
+	writel(v | BIT(19), vi->sys + SYS_PERI_CTRL2);	/* update */
+	writel(readl(vi->sys + SYS_PERI_CTRL2) | BIT(18), vi->sys + SYS_PERI_CTRL2);
+}
+
+static void wait_cis_pclk(struct ak39_vi *vi)
+{
+	int t = 0xffff;
+
+	while ((readl(vi->sys + SYS_PERI_CTRL2) & BIT(29)) && t--)
+		;
+}
+
+static void set_cis_pclk(struct ak39_vi *vi, unsigned int mhz)
+{
+	u32 div = peri_pll_mhz(vi) / mhz;
+	u32 v;
+
+	sys_bit(vi, SYS_PERI_CTRL2, 28, 0);
+	wait_cis_pclk(vi);
+	v = readl(vi->sys + SYS_PERI_CTRL2) & ~(0x3f << 20);
+	writel(v | ((div - 1) << 20), vi->sys + SYS_PERI_CTRL2);
+	sys_bit(vi, SYS_PERI_CTRL2, 29, 1);
+	wait_cis_pclk(vi);
+	sys_bit(vi, SYS_PERI_CTRL2, 28, 1);
+	wait_cis_pclk(vi);
+}
+
+/* --------------------------------------------------------------- D-PHY -- */
+
+static int mhz_to_thssettle(int mhz)
+{
+	static const int top[] = { 110, 150, 200, 250, 300, 400, 500, 600,
+				   700, 800, 1000 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(top); i++)
+		if (mhz <= top[i])
+			return i;
+	return ARRAY_SIZE(top) - 1;
+}
+
+static void mipi_setup(struct ak39_vi *vi)
+{
+	int mhz = 768, lanes = 2;
+	u8 ths;
+
+	if (vi->scb && vi->scb->sensor_get_parameter_func) {
+		vi->scb->sensor_get_parameter_func(GET_MIPI_MHZ, &mhz);
+		vi->scb->sensor_get_parameter_func(GET_MIPI_LANE, &lanes);
+	}
+	ths = 0x80 | mhz_to_thssettle(mhz);
+
+	set_cis_pclk(vi, 75);
+	writel(readl(vi->sys + SYS_SHARE0) | 0x40000010, vi->sys + SYS_SHARE0);
+	soft_reset(vi, RST_MIPI);
+	sys_bit(vi, SYS_PERI_CTRL1, 27, 0);	/* byte-clock reset off */
+	sys_bit(vi, SYS_PERI_CTRL1, 24, 1);	/* pclk from the PLL */
+	sys_bit(vi, SYS_PERI_CTRL1, 26, 1);	/* CIS input: MIPI */
+	soft_reset(vi, RST_MIPI);
+
+	writeb(0x7d, vi->mipi + 0x00);
+	if (lanes == 2) {
+		writeb(0x1f, vi->mipi + 0x20);
+		writeb(0xf9, vi->mipi + 0xe0);
+		writeb(0x01, vi->mipi + 0xe1);
+		writeb(ths, vi->mipi + 0x40);
+		writeb(ths, vi->mipi + 0x60);
+		writeb(ths, vi->mipi + 0x80);
+	} else {
+		writeb(ths, vi->mipi + 0x40);
+		writeb(ths, vi->mipi + 0x60);
+		writeb(0xf8, vi->mipi + 0xe0);
+	}
+	writeb(0x02, vi->mipi + 0xb3);		/* IO mode: MIPI */
+	writeb(0x04, vi->mipi + 0xb8);
+	writeb(0xc0, vi->mipi + 0x0d);
+	/* EV300: the EV330 MIPI pin group bits must stay clear (see top) */
+	writel(readl(vi->sys + SYS_SHARE1) & ~0x01F80000, vi->sys + SYS_SHARE1);
+	dev_info(vi->dev, "MIPI %d lane(s), %d Mbps, THS-SETTLE 0x%02x\n",
+		 lanes, mhz, ths);
+}
+
+/* -------------------------------------------------------------- sensor -- */
+
+static AK_ISP_SENSOR_CB *probe_sensor(struct ak39_vi *vi)
+{
+	AK_ISP_SENSOR_CB *si;
+	int index = 0;
+
+	while ((si = ispdrv_get_sensor(&index))) {
+		int rd, want;
+
+		si->sensor_set_power_on_func(-1, -1);
+		rd = si->sensor_read_id_func();
+		want = si->sensor_probe_id_func();
+		if (rd == want) {
+			dev_info(vi->dev, "sensor id 0x%x\n", rd);
+			return si;
+		}
+		si->sensor_set_power_off_func(-1, -1);
+		index++;
+	}
+	return NULL;
+}
+
+/* Everything ak_camera_add_device() + the first S_FMT did on 4.4. */
+static int vi_power_up(struct ak39_vi *vi)
+{
+	int ret, i;
+
+	/* sensor pads / I2C pins as the stock firmware leaves them */
+	for (i = 0; i < 4; i++)
+		if (vi->share_board[i])
+			writel(readl(vi->sys + 0x74 + 4 * i) | vi->share_board[i],
+			       vi->sys + 0x74 + 4 * i);
+
+	sys_bit(vi, 0x1c, 19, 0);		/* camera/ISP clock gate on */
+	sys_bit(vi, SYS_PERI_CTRL1, 25, 0);
+	set_cis_sclk(vi, vi->mclk_mhz);
+	dev_info(vi->dev, "power up: share 74=%08x 78=%08x 7c=%08x clk2=%08x\n",
+		 readl(vi->sys + 0x74), readl(vi->sys + 0x78),
+		 readl(vi->sys + 0x7c), readl(vi->sys + SYS_PERI_CTRL2));
+	soft_reset(vi, RST_ISP);
+	msleep(5);
+
+	vi->scb = probe_sensor(vi);
+	if (!vi->scb) {
+		dev_err(vi->dev, "no sensor answered on I2C\n");
+		return -ENODEV;
+	}
+	ak_sensor_set_sensor_cb(vi->scb);
+	mipi_setup(vi);
+
+	ret = ak_isp_acquire(NULL, NULL);
+	if (ret)
+		return ret;
+	vi->isp_owned = true;
+	ret = ak_isp_prepare(vi->dev);	/* tuning + sensor init list */
+	if (ret || !ispdrv_is_ready()) {
+		dev_err(vi->dev, "ISP core did not come up: %d\n", ret);
+		return ret ? ret : -ENODEV;
+	}
+	return 0;
+}
+
+static void vi_power_down(struct ak39_vi *vi)
+{
+	if (vi->isp_owned) {
+		ak_isp_release();
+		vi->isp_owned = false;
+	}
+	if (vi->scb)
+		vi->scb->sensor_set_power_off_func(-1, -1);
+	vi->scb = NULL;
+	sys_bit(vi, SYS_PERI_CTRL2, 18, 0);	/* CIS sclk off */
+}
+
+/* ---------------------------------------------------- 3D-NR ref frame -- */
+
+static void free_ref(struct ak39_vi *vi)
+{
+	if (vi->ref_y)
+		dma_free_coherent(vi->dev, vi->ref_y_bytes, vi->ref_y, vi->ref_y_dma);
+	if (vi->ref_uv)
+		dma_free_coherent(vi->dev, vi->ref_uv_bytes, vi->ref_uv, vi->ref_uv_dma);
+	vi->ref_y = vi->ref_uv = NULL;
+}
+
+static void program_ref(struct ak39_vi *vi)
+{
+	size_t px = vi->width * vi->height;
+	AK_ISP_3D_NR_REF_ATTR ref;
+
+	if (!vi->ref_y) {
+		vi->ref_y_bytes = px * 2;
+		vi->ref_uv_bytes = px;
+		vi->ref_y = dma_alloc_coherent(vi->dev, vi->ref_y_bytes,
+					       &vi->ref_y_dma, GFP_KERNEL);
+		vi->ref_uv = dma_alloc_coherent(vi->dev, vi->ref_uv_bytes,
+						&vi->ref_uv_dma, GFP_KERNEL);
+		if (!vi->ref_y || !vi->ref_uv) {
+			free_ref(vi);
+			ispdrv_vp_3d_nr_noref(1);
+			dev_warn(vi->dev, "no memory for the 3D-NR reference frame, 3D-NR disabled\n");
+			return;
+		}
+	}
+	ispdrv_vp_3d_nr_noref(0);
+	ref.yaddr_3d = vi->ref_y_dma;
+	ref.ysize_3d = vi->ref_y_bytes;
+	ref.uaddr_3d = vi->ref_uv_dma;
+	ref.usize_3d = vi->ref_uv_bytes / 2;
+	ref.vaddr_3d = vi->ref_uv_dma + vi->ref_uv_bytes / 2;
+	ref.vsize_3d = vi->ref_uv_bytes / 2;
+	ispdrv_vp_set_3d_nr_ref_addr(&ref);
+}
+
+/* ----------------------------------------------------------------- 3A -- */
+
+static void ae_work(struct work_struct *w)
+{
+	struct ak39_vi *vi = container_of(w, struct ak39_vi, ae_work.work);
+	int fps = 25, active = 36, delay;
+
+	if (vi->scb && vi->scb->sensor_get_parameter_func) {
+		vi->scb->sensor_get_parameter_func(GET_CUR_FPS, &fps);
+		vi->scb->sensor_get_parameter_func(GET_VSYNC_ACTIVE_MS, &active);
+	}
+	if (fps <= 0)
+		fps = 25;
+	delay = 1000 / fps - active + 1;
+	delay -= jiffies_to_msecs(jiffies - vi->irq_jiffies);
+	if (delay > 0)
+		usleep_range(delay * 1000, delay * 1000 + 1000);
+	ispdrv_ae_work();
+}
+
+static void awb_work(struct work_struct *w)
+{
+	ispdrv_awb_work();
+}
+
+/* ---------------------------------------------------------------- irq -- */
+
+static void guard_check(struct ak39_vi *vi, struct vb2_buffer *vb);
+
+static irqreturn_t vi_irq(int irq, void *data)
+{
+	struct ak39_vi *vi = data;
+	struct ak39_vi_buf *head;
+	unsigned long flags;
+	int id;
+
+	if (!(ispdrv_vo_check_irq_status() & 1)) {
+		ispdrv_vo_clear_irq_status(0xfffe);
+		return IRQ_HANDLED;
+	}
+	vi->irq_jiffies = jiffies;
+	ispdrv_irq_work();
+
+	spin_lock_irqsave(&vi->slock, flags);
+	id = ispdrv_vo_get_using_frame_buf_id();
+	head = list_first_entry_or_null(&vi->active, struct ak39_vi_buf, list);
+	/*
+	 * As ak_camera.c: the frame just finished is the oldest queued slot;
+	 * hand it back only if another slot stays armed for the hardware.
+	 */
+	if (head && id >= 0 && (id & 0x7f) == head->vb.vb2_buf.index &&
+	    !list_is_singular(&vi->active)) {
+		guard_check(vi, &head->vb.vb2_buf);
+		list_del(&head->list);
+		ispdrv_vo_disable_buffer(BUFFER_ONE + head->vb.vb2_buf.index);
+		head->vb.vb2_buf.timestamp = ktime_get_ns();
+		head->vb.sequence = vi->seq++;
+		head->vb.field = V4L2_FIELD_NONE;
+		vb2_set_plane_payload(&head->vb.vb2_buf, 0, vi->sizeimage);
+		vb2_buffer_done(&head->vb.vb2_buf, id >= 0x80 ?
+				VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+		vi->frames++;
+	} else if (head) {
+		vi->lost++;
+	}
+	spin_unlock_irqrestore(&vi->slock, flags);
+
+	schedule_delayed_work(&vi->awb_work, 0);
+	schedule_delayed_work(&vi->ae_work, 0);
+	ispdrv_vo_clear_irq_status(0xffff);
+	return IRQ_HANDLED;
+}
+
+/* ------------------------------------------------- guard (debug) -- */
+
+/*
+ * ak39_vi.guard=1: the part of each buffer past the main frame (sub-channel
+ * area + 4 KiB slack) is filled with 0xA5 once; the slack is checked every
+ * frame (an ISP write past the buffer end shows up as a GUARD error) and a
+ * work item reports how far into that tail the ISP has written.
+ */
+#define GUARD_PAT	0xA5
+#define GUARD_SLACK	4096
+
+static void guard_prime(struct ak39_vi *vi, struct vb2_buffer *vb)
+{
+	struct ak39_vi_buf *b = to_vi_buf(to_vb2_v4l2_buffer(vb));
+	u8 *p = vb2_plane_vaddr(vb, 0);
+
+	if (!guard || b->primed || !p || vb2_plane_size(vb, 0) <= vi->sizeimage)
+		return;
+	memset(p + vi->sizeimage, GUARD_PAT, vb2_plane_size(vb, 0) - vi->sizeimage);
+	b->primed = true;
+}
+
+static void guard_check(struct ak39_vi *vi, struct vb2_buffer *vb)
+{
+	struct ak39_vi_buf *b = to_vi_buf(to_vb2_v4l2_buffer(vb));
+	u8 *p = vb2_plane_vaddr(vb, 0), *bad;
+	size_t len = vb2_plane_size(vb, 0);
+
+	if (!guard || !b->primed || b->tripped || !p || len < GUARD_SLACK)
+		return;
+	bad = memchr_inv(p + len - GUARD_SLACK, GUARD_PAT, GUARD_SLACK);
+	if (bad) {
+		b->tripped = true;
+		dev_err(vi->dev, "GUARD: ISP wrote past the end of buffer %u (+%zu in the slack)\n",
+			vb->index, (size_t)(bad - (p + len - GUARD_SLACK)));
+	}
+}
+
+static void guard_work_fn(struct work_struct *w)
+{
+	struct ak39_vi *vi = container_of(w, struct ak39_vi, guard_work.work);
+	unsigned int i;
+
+	for (i = 0; i < vi->q.num_buffers && i < 4; i++) {
+		struct vb2_buffer *vb = vi->q.bufs[i];
+		u8 *p = vb ? vb2_plane_vaddr(vb, 0) : NULL;
+		size_t n, k;
+
+		if (!p || vb2_plane_size(vb, 0) <= vi->sizeimage)
+			continue;
+		n = vb2_plane_size(vb, 0) - vi->sizeimage;
+		p += vi->sizeimage;
+		for (k = n; k > 0 && p[k - 1] == GUARD_PAT; k--)
+			;
+		if (k != vi->guard_last[i]) {
+			vi->guard_last[i] = k;
+			dev_info(vi->dev, "GUARD: buffer %u tail written up to +%zu of %zu (sub area %u, slack %u)\n",
+				 i, k, n, SUB_W * SUB_H * 3 / 2, GUARD_SLACK);
+		}
+	}
+	schedule_delayed_work(&vi->guard_work, 5 * HZ);
+}
+
+/* ---------------------------------------------------------------- vb2 -- */
+
+static int queue_setup(struct vb2_queue *q, unsigned int *nbuf,
+		       unsigned int *nplanes, unsigned int sizes[],
+		       struct device *alloc_devs[])
+{
+	struct ak39_vi *vi = vb2_get_drv_priv(q);
+	unsigned int size = vi->sizeimage + SUB_W * SUB_H * 3 / 2 + 4096;
+
+	*nbuf = NUM_SLOTS;	/* the ISP has exactly four output slots */
+	if (*nplanes)
+		return sizes[0] < size ? -EINVAL : 0;
+	*nplanes = 1;
+	sizes[0] = size;
+	return 0;
+}
+
+static int buf_prepare(struct vb2_buffer *vb)
+{
+	struct ak39_vi *vi = vb2_get_drv_priv(vb->vb2_queue);
+
+	if (vb->index >= NUM_SLOTS)
+		return -EINVAL;
+	if (vb2_plane_size(vb, 0) < vi->sizeimage)
+		return -EINVAL;
+	guard_prime(vi, vb);
+	return 0;
+}
+
+static void arm_slot(struct ak39_vi *vi, struct vb2_buffer *vb)
+{
+	dma_addr_t y = vb2_dma_contig_plane_dma_addr(vb, 0);
+
+	ispdrv_vo_set_buffer_addr(BUFFER_ONE + vb->index, y,
+				  y + vi->width * vi->height * 3 / 2);
+	ispdrv_vo_enable_buffer(BUFFER_ONE + vb->index);
+}
+
+static void buf_queue(struct vb2_buffer *vb)
+{
+	struct ak39_vi *vi = vb2_get_drv_priv(vb->vb2_queue);
+	struct ak39_vi_buf *b = to_vi_buf(to_vb2_v4l2_buffer(vb));
+	unsigned long flags;
+
+	spin_lock_irqsave(&vi->slock, flags);
+	list_add_tail(&b->list, &vi->active);
+	if (vb2_is_streaming(vb->vb2_queue))
+		arm_slot(vi, vb);
+	spin_unlock_irqrestore(&vi->slock, flags);
+}
+
+static void return_all(struct ak39_vi *vi, enum vb2_buffer_state st)
+{
+	struct ak39_vi_buf *b, *n;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vi->slock, flags);
+	list_for_each_entry_safe(b, n, &vi->active, list) {
+		list_del(&b->list);
+		vb2_buffer_done(&b->vb.vb2_buf, st);
+	}
+	spin_unlock_irqrestore(&vi->slock, flags);
+}
+
+static int start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct ak39_vi *vi = vb2_get_drv_priv(q);
+	struct ak39_vi_buf *b;
+	int i, ret;
+
+	ret = vi_power_up(vi);
+	dev_info(vi->dev, "power up: %d\n", ret);
+	if (ret)
+		goto fail;
+
+	/* as v4l2 S_CROP did on 4.4: the full window past the sensor's
+	 * invalid border, then the output scale (the sub channel keeps the
+	 * ISP default, as on 4.4) */
+	{
+		int l = 0, t = 0;
+
+		if (vi->scb->sensor_get_valid_coordinate_func)
+			vi->scb->sensor_get_valid_coordinate_func(&l, &t);
+		ret = ispdrv_vi_set_crop(l, t, vi->width, vi->height);
+		dev_info(vi->dev, "crop %d,%d %ux%u: %d\n", l, t,
+			 vi->width, vi->height, ret);
+	}
+	ispdrv_vo_set_main_channel_scale(vi->width, vi->height);
+	if (sub_channel)
+		ispdrv_vo_set_sub_channel_scale(SUB_W, SUB_H);
+
+	for (i = 0; i < NUM_SLOTS; i++)
+		ispdrv_vo_disable_buffer(BUFFER_ONE + i);
+	list_for_each_entry(b, &vi->active, list)
+		arm_slot(vi, &b->vb.vb2_buf);
+
+	vi->seq = 0;
+	if (guard) {
+		memset(vi->guard_last, 0xff, sizeof(vi->guard_last));
+		schedule_delayed_work(&vi->guard_work, 2 * HZ);
+	}
+	vi->frames = vi->lost = 0;
+	ispdrv_vi_apply_mode(ISP_RGB_VIDEO_OUT);
+	ispdrv_vo_enable_irq_status(1);
+	program_ref(vi);
+	ispdrv_vi_start_capturing();
+	enable_irq(vi->irq);
+	return 0;
+
+fail:
+	vi_power_down(vi);
+	return_all(vi, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void stop_streaming(struct vb2_queue *q)
+{
+	struct ak39_vi *vi = vb2_get_drv_priv(q);
+	int i;
+
+	disable_irq(vi->irq);
+	ispdrv_set_isp_pause();
+	ispdrv_vi_stop_capturing();
+	/* no slot may keep a buffer address once vb2 can free the buffers */
+	for (i = 0; i < NUM_SLOTS; i++)
+		ispdrv_vo_disable_buffer(BUFFER_ONE + i);
+	ispdrv_vo_clear_irq_status(0xffff);
+	cancel_delayed_work_sync(&vi->guard_work);
+	cancel_delayed_work_sync(&vi->ae_work);
+	cancel_delayed_work_sync(&vi->awb_work);
+	vi_power_down(vi);
+	return_all(vi, VB2_BUF_STATE_ERROR);
+	dev_info(vi->dev, "stream stopped: %u frames, %u skipped irqs\n",
+		 vi->frames, vi->lost);
+}
+
+static const struct vb2_ops vi_qops = {
+	.queue_setup	= queue_setup,
+	.buf_prepare	= buf_prepare,
+	.buf_queue	= buf_queue,
+	.start_streaming = start_streaming,
+	.stop_streaming	= stop_streaming,
+	.wait_prepare	= vb2_ops_wait_prepare,
+	.wait_finish	= vb2_ops_wait_finish,
+};
+
+/* -------------------------------------------------------------- ioctl -- */
+
+static int querycap(struct file *f, void *p, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, DRV_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "AK3918EV300 ISP", sizeof(cap->card));
+	strscpy(cap->bus_info, "platform:" DRV_NAME, sizeof(cap->bus_info));
+	return 0;
+}
+
+static int enum_fmt(struct file *f, void *p, struct v4l2_fmtdesc *fd)
+{
+	if (fd->index)
+		return -EINVAL;
+	fd->pixelformat = V4L2_PIX_FMT_NV12;
+	return 0;
+}
+
+static void fill_fmt(struct ak39_vi *vi, struct v4l2_pix_format *pix)
+{
+	pix->width = vi->width;
+	pix->height = vi->height;
+	pix->pixelformat = V4L2_PIX_FMT_NV12;
+	pix->field = V4L2_FIELD_NONE;
+	pix->bytesperline = vi->width;
+	pix->sizeimage = vi->sizeimage;
+	pix->colorspace = V4L2_COLORSPACE_SRGB;
+}
+
+static int g_fmt(struct file *f, void *p, struct v4l2_format *fmt)
+{
+	fill_fmt(video_drvdata(f), &fmt->fmt.pix);
+	return 0;
+}
+
+static int try_fmt(struct file *f, void *p, struct v4l2_format *fmt)
+{
+	struct v4l2_pix_format *pix = &fmt->fmt.pix;
+
+	pix->width = clamp_t(u32, ALIGN(pix->width, 16), 640, 1920);
+	pix->height = clamp_t(u32, ALIGN(pix->height, 8), 360, 1080);
+	pix->pixelformat = V4L2_PIX_FMT_NV12;
+	pix->field = V4L2_FIELD_NONE;
+	pix->bytesperline = pix->width;
+	pix->sizeimage = pix->width * pix->height * 3 / 2;
+	pix->colorspace = V4L2_COLORSPACE_SRGB;
+	return 0;
+}
+
+static int s_fmt(struct file *f, void *p, struct v4l2_format *fmt)
+{
+	struct ak39_vi *vi = video_drvdata(f);
+
+	if (vb2_is_busy(&vi->q))
+		return -EBUSY;
+	try_fmt(f, p, fmt);
+	vi->width = fmt->fmt.pix.width;
+	vi->height = fmt->fmt.pix.height;
+	vi->sizeimage = fmt->fmt.pix.sizeimage;
+	free_ref(vi);
+	return 0;
+}
+
+static int enum_input(struct file *f, void *p, struct v4l2_input *in)
+{
+	if (in->index)
+		return -EINVAL;
+	in->type = V4L2_INPUT_TYPE_CAMERA;
+	strscpy(in->name, "JX-F23", sizeof(in->name));
+	return 0;
+}
+
+static int g_input(struct file *f, void *p, unsigned int *i)
+{
+	*i = 0;
+	return 0;
+}
+
+static int s_input(struct file *f, void *p, unsigned int i)
+{
+	return i ? -EINVAL : 0;
+}
+
+static long vi_default(struct file *f, void *p, bool valid_prio,
+		       unsigned int cmd, void *arg)
+{
+	struct ak39_vi *vi = video_drvdata(f);
+	struct ak39_vi_phys *ph = arg;
+	struct vb2_buffer *vb;
+	dma_addr_t y;
+
+	if (cmd != AK39_VI_G_PHYS)
+		return -ENOTTY;
+	if (ph->index >= vi->q.num_buffers)
+		return -EINVAL;
+	vb = vi->q.bufs[ph->index];
+	y = vb2_dma_contig_plane_dma_addr(vb, 0);
+	if (!y || y > U32_MAX)
+		return -EFAULT;
+	ph->phys_y = y;
+	ph->phys_uv = y + vi->width * vi->height;
+	ph->size = vb2_plane_size(vb, 0);
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops vi_ioctl_ops = {
+	.vidioc_default			= vi_default,
+	.vidioc_querycap		= querycap,
+	.vidioc_enum_fmt_vid_cap	= enum_fmt,
+	.vidioc_g_fmt_vid_cap		= g_fmt,
+	.vidioc_s_fmt_vid_cap		= s_fmt,
+	.vidioc_try_fmt_vid_cap		= try_fmt,
+	.vidioc_enum_input		= enum_input,
+	.vidioc_g_input			= g_input,
+	.vidioc_s_input			= s_input,
+	.vidioc_reqbufs			= vb2_ioctl_reqbufs,
+	.vidioc_create_bufs		= vb2_ioctl_create_bufs,
+	.vidioc_querybuf		= vb2_ioctl_querybuf,
+	.vidioc_qbuf			= vb2_ioctl_qbuf,
+	.vidioc_dqbuf			= vb2_ioctl_dqbuf,
+	.vidioc_expbuf			= vb2_ioctl_expbuf,
+	.vidioc_streamon		= vb2_ioctl_streamon,
+	.vidioc_streamoff		= vb2_ioctl_streamoff,
+};
+
+static const struct v4l2_file_operations vi_fops = {
+	.owner		= THIS_MODULE,
+	.open		= v4l2_fh_open,
+	.release	= vb2_fop_release,
+	.unlocked_ioctl	= video_ioctl2,
+	.mmap		= vb2_fop_mmap,
+	.poll		= vb2_fop_poll,
+};
+
+/* -------------------------------------------------------------- probe -- */
+
+static int vi_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np;
+	struct ak39_vi *vi;
+	int ret;
+
+	vi = devm_kzalloc(dev, sizeof(*vi), GFP_KERNEL);
+	if (!vi)
+		return -ENOMEM;
+	vi->dev = dev;
+	mutex_init(&vi->lock);
+	spin_lock_init(&vi->slock);
+	INIT_LIST_HEAD(&vi->active);
+	INIT_DELAYED_WORK(&vi->ae_work, ae_work);
+	INIT_DELAYED_WORK(&vi->awb_work, awb_work);
+	INIT_DELAYED_WORK(&vi->guard_work, guard_work_fn);
+	vi->width = 1920;
+	vi->height = 1080;
+	vi->sizeimage = 1920 * 1080 * 3 / 2;
+	vi->mclk_mhz = 24;
+	of_property_read_u32(dev->of_node, "mclk-mhz", &vi->mclk_mhz);
+	of_property_read_u32_array(dev->of_node, "anyka,sharepin-or",
+				   vi->share_board, 4);
+
+	/* SYSCTRL is shared with the irq, timer, watchdog and L2 code: map
+	 * it without claiming the region */
+	{
+		struct resource *r = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+
+		vi->sys = r ? devm_ioremap(dev, r->start, resource_size(r)) : NULL;
+		if (!vi->sys)
+			return -ENOMEM;
+	}
+	vi->mipi = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(vi->mipi))
+		return PTR_ERR(vi->mipi);
+	vi->irq = platform_get_irq(pdev, 0);
+	if (vi->irq < 0)
+		return vi->irq;
+
+	ret = of_reserved_mem_device_init(dev);
+	if (ret)
+		dev_warn(dev, "no reserved capture pool (%d), using CMA/system\n", ret);
+	dma_set_coherent_mask(dev, DMA_BIT_MASK(32));
+	ak_isp_dma_dev = dev;
+
+	np = of_parse_phandle(dev->of_node, "i2c-bus", 0);
+	if (!np)
+		return dev_err_probe(dev, -EINVAL, "no i2c-bus phandle\n");
+	vi->adap = of_find_i2c_adapter_by_node(np);
+	of_node_put(np);
+	if (!vi->adap)
+		return -EPROBE_DEFER;
+	vi->client = i2c_new_dummy_device(vi->adap, 0x40);
+	if (IS_ERR(vi->client)) {
+		ret = PTR_ERR(vi->client);
+		goto err_adap;
+	}
+	ak_sensor_i2c_set_client(vi->client);
+
+	ret = devm_request_irq(dev, vi->irq, vi_irq, IRQF_NO_AUTOEN, DRV_NAME, vi);
+	if (ret)
+		goto err_client;
+
+	ret = v4l2_device_register(dev, &vi->v4l2);
+	if (ret)
+		goto err_client;
+
+	vi->q.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	vi->q.io_modes = VB2_MMAP | VB2_DMABUF;
+	vi->q.drv_priv = vi;
+	vi->q.buf_struct_size = sizeof(struct ak39_vi_buf);
+	vi->q.ops = &vi_qops;
+	vi->q.mem_ops = &vb2_dma_contig_memops;
+	vi->q.timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	vi->q.lock = &vi->lock;
+	vi->q.dev = dev;
+	vi->q.min_buffers_needed = NUM_SLOTS;
+	ret = vb2_queue_init(&vi->q);
+	if (ret)
+		goto err_v4l2;
+
+	strscpy(vi->vdev.name, DRV_NAME, sizeof(vi->vdev.name));
+	vi->vdev.fops = &vi_fops;
+	vi->vdev.ioctl_ops = &vi_ioctl_ops;
+	vi->vdev.release = video_device_release_empty;
+	vi->vdev.v4l2_dev = &vi->v4l2;
+	vi->vdev.queue = &vi->q;
+	vi->vdev.lock = &vi->lock;
+	vi->vdev.device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING;
+	video_set_drvdata(&vi->vdev, vi);
+	ret = video_register_device(&vi->vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_v4l2;
+
+	platform_set_drvdata(pdev, vi);
+	dev_info(dev, "registered %s\n", video_device_node_name(&vi->vdev));
+	return 0;
+
+err_v4l2:
+	v4l2_device_unregister(&vi->v4l2);
+err_client:
+	i2c_unregister_device(vi->client);
+err_adap:
+	i2c_put_adapter(vi->adap);
+	return ret;
+}
+
+static void vi_remove(struct platform_device *pdev)
+{
+	struct ak39_vi *vi = platform_get_drvdata(pdev);
+
+	video_unregister_device(&vi->vdev);
+	v4l2_device_unregister(&vi->v4l2);
+	free_ref(vi);
+	i2c_unregister_device(vi->client);
+	i2c_put_adapter(vi->adap);
+	of_reserved_mem_device_release(&pdev->dev);
+}
+
+static const struct of_device_id vi_of_match[] = {
+	{ .compatible = "anyka,ak3918ev300-vi" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, vi_of_match);
+
+static struct platform_driver vi_driver = {
+	.probe		= vi_probe,
+	.remove_new	= vi_remove,
+	.driver		= {
+		.name		= DRV_NAME,
+		.of_match_table	= vi_of_match,
+	},
+};
+module_platform_driver(vi_driver);
+
+MODULE_DESCRIPTION("Anyka AK3918EV300 video input (ISP2), V4L2");
+MODULE_LICENSE("GPL");
