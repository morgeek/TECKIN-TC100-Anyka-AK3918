+		|  (LOW_BITS(ch3_frame_ctrl, 8) << PP_FRAME3_CTRL));// lz0499 9_5
+#endif
+	isp->reg_blkaddr4[R4_FRAME_CTRL] = cmd;
+	
+	return 0;
+}
