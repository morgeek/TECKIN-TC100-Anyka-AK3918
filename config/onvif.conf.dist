#######################################################################
# Edit /mnt/config/onvif.conf (a copy of this file) to change     #
# if you need to add options, otherwise defaults will be used         #
#######################################################################


ONVIF_PORT=8081

# The ONVIF daemon: c, the free tc100-onvifd of src/onvifd (Device + Media + Media2 with the audio output/decoder for
# two-way audio, WS-Security login = the RTSP user and the password of user.pwd, snapshot URI, LAN filter). The closed
# monvifd of 2.x was removed in rc32; a value other than c is ignored.
ONVIF_IMPL=c
VENDOR_NAME=Anyka
HW_NAME=AK3918
DEVICE_LOCATION=Earth
DEVICE_NAME=Teckin
DEVICE_MODEL=TC100

# Optional ONVIF log file (default: /dev/null)
# ONVIF_LOGPATH=/mnt/log/onvif.log
