From ad1c810304ce034de6fa9695df0799524086fcb0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 10:09:17 +0200
Subject: [PATCH] misc: add ak39_venc encoder access driver

Maps the Allegro DVT encoder register window, waits for its interrupt and exports a physically contiguous pool as /dev/uio0 so the vendor encoder libraries can run on 6.6.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014gtE1qwzw7JFQVcpbdix3V
---
 drivers/misc/Kconfig           |   8 +
 drivers/misc/Makefile          |   1 +
 drivers/misc/ak39_venc.c       | 367 +++++++++++++++++++++++++++++++++
 include/uapi/linux/ak39_venc.h |  37 ++++
 4 files changed, 413 insertions(+)
 create mode 100644 drivers/misc/ak39_venc.c
 create mode 100644 include/uapi/linux/ak39_venc.h

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index cadd4a820..9db429ab2 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -579,4 +579,12 @@ source "drivers/misc/cardreader/Kconfig"
 source "drivers/misc/uacce/Kconfig"
 source "drivers/misc/pvpanic/Kconfig"
 source "drivers/misc/mchp_pci1xxxx/Kconfig"
+config AK39_VENC
+	tristate "Anyka AK3918EV300 video encoder access"
+	depends on ARCH_ANYKA && OF
+	help
+	  Maps the register window of the Allegro DVT encoder, waits for its
+	  interrupt and provides a physically contiguous DMA pool to user
+	  space (/dev/uio0). The encoder itself is driven from user space.
+
 endmenu
