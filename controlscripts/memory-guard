#!/bin/sh
SERVICE_NAME="Memory Guard"
PIDFILE="/var/run/memory-guard.pid"
# tmpfs, like the other daemons — keeps SD writes out of low-memory situations
LOGPATH="/tmp/log/memory-guard.log"
CONFIGPATH="/mnt/config"

. /mnt/scripts/common_functions.sh

is_truthy()
{
    case "$1" in
        1|true|yes|on|enable|enabled) return 0 ;;
        *) return 1 ;;
    esac
}

sanitize_positive_int()
{
    value="$1"
    fallback="$2"
    case "$value" in
        ''|*[!0-9]*)
            echo "$fallback"
            ;;
        *)
            echo "$value"
            ;;
    esac
}

load_config()
{
    install_config_cached "$CONFIGPATH/boot.conf"
    if [ -f "$CONFIGPATH/boot.conf" ]; then
        # shellcheck disable=SC1090
        . "$CONFIGPATH/boot.conf"
    fi

    : "${MEM_GUARD_ENABLE:=0}"
    MEM_GUARD_INTERVAL_SECONDS="$(sanitize_positive_int "${MEM_GUARD_INTERVAL_SECONDS:-60}" 20)"

    # Defaults (64 MB camera, MemAvailable about 10.8 MB in normal use with the streams, web and MQTT running):
    #   warn 6144 KB     the first stage stops only the light services (network-monitor): well below normal, above
    #                    what a snapshot or a few web pages take at once
    #   critical 3072 KB also stops ftp, telnet and motion detection, and drops the caches: really about to run out
    #   emergency 2048 KB
    # The old 8192 / 4096 sat next to the normal value and the critical stage stopped motion detection in normal use.
    MEM_GUARD_WARN_KB="$(sanitize_positive_int "${MEM_GUARD_WARN_KB:-6144}" 6144)"
    MEM_GUARD_CRITICAL_KB="$(sanitize_positive_int "${MEM_GUARD_CRITICAL_KB:-3072}" 3072)"
    MEM_GUARD_EMERGENCY_KB="$(sanitize_positive_int "${MEM_GUARD_EMERGENCY_KB:-2048}" 2048)"
    MEM_GUARD_RECOVERY_MARGIN_KB="$(sanitize_positive_int "${MEM_GUARD_RECOVERY_MARGIN_KB:-1536}" 1536)"
    MEM_GUARD_WARN_HITS="$(sanitize_positive_int "${MEM_GUARD_WARN_HITS:-2}" 2)"
    MEM_GUARD_CRITICAL_HITS="$(sanitize_positive_int "${MEM_GUARD_CRITICAL_HITS:-1}" 1)"
    MEM_GUARD_COOLDOWN_SECONDS="$(sanitize_positive_int "${MEM_GUARD_COOLDOWN_SECONDS:-120}" 120)"
    : "${MEM_GUARD_DROP_CACHES:=1}"
    : "${MEM_GUARD_SOFT_SERVICES:=network-monitor}"
    : "${MEM_GUARD_CRITICAL_SERVICES:=ftp-server telnet-server motion-detection}"
    : "${MEM_GUARD_EMERGENCY_SERVICES:=}"

    [ "$MEM_GUARD_INTERVAL_SECONDS" -lt 5 ] && MEM_GUARD_INTERVAL_SECONDS=5
    [ "$MEM_GUARD_WARN_HITS" -lt 1 ] && MEM_GUARD_WARN_HITS=1
    [ "$MEM_GUARD_WARN_HITS" -gt 10 ] && MEM_GUARD_WARN_HITS=10
    [ "$MEM_GUARD_CRITICAL_HITS" -lt 1 ] && MEM_GUARD_CRITICAL_HITS=1
    [ "$MEM_GUARD_CRITICAL_HITS" -gt 10 ] && MEM_GUARD_CRITICAL_HITS=10
    [ "$MEM_GUARD_RECOVERY_MARGIN_KB" -lt 256 ] && MEM_GUARD_RECOVERY_MARGIN_KB=256
    [ "$MEM_GUARD_RECOVERY_MARGIN_KB" -gt 32768 ] && MEM_GUARD_RECOVERY_MARGIN_KB=32768
    [ "$MEM_GUARD_EMERGENCY_KB" -lt 512 ] && MEM_GUARD_EMERGENCY_KB=512
    if [ "$MEM_GUARD_EMERGENCY_KB" -ge "$MEM_GUARD_CRITICAL_KB" ]; then
        MEM_GUARD_EMERGENCY_KB=$((MEM_GUARD_CRITICAL_KB / 2))
        [ "$MEM_GUARD_EMERGENCY_KB" -lt 512 ] && MEM_GUARD_EMERGENCY_KB=512
    fi
    [ "$MEM_GUARD_COOLDOWN_SECONDS" -lt 10 ] && MEM_GUARD_COOLDOWN_SECONDS=10
    : "${MEM_WATCHDOG_ENABLE:=0}"
    : "${MEM_WATCHDOG_INTERVAL_SECONDS:=40}"
    : "${MEM_WATCHDOG_MAX_RETRIES:=3}"
    : "${MEM_WATCHDOG_SERVICES:=web-server rtsp-h26x onvif}"

    [ "$MEM_WATCHDOG_INTERVAL_SECONDS" -lt 10 ] && MEM_WATCHDOG_INTERVAL_SECONDS=10
    [ "$MEM_WATCHDOG_MAX_RETRIES" -lt 1 ] && MEM_WATCHDOG_MAX_RETRIES=1
}

mem_available_kb()
{
    get_mem_available_kb
}

# Fork-free timestamp helpers
_MG_BTIME=0
_read_btime() {
  while read -r _k _v _; do [ "$_k" = "btime" ] && _MG_BTIME="$_v" && break; done < /proc/stat
}
get_now_ts() {
  [ "$_MG_BTIME" -gt 0 ] || _read_btime
  read -r _up _ < /proc/uptime
  echo $((_MG_BTIME + ${_up%.*}))
}

_MG_FAIL_DIR="/tmp/watchdog_failures"
check_services()
{
    [ -d "$_MG_FAIL_DIR" ] || mkdir -p "$_MG_FAIL_DIR"

    for svc in $MEM_WATCHDOG_SERVICES; do
        script="/mnt/controlscripts/$svc"
        if [ ! -x "$script" ]; then
            continue
        fi

        # Skip services that are not supposed to be running (no PID file)
        [ -f "/var/run/$svc.pid" ] || continue
        # One restarter per service: those started with their own scripts/service-watchdog.sh are left to it
        _wp="/var/run/$svc-watch.pid"; [ "$svc" = rtsp-h26x ] && _wp=/var/run/v4l2rtspserver-watch.pid
        checkpid "$_wp" && continue

        if "$script" health >/dev/null 2>&1; then
            # Healthy: reset failure count
            rm -f "$_MG_FAIL_DIR/$svc" 2>/dev/null
        else
            # Unhealthy: increment failure count
            count=0
            [ -f "$_MG_FAIL_DIR/$svc" ] && read -r count < "$_MG_FAIL_DIR/$svc"
            count=$((count + 1))
            _nts="$(get_now_ts)"
            echo "[$_nts] Service watchdog: $svc is UNHEALTHY (failure $count/$MEM_WATCHDOG_MAX_RETRIES)" >> "$LOGPATH"

            if [ "$count" -ge "$MEM_WATCHDOG_MAX_RETRIES" ]; then
                echo "[$_nts] Service watchdog: RESTARTING $svc after $count failures" >> "$LOGPATH"
                "$script" restart >/dev/null 2>&1 || true
                rm -f "$_MG_FAIL_DIR/$svc" 2>/dev/null
            else
                echo "$count" > "$_MG_FAIL_DIR/$svc"
            fi
        fi
    done
}

stop_service_if_running()
{
    service="$1"
    script="/mnt/controlscripts/$service"
    [ -x "$script" ] || return 0

    # Optimization: check if PID file exists before calling script status (save fork)
    if [ -f "/var/run/$service.pid" ]; then
        "$script" stop >/dev/null 2>&1 || true
        _nts="$(get_now_ts)"
        echo "[$_nts] Memory guard: stopped $service" >> "$LOGPATH"
    fi
}

apply_memory_relief()
{
    available_kb="$1"
    stage="$2"

    for service in $MEM_GUARD_SOFT_SERVICES; do
        stop_service_if_running "$service"
    done

    if [ "$stage" = "critical" ] || [ "$stage" = "emergency" ]; then
        for service in $MEM_GUARD_CRITICAL_SERVICES; do
            stop_service_if_running "$service"
        done
    fi

    if [ "$stage" = "emergency" ] && [ -n "$MEM_GUARD_EMERGENCY_SERVICES" ]; then
        for service in $MEM_GUARD_EMERGENCY_SERVICES; do
            stop_service_if_running "$service"
        done
    fi

    if [ "$stage" = "critical" ] || [ "$stage" = "emergency" ]; then
        if is_truthy "$MEM_GUARD_DROP_CACHES"; then
            sync
            echo 3 > /proc/sys/vm/drop_caches
            _nts="$(get_now_ts)"
            echo "[$_nts] Memory guard: dropped VM caches (stage=$stage MemAvailable=${available_kb}kB)" >> "$LOGPATH"
        fi
    fi
}

monitor()
{
    last_action_ts=0
    last_watchdog_ts=0
    warn_hits=0
    critical_hits=0
    while :; do
        sleep "$MEM_GUARD_INTERVAL_SECONDS"

        now_ts="$(get_now_ts)"
        now_ts="$(sanitize_positive_int "$now_ts" 0)"

        # 1. Service Watchdog Check
        if is_truthy "$MEM_WATCHDOG_ENABLE"; then
            if [ "$now_ts" -ge $((last_watchdog_ts + MEM_WATCHDOG_INTERVAL_SECONDS)) ]; then
                check_services
                last_watchdog_ts="$now_ts"
            fi
        fi

        # 2. Memory Check
        available_kb="$(mem_available_kb)"
        available_kb="$(sanitize_positive_int "$available_kb" 0)"
        [ "$available_kb" -gt 0 ] || continue

        if [ "$available_kb" -gt $((MEM_GUARD_WARN_KB + MEM_GUARD_RECOVERY_MARGIN_KB)) ]; then
            warn_hits=0
            critical_hits=0
            continue
        fi

        if [ "$available_kb" -le "$MEM_GUARD_WARN_KB" ]; then
            warn_hits=$((warn_hits + 1))
        else
            warn_hits=0
        fi

        if [ "$available_kb" -le "$MEM_GUARD_CRITICAL_KB" ]; then
            critical_hits=$((critical_hits + 1))
        else
            critical_hits=0
        fi

        stage=""
        if [ "$available_kb" -le "$MEM_GUARD_EMERGENCY_KB" ]; then
            stage="emergency"
        elif [ "$critical_hits" -ge "$MEM_GUARD_CRITICAL_HITS" ]; then
            stage="critical"
        elif [ "$warn_hits" -ge "$MEM_GUARD_WARN_HITS" ]; then
            stage="warn"
        fi

        if [ -n "$stage" ]; then
            now_ts="$(get_now_ts)"
            now_ts="$(sanitize_positive_int "$now_ts" 0)"

            if [ "$now_ts" -gt 0 ] && [ $((now_ts - last_action_ts)) -lt "$MEM_GUARD_COOLDOWN_SECONDS" ]; then
                continue
            fi

            echo "[$now_ts] Memory guard: low memory detected (stage=$stage MemAvailable=${available_kb}kB warn_hits=${warn_hits} critical_hits=${critical_hits})" >> "$LOGPATH"
            apply_memory_relief "$available_kb" "$stage"
            warn_hits=0
            critical_hits=0
            [ "$now_ts" -gt 0 ] && last_action_ts="$now_ts"
        fi
    done
}

status()
{
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    if [ "$pid" ] && kill -0 "$pid" >/dev/null 2>&1; then
        echo "PID: $pid"
        return 0
    fi
    # Not running. Exit code 3 = turned off in boot.conf (MEM_GUARD_ENABLE=0): the
    # Services page shows "Disabled" rather than a boot service that failed.
    load_config >/dev/null 2>&1
    is_truthy "$MEM_GUARD_ENABLE" || return 3
    [ -z "$pid" ] || return 1
}

# A camera that still holds the shipped values of before 3.0.2 (warn 8192 and critical 4096 KB, soft stage stopping
# auto-night-detection) gets the new defaults; any other value was chosen by someone and is left alone.
mg_migrate_defaults()
{
    _mg_bc="${MEM_GUARD_BOOTCONF:-$CONFIGPATH/boot.conf}"
    [ -f "$_mg_bc" ] || return 0
    _mg_w=""; _mg_c=""; _mg_s=""
    while IFS='=' read -r _mg_k _mg_v; do
        _mg_v="${_mg_v%\"}"; _mg_v="${_mg_v#\"}"
        case "$_mg_k" in
            MEM_GUARD_WARN_KB) _mg_w="$_mg_v" ;;
            MEM_GUARD_CRITICAL_KB) _mg_c="$_mg_v" ;;
            MEM_GUARD_SOFT_SERVICES) _mg_s="$_mg_v" ;;
        esac
    done < "$_mg_bc"
    if [ "$_mg_w" = 8192 ] && [ "$_mg_c" = 4096 ]; then
        rewrite_config "$_mg_bc" MEM_GUARD_WARN_KB 6144
        rewrite_config "$_mg_bc" MEM_GUARD_CRITICAL_KB 3072
        [ "$_mg_s" = "network-monitor auto-night-detection" ] && rewrite_config "$_mg_bc" MEM_GUARD_SOFT_SERVICES '"network-monitor"'
        echo "[$(get_now_ts)] Memory guard: shipped thresholds 8192/4096 KB replaced by 6144/3072 KB" >> "$LOGPATH"
    fi
    return 0
}

start()
{
    mg_migrate_defaults
    load_config
    if ! is_truthy "$MEM_GUARD_ENABLE"; then
        echo "Memory guard disabled in /mnt/config/boot.conf"
        return 0
    fi

    if [ "$(status)" != "" ]; then
        echo "Memory guard is already running"
        return 0
    fi

    echo "Starting Memory Guard"
    /mnt/bin/busybox nohup "$0" run >/dev/null 2>&1 &
    echo "$!" > "$PIDFILE"
}

stop()
{
    killpid_graceful "$PIDFILE" 5
}

restart()
{
    stop
    start
}

health()
{
    [ -r /proc/meminfo ] || return 1
    [ "$(status)" != "" ] || return 1
    echo "HEALTHY"
}

run()
{
    load_config
    if ! is_truthy "$MEM_GUARD_ENABLE"; then
        exit 0
    fi
    monitor
}

if [ $# -eq 0 ]; then
    start
else
    case "$1" in
        start|stop|status|restart|health|run)
            "$1"
            ;;
        *)
            echo "Usage: $0 {start|stop|status|restart|health}" >&2
            exit 1
            ;;
    esac
fi
