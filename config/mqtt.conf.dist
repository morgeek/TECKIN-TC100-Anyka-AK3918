############################################################
# edit this file and move it to /mnt/config/mqtt.conf
############################################################

# 0 = disabled, 1 = enabled
MQTT_ENABLE=0

# Broker connection (plain MQTT over TCP; TLS is not supported by this curl build)
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Client/topic settings. Left at these shipped values, both become the camera's host name in lower case, any other
# character turned into "-" (host CAMERA2 -> client id "camera2", topics "camera2/..."), so that two cameras set up
# from this file never share a client id or a topic root (scripts/mqtt-bridge.sh, both bridges). Write your own
# values here to choose them.
MQTT_CLIENT_ID=tc100-camera
MQTT_TOPIC_ROOT=tc100/camera
# Leave empty to auto-generate: <MQTT_TOPIC_ROOT>/command
MQTT_TOPIC_COMMAND=
MQTT_QOS=0

# Which program talks to the broker: shell = scripts/mqtt-bridge.sh run (four shell processes, ~5.7 MB),
# c = tc100-mqttd (one small process, src/mqttd). Same topics, same payloads, same commands; takes effect at the
# next start of the MQTT bridge service. Falls back to shell when the binary is not installed.
# MQTT_BRIDGE_IMPL: "c" runs the lightweight C daemon (tc100-mqttd, VmRSS ~428 KB,
# one TCP connection), recommended. "shell" runs the legacy ash bridge.
MQTT_BRIDGE_IMPL=c

# Who builds the Home Assistant discovery messages (the retained <prefix>/<component>/<id>/config topics): "sh" (default)
# = scripts/mqtt-bridge.sh, "c" = tc100-mqttd itself (same topics and payloads, no shell run at connection time).
# Only used with MQTT_BRIDGE_IMPL=c. Takes effect at the next start of the MQTT bridge service; set back to "sh" to
# return to the script.
MQTT_DISCOVERY_IMPL=sh

# Runtime behavior
# Health publish cadence. Higher values reduce CPU/network load.
# 300s (5 min) is sufficient for HA availability — the LWT retained topic
# handles immediate offline detection without frequent polling.
MQTT_HEALTH_INTERVAL_SECONDS=300
# Expensive health probes (service status/ports/storage/network) are cached
# for this many seconds to avoid periodic CPU spikes.
MQTT_HEALTH_SLOW_CACHE_TTL_SECONDS=300
MQTT_COMMAND_WAIT_SECONDS=12
MQTT_COMMAND_REPEAT_WINDOW_SECONDS=20
# Persistent command subscription (recommended). Holds one MQTT connection
# open for up to MQTT_STREAM_MAX_SECONDS and dispatches commands as they
# arrive (~1s latency), instead of reconnecting every MQTT_COMMAND_WAIT_SECONDS.
# Cuts connection churn ~25x and lowers idle CPU. Falls back to one-shot
# polling automatically if the shell lacks read-timeout support.
MQTT_STREAM_ENABLE=1
MQTT_STREAM_MAX_SECONDS=300
# Subscribe retry backoff when broker polling fails (reduces retry churn if broker is down)
MQTT_SUBSCRIBE_BACKOFF_INITIAL_SECONDS=2
MQTT_SUBSCRIBE_BACKOFF_MAX_SECONDS=20
MQTT_SUBSCRIBE_BACKOFF_MULTIPLIER=2
# Circuit breaker: after this many consecutive subscribe failures, pause for
# MQTT_CIRCUIT_BREAKER_COOLDOWN_SECONDS before retrying. Prevents busy-looping
# against a permanently unreachable broker.
MQTT_CIRCUIT_BREAKER_THRESHOLD=50
MQTT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Home Assistant MQTT Discovery (retained config topics).
# Keep enabled for one-click entity creation in HA.
MQTT_HA_DISCOVERY_ENABLE=1
MQTT_HA_DISCOVERY_PREFIX=homeassistant

# Home Assistant MQTT Camera entity:
# When enabled (=1), registers a Camera entity in HA subscribed to <MQTT_TOPIC_ROOT>/snapshot/image.
# Snapshots taken via the MQTT snapshot button or requested via /tmp/snapshot_request will publish
# real JPEG bytes to the topic. Keep 0 to save bandwidth/RAM if using RTSP/go2rtc.
MQTT_HA_CAMERA_ENTITY_ENABLE=0
# A fresh picture on each event (motion, sound, tamper) to <topic root>/snapshot/image (retained, JPEG bytes, about
# 40 KB) and a line on <topic root>/snapshot/event, for Home Assistant notifications; 1 also registers the camera
# entity above. At most one picture every MQTT_SNAPSHOT_COOLDOWN_SECONDS.
MQTT_SNAPSHOT_ON_EVENT=0
MQTT_SNAPSHOT_COOLDOWN_SECONDS=10

# Commands can be plain text (legacy) or JSON.
# Plain:
#   reboot
#   snapshot
#   profile:balanced
#   profile:low-cpu
#   profile:rtsp-only
#   restart_rtsp
#   restart_onvif
#   restart_mqtt_bridge
#   repair_integration
#   integration_manifest
#   integration_selftest
# JSON examples:
#   {"cmd":"motion","value":"on"}
#   {"cmd":"motion","value":"off"}
#   {"cmd":"ir_led","value":"on"}
#   {"cmd":"ftp","value":"off"}
#   {"cmd":"restart_rtsp"}

# The bridge also publishes integration and command-result topics for HA/Frigate:
#   <MQTT_TOPIC_ROOT>/integration/manifest
#   <MQTT_TOPIC_ROOT>/integration/selftest
#   <MQTT_TOPIC_ROOT>/command/result
#   <MQTT_TOPIC_ROOT>/command/last_result
#   <MQTT_TOPIC_ROOT>/repair/last_result

# Power telemetry and draw estimation.
# Estimation is optional and cheap: base + CPU load term + optional IR LED term.
# Formulas:
#   estimated_mW = POWER_ESTIMATE_BASE_MW + (cpu_percent * POWER_ESTIMATE_CPU_SCALE_MW / 100) + ir_led_bonus
#   estimated_W  = estimated_mW / 1000
POWER_ESTIMATE_ENABLE=0
POWER_ESTIMATE_BASE_MW=1700
POWER_ESTIMATE_CPU_SCALE_MW=500
POWER_ESTIMATE_IR_LED_MW=700

# Input voltage sensor source:
# - auto: tries /sys/kernel/ain/bat, /sys/kernel/ain/ain0, /sys/kernel/ain/ain1
# - or set an explicit readable path.
POWER_SENSOR_PATH=auto
