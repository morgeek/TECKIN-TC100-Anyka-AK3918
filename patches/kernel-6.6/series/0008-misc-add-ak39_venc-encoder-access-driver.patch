diff --git a/drivers/misc/ak39_venc.c b/drivers/misc/ak39_venc.c
new file mode 100644
index 000000000..4078d4db5
--- /dev/null
+++ b/drivers/misc/ak39_venc.c
@@ -0,0 +1,443 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Anyka AK3918EV300 video encoder access (Allegro DVT core, H.264/H.265/JPEG)
+ *
+ * The encoder is driven from user space (the control software computes the
+ * command lists and writes the registers itself), so this driver only:
+ *   - maps the register window (0x20020000, 64 KiB) into the process,
+ *   - waits for the encoder interrupt (level, masked until the next wait),
+ *   - maps a physically contiguous DMA pool and tells user space its address,
+ *   - gates the clock and pulses the soft reset of the core.
+ *
+ * It replaces the vendor "uio_vcodec" + /dev/ion pair, which are not in
+ * mainline. The interface is /dev/uio0 so that a vendor-compatible libakuio
+ * can be used unchanged (see AKUIO_* in uapi/linux/ak39_venc.h).
+ */
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/workqueue.h>
+#include <linux/soc/anyka/ak_l2.h>
+#include <uapi/linux/ak39_venc.h>
+
+#define AK_PA_SYSCTRL	0x08000000
+#define SYSCTRL_CLKGATE	0x1c	/* 1 = gated */
+#define SYSCTRL_SOFTRST	0x20
+#define VENC_BIT	BIT(18)	/* same bit in both registers */
+
+struct ak39_venc {
+	struct miscdevice misc;
+	struct device *dev;
+	void __iomem *regs;		/* kept for sanity, not used */
+	phys_addr_t regs_phys;
+	size_t regs_size;
+	int irq;
+	struct completion irq_done;
+	bool irq_armed;
+	spinlock_t lock;
+	struct mutex pool_lock;
+	void *pool_virt;
+	dma_addr_t pool_dma;
+	size_t pool_size;
+	bool pool_reserved;	/* memremap()ed no-map region, not dma_alloc */
+	int open_count;
+
+	/* guard zones around the pool (0 = below, 1 = above), filled with GUARD_PAT */
+	void *guard_virt[2];
+	size_t guard_size[2];
+	struct delayed_work guard_work;
+	unsigned int guard_runs;
+};
+
+static DEFINE_SPINLOCK(sysctrl_lock);
+
+static bool guard = true;
+module_param(guard, bool, 0444);
+MODULE_PARM_DESC(guard, "watch the reserved guard zones around the encoder pool for stray DMA writes");
+
+#define GUARD_PAT	0xA5
+#define GUARD_NEAR	SZ_64K
+
+/*
+ * The encoder is programmed from user space with physical addresses; a write
+ * past either end of the pool would land in ordinary kernel memory. Two
+ * reserved zones touch the pool and are filled with a pattern: the adjacent
+ * 64 KiB are checked every 2 s and the whole zones every 30 s.
+ */
+static void ak39_venc_guard_work(struct work_struct *w)
+{
+	struct ak39_venc *v = container_of(w, struct ak39_venc, guard_work.work);
+	bool full = !(v->guard_runs++ % 15);
+	int g;
+
+	for (g = 0; g < 2; g++) {
+		u8 *z = v->guard_virt[g], *bad, *last;
+		size_t sz = v->guard_size[g], len, k;
+
+		if (!z)
+			continue;
+		len = full ? sz : min_t(size_t, sz, GUARD_NEAR);
+		/* zone 0 ends where the pool starts, zone 1 starts where it ends */
+		bad = memchr_inv(g ? z : z + sz - len, GUARD_PAT, len);
+		if (!bad)
+			continue;
+		for (k = sz; k > 0 && z[k - 1] == GUARD_PAT; k--)
+			;
+		last = z + k - 1;
+		if (g)
+			dev_err(v->dev, "GUARD: stray write ABOVE the pool, up to %zu bytes past its end\n", (size_t)(last - z) + 1);
+		else
+			dev_err(v->dev, "GUARD: stray write BELOW the pool, down to %zu bytes before its start\n", sz - (size_t)(bad - z));
+		memset(z, GUARD_PAT, sz);
+	}
+	schedule_delayed_work(&v->guard_work, 2 * HZ);
+}
+
+static void sysctrl_update(u32 reg, u32 mask, u32 val)
+{
+	unsigned long flags;
+	u32 v;
+
+	spin_lock_irqsave(&sysctrl_lock, flags);
+	v = readl(ak_sysctrl_base + reg);
+	v = (v & ~mask) | (val & mask);
+	writel(v, ak_sysctrl_base + reg);
+	spin_unlock_irqrestore(&sysctrl_lock, flags);
+}
+
+/* 1 asserts the reset, 0 releases it (as for the ISP and MIPI blocks) */
+static void venc_soft_reset(void)
+{
+	sysctrl_update(SYSCTRL_SOFTRST, VENC_BIT, VENC_BIT);
+	usleep_range(100, 200);
+	sysctrl_update(SYSCTRL_SOFTRST, VENC_BIT, 0);
+}
+
+static irqreturn_t ak39_venc_irq(int irq, void *data)
+{
+	struct ak39_venc *v = data;
+
+	/* the line is level triggered and cleared by the user-space driver */
+	disable_irq_nosync(irq);
+	spin_lock(&v->lock);
+	v->irq_armed = false;
+	spin_unlock(&v->lock);
+	complete(&v->irq_done);
+	return IRQ_HANDLED;
+}
+
+static inline struct ak39_venc *to_venc(struct file *f)
+{
+	return container_of(f->private_data, struct ak39_venc, misc);
+}
+
+static int ak39_venc_open(struct inode *inode, struct file *f)
+{
+	struct ak39_venc *v = to_venc(f);
+
+	mutex_lock(&v->pool_lock);
+	if (!v->open_count++) {
+		/* the core must be clocked and reset before any access */
+		sysctrl_update(SYSCTRL_CLKGATE, VENC_BIT, 0);
+		venc_soft_reset();
+		reinit_completion(&v->irq_done);
+		v->irq_armed = false;
+	}
+	mutex_unlock(&v->pool_lock);
+	return 0;
+}
+
+static int ak39_venc_release(struct inode *inode, struct file *f)
+{
+	struct ak39_venc *v = to_venc(f);
+	unsigned long flags;
+
+	mutex_lock(&v->pool_lock);
+	if (!--v->open_count) {
+		spin_lock_irqsave(&v->lock, flags);
+		if (v->irq_armed) {
+			v->irq_armed = false;
+			spin_unlock_irqrestore(&v->lock, flags);
+			disable_irq(v->irq);
+		} else {
+			spin_unlock_irqrestore(&v->lock, flags);
+		}
+		/* stop the core and gate its clock */
+		venc_soft_reset();
+		sysctrl_update(SYSCTRL_CLKGATE, VENC_BIT, VENC_BIT);
+	}
+	mutex_unlock(&v->pool_lock);
+	return 0;
+}
+
+static int ak39_venc_wait_irq(struct ak39_venc *v)
+{
+	unsigned long flags;
+	long left;
+
+	spin_lock_irqsave(&v->lock, flags);
+	if (!v->irq_armed) {
+		v->irq_armed = true;
+		reinit_completion(&v->irq_done);
+		spin_unlock_irqrestore(&v->lock, flags);
+		enable_irq(v->irq);
+	} else {
+		spin_unlock_irqrestore(&v->lock, flags);
+	}
+	left = wait_for_completion_interruptible_timeout(&v->irq_done,
+							 msecs_to_jiffies(2000));
+	if (left > 0)
+		return 0;
+	/* leave the line masked so a stuck core cannot storm */
+	spin_lock_irqsave(&v->lock, flags);
+	if (v->irq_armed) {
+		v->irq_armed = false;
+		spin_unlock_irqrestore(&v->lock, flags);
+		disable_irq(v->irq);
+	} else {
+		spin_unlock_irqrestore(&v->lock, flags);
+	}
+	return left ? -ERESTARTSYS : -ETIMEDOUT;
+}
+
+static long ak39_venc_ioctl(struct file *f, unsigned int cmd, unsigned long arg)
+{
+	struct ak39_venc *v = to_venc(f);
+
+	switch (cmd) {
+	case AKUIO_SYSREG_WRITE: {
+		struct akuio_sysreg_write_t w;
+		u32 reg;
+
+		if (copy_from_user(&w, (void __user *)arg, sizeof(w)))
+			return -EFAULT;
+		/* only the clock gate and soft reset registers, only our bit */
+		if (w.paddr == AK_PA_SYSCTRL + SYSCTRL_CLKGATE ||
+		    w.paddr == AK_PA_SYSCTRL + SYSCTRL_SOFTRST) {
+			reg = w.paddr - AK_PA_SYSCTRL;
+			sysctrl_update(reg, w.mask & VENC_BIT, w.val);
+			return 0;
+		}
+		return -EPERM;
+	}
+	case AKUIO_WAIT_IRQ:
+		return ak39_venc_wait_irq(v);
+	case AKUIO_VIDEO_RESET:
+		venc_soft_reset();
+		return 0;
+	case AK39_VENC_POOL_INFO: {
+		struct ak39_venc_pool_info info = {
+			.paddr = v->pool_dma,
+			.size = v->pool_size,
+			.regs_paddr = v->regs_phys,
+			.regs_size = v->regs_size,
+		};
+
+		if (copy_to_user((void __user *)arg, &info, sizeof(info)))
+			return -EFAULT;
+		return 0;
+	}
+	default:
+		return -ENOTTY;
+	}
+}
+
+static int ak39_venc_mmap(struct file *f, struct vm_area_struct *vma)
+{
+	struct ak39_venc *v = to_venc(f);
+	unsigned long off = vma->vm_pgoff << PAGE_SHIFT;
+	unsigned long len = vma->vm_end - vma->vm_start;
+
+	if (!(vma->vm_flags & VM_SHARED))
+		return -EINVAL;
+
+	if (off >= AK39_VENC_MMAP_POOL) {
+		off -= AK39_VENC_MMAP_POOL;
+		if (!v->pool_virt || off + len > v->pool_size)
+			return -EINVAL;
+		/* the pool is write-combined: the core and the CPU agree */
+		if (v->pool_reserved) {
+			vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);
+			return io_remap_pfn_range(vma, vma->vm_start,
+					(v->pool_dma + off) >> PAGE_SHIFT, len,
+					vma->vm_page_prot);
+		}
+		vma->vm_pgoff = off >> PAGE_SHIFT;
+		return dma_mmap_wc(v->dev, vma, v->pool_virt, v->pool_dma,
+				   v->pool_size);
+	}
+
+	if (off + len > PAGE_ALIGN(v->regs_size))
+		return -EINVAL;
+	vma->vm_page_prot = pgprot_noncached(vma->vm_page_prot);
+	return io_remap_pfn_range(vma, vma->vm_start,
+				  (v->regs_phys + off) >> PAGE_SHIFT, len,
+				  vma->vm_page_prot);
+}
+
+static const struct file_operations ak39_venc_fops = {
+	.owner		= THIS_MODULE,
+	.open		= ak39_venc_open,
+	.release	= ak39_venc_release,
+	.unlocked_ioctl	= ak39_venc_ioctl,
+	.compat_ioctl	= compat_ptr_ioctl,
+	.mmap		= ak39_venc_mmap,
+	.llseek		= noop_llseek,
+};
+
+static void ak39_venc_pool_free(struct ak39_venc *v)
+{
+	if (v->pool_reserved)
+		memunmap(v->pool_virt);
+	else
+		dma_free_wc(v->dev, v->pool_size, v->pool_virt, v->pool_dma);
+}
+
+static int ak39_venc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ak39_venc *v;
+	struct resource *res;
+	struct device_node *np;
+	u32 size = SZ_8M;
+	int ret;
+
+	if (!ak_sysctrl_base)
+		return -EPROBE_DEFER;
+
+	v = devm_kzalloc(dev, sizeof(*v), GFP_KERNEL);
+	if (!v)
+		return -ENOMEM;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -ENODEV;
+	v->regs_phys = res->start;
+	v->regs_size = resource_size(res);
+	v->dev = dev;
+	spin_lock_init(&v->lock);
+	mutex_init(&v->pool_lock);
+	init_completion(&v->irq_done);
+	INIT_DELAYED_WORK(&v->guard_work, ak39_venc_guard_work);
+
+	v->irq = platform_get_irq(pdev, 0);
+	if (v->irq < 0)
+		return v->irq;
+	irq_set_status_flags(v->irq, IRQ_NOAUTOEN);
+	ret = devm_request_irq(dev, v->irq, ak39_venc_irq, 0, "ak39-venc", v);
+	if (ret)
+		return ret;
+
+	ret = dma_coerce_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	of_property_read_u32(dev->of_node, "anyka,pool-size", &size);
+
+	/*
+	 * A reserved (no-map) region is mapped as it is: the DMA coherent
+	 * allocator would round a 12 MiB request up to 16 MiB and fail.
+	 * Without a memory-region the default DMA pool is used.
+	 */
+	np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (np) {
+		struct resource rr;
+
+		ret = of_address_to_resource(np, 0, &rr);
+		of_node_put(np);
+		if (ret)
+			return ret;
+		v->pool_size = resource_size(&rr);
+		v->pool_dma = rr.start;
+		v->pool_virt = memremap(rr.start, v->pool_size, MEMREMAP_WC);
+		v->pool_reserved = true;
+		/* optional guard zones: memory-region entries 1 (below) and 2 (above) */
+		if (guard) {
+			int g;
+
+			for (g = 0; g < 2; g++) {
+				struct device_node *gn = of_parse_phandle(dev->of_node, "memory-region", 1 + g);
+				struct resource gr;
+
+				if (!gn)
+					continue;
+				if (!of_address_to_resource(gn, 0, &gr)) {
+					v->guard_virt[g] = memremap(gr.start, resource_size(&gr), MEMREMAP_WC);
+					v->guard_size[g] = resource_size(&gr);
+					if (v->guard_virt[g])
+						memset(v->guard_virt[g], GUARD_PAT, v->guard_size[g]);
+				}
+				of_node_put(gn);
+			}
+			if (v->guard_virt[0] || v->guard_virt[1]) {
+				schedule_delayed_work(&v->guard_work, 2 * HZ);
+				dev_info(dev, "guard zones: %zu KiB below, %zu KiB above the pool\n",
+					 v->guard_size[0] >> 10, v->guard_size[1] >> 10);
+			}
+		}
+	} else {
+		v->pool_size = PAGE_ALIGN(size);
+		v->pool_virt = dma_alloc_wc(dev, v->pool_size, &v->pool_dma,
+					    GFP_KERNEL);
+	}
+	if (!v->pool_virt) {
+		dev_err(dev, "cannot map the %zu byte pool\n", v->pool_size);
+		return -ENOMEM;
+	}
+
+	/* clock gated until the device is opened */
+	sysctrl_update(SYSCTRL_CLKGATE, VENC_BIT, VENC_BIT);
+
+	v->misc.minor = MISC_DYNAMIC_MINOR;
+	v->misc.name = "uio0";
+	v->misc.fops = &ak39_venc_fops;
+	v->misc.mode = 0660;
+	ret = misc_register(&v->misc);
+	if (ret) {
+		ak39_venc_pool_free(v);
+		return ret;
+	}
+	platform_set_drvdata(pdev, v);
+	dev_info(dev, "video encoder: regs %pa+%zx irq %d, pool %zu KiB at %pad\n",
+		 &v->regs_phys, v->regs_size, v->irq, v->pool_size >> 10,
+		 &v->pool_dma);
+	return 0;
+}
+
+static void ak39_venc_remove(struct platform_device *pdev)
+{
+	struct ak39_venc *v = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&v->guard_work);
+	misc_deregister(&v->misc);
+	ak39_venc_pool_free(v);
+}
+
+static const struct of_device_id ak39_venc_of_match[] = {
+	{ .compatible = "anyka,ak3918ev300-venc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ak39_venc_of_match);
+
+static struct platform_driver ak39_venc_driver = {
+	.probe = ak39_venc_probe,
+	.remove_new = ak39_venc_remove,
+	.driver = {
+		.name = "ak39-venc",
+		.of_match_table = ak39_venc_of_match,
+	},
+};
+module_platform_driver(ak39_venc_driver);
+
+MODULE_DESCRIPTION("Anyka AK3918EV300 video encoder access (user-space driven)");
+MODULE_LICENSE("GPL");
diff --git a/include/uapi/linux/ak39_venc.h b/include/uapi/linux/ak39_venc.h
new file mode 100644
index 000000000..4d2e00a6e
--- /dev/null
+++ b/include/uapi/linux/ak39_venc.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * User API of the Anyka AK3918EV300 video encoder window (/dev/uio0).
+ *
+ * The ioctl numbers of WAIT_IRQ (101) and SYSREG_WRITE (100) are those of
+ * the vendor "akuio" driver, so a vendor-compatible libakuio keeps working;
+ * the pool calls are new.
+ */
+#ifndef _UAPI_LINUX_AK39_VENC_H
+#define _UAPI_LINUX_AK39_VENC_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/* mmap() offsets (bytes) */
+#define AK39_VENC_MMAP_REGS	0x00000000UL	/* the register window */
+#define AK39_VENC_MMAP_POOL	0x10000000UL	/* the DMA pool */
+
+struct akuio_sysreg_write_t {
+	__u32 paddr;	/* physical address of a SYSCTRL register */
+	__u32 val;
+	__u32 mask;
+};
+
+struct ak39_venc_pool_info {
+	__u32 paddr;	/* physical address of the pool */
+	__u32 size;	/* bytes */
+	__u32 regs_paddr;	/* physical address of the register window */
+	__u32 regs_size;
+};
+
+#define AKUIO_SYSREG_WRITE	_IOW('U', 100, struct akuio_sysreg_write_t)
+#define AKUIO_WAIT_IRQ		_IOR('U', 101, int)
+#define AKUIO_VIDEO_RESET	_IOR('U', 105, int)
+#define AK39_VENC_POOL_INFO	_IOR('U', 110, struct ak39_venc_pool_info)
+
+#endif
