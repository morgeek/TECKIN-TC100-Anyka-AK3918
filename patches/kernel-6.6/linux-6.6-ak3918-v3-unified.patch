+int ak_isp_vo_set_cfg_reg(int regaddr, int value, int bitmask)
+{
+    int bits;
+
+    switch(regaddr)
+    {
+    case 0x0:
+        bitmask &=0x3e0000ff;
+        break;
+    case 0x04:
+    case 0x08:
+    case 0x0c:
+        break;
+    default:
+        return 0;
+    }
+    
+    bits = REG32(isp->base + regaddr);
+    bits &= ~bitmask;
+    bits |= value&bitmask;
+    REG32(isp->base + regaddr) = bits;
+
+    return 1;
+}
