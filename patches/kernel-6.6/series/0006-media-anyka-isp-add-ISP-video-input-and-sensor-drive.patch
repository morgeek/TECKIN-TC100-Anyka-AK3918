+	memcpy(p_osd_buffer, p_context, sizeof(AK_ISP_OSD_CONTEXT_ATTR));
+	if (OSD_DMA_ADDR(handle_osd) == isp_main_osd_curr_paddr(chn)) {
+		memcpy(p_area_osd + bytes_osd, p_context->osd_context_addr, osd_len);
