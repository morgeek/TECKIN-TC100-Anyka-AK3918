+
+    case MODE_MOST:
+         REG32(isp->base + 0x1c) = 0x1<<1;
+         break;
+    case MODE_ALL:
+         REG32(isp->base + 0x1c) = 0x1<<0 ;
+         break;
+         
+    default:
+        printk("error updata reg table mode\n");
+        break;      
+   }
+   
+   return 0;    
+}
