#!/bin/sh
export LD_LIBRARY_PATH='/mnt/lib/:/lib/:/usr/lib/'
CONFIGPATH="/mnt/config"

## Load some common functions:
. /mnt/scripts/common_functions.sh

install_config $CONFIGPATH/rtspserver.conf
install_config $CONFIGPATH/motion.conf

## TIME_WAIT handling. tcp_tw_recycle must stay OFF: with it, the kernel
## silently drops a SYN whose TCP timestamp is older than the last one seen
## from the same IP, which happens all the time for clients behind NAT or
## with per-connection timestamp offsets (Linux >= 4.10, e.g. go2rtc/Frigate
## in Docker). Measured on a TC100 (2026-10-13): ~22 SYNs/min dropped
## (PAWSPassive), Frigate re-dialing the RTSP sub-stream into "i/o timeout"
## 2-12 times an hour while ping and open streams kept working. The option was
## removed from Linux 4.12 for this reason. tcp_tw_reuse only affects
## outgoing connections and keeps quick restarts working.
echo 0 > /proc/sys/net/ipv4/tcp_tw_recycle
echo 1 > /proc/sys/net/ipv4/tcp_tw_reuse

## Keep 2 MB free for atomic allocations (Wi-Fi USB receive buffers, network
## stack) instead of the kernel's 1 MB. With ~33 MB of RAM and the page cache
## filling the rest, free memory hovered at 1.5-2 MB and fragmented (no free
## block above 64 KB); the RTL8188FU driver drops what it cannot buffer.
echo 2048 > /proc/sys/vm/min_free_kbytes

## SD card wear: do not record access dates. With relatime, vfat rewrote the
## directory entry of every script cron/CGIs read at most once a day each.
mount -o remount,noatime /mnt 2>/dev/null || true

## Init status files
echo 0 > /var/run/lum
echo 0 > /var/run/awb
echo 1 > /var/run/vday
echo 1 > /var/run/ircut

## Update shared mem config.
IFS=" "
set -- $(/mnt/bin/rwconf $CONFIGPATH/rtspserver.conf r \
    " "  daynight         \
    " "  daynightawb      \
    " "  daynightinfo     \
    " "  daynightlum      \
    " "  ircut            \
    " "  irled            \
    " "  mdenabled        \
    " "  mdsens           \
    " "  nightdayawb      \
    " "  nightdaylum      \
    " "  osdalpha         \
    " "  osdbackcolor     \
    " "  osdedgecolor     \
    " "  osdenabled       \
    " "  osdfrontcolor    \
    0    osdfontsize      \
    0    osdx             \
    0    osdy             \
    1    osdfontsize      \
    1    osdx             \
    1    osdy             \
    " "  videoday         \
    " "  imageflip)

daynight=$1     
daynightawb=$2   
daynightinfo=$3  
daynightlum=$4    
ircut=$5        
irled=$6        
mdenabled=$7      
mdsens=$8       
nightdayawb=$9    
nightdaylum=${10}
osdalpha=${11}
osdbackcolor=${12}
osdedgecolor=${13}
osdenabled=${14}
osdfrontcolor=${15}
osdfontsize0=${16}
osdx0=${17}
osdy0=${18}
osdfontsize1=${19}
osdx1=${20}
osdy1=${21}
videoday=${22}
imageflip=${23}

osdtext="$(read_config rtspserver.conf osdtext)"

/mnt/bin/setconf -k q -v "$CONFIGPATH/rtspserver.conf"
/mnt/bin/setconf -k n -v "$daynight"
/mnt/bin/setconf -k v -v "$videoday"
/mnt/bin/setconf -k f -v "$imageflip"
/mnt/bin/setconf -k r -v "$daynightawb"
/mnt/bin/setconf -k a -v "$daynightlum"
/mnt/bin/setconf -k b -v "$nightdayawb"
/mnt/bin/setconf -k d -v "$nightdaylum"
/mnt/bin/setconf -k e -v "$ircut"
/mnt/bin/setconf -k g -v "$irled"
/mnt/bin/setconf -k o -v "${osdtext}"
/mnt/bin/setconf -k c -v "$osdfrontcolor"
/mnt/bin/setconf -k s -v "$osdfontsize0"
/mnt/bin/setconf -k x -v "$osdx0"
/mnt/bin/setconf -k y -v "$osdy0"
/mnt/bin/setconf -k z -v "$osdfontsize1"
/mnt/bin/setconf -k w -v "$osdx1"
/mnt/bin/setconf -k t -v "$osdy1"
/mnt/bin/setconf -k h -v "$osdalpha"
/mnt/bin/setconf -k i -v "$osdbackcolor"
/mnt/bin/setconf -k j -v "$osdedgecolor"
/mnt/bin/setconf -k l -v "$osdenabled"
/mnt/bin/setconf -k m -v "$mdsens"
/mnt/bin/setconf -k p -v "$mdenabled"

# Start the sound detection daemon only when it is enabled. Since 1.8.4 the
# level is measured inside the RTSP server and the daemon just reads a tmpfs
# file, so it is cheap enough for every profile, frigate_ha included.
if [ "$(read_kv_config_value /mnt/config/sound_detection.conf ENABLE 0)" = "1" ]; then
    /mnt/controlscripts/sound-detection start
fi


