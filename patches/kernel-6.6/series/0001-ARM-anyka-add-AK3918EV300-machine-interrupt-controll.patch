diff --git a/drivers/clocksource/timer-ak39.c b/drivers/clocksource/timer-ak39.c
new file mode 100644
index 000000000..938325ead
--- /dev/null
+++ b/drivers/clocksource/timer-ak39.c
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Anyka AK3918EV300 system timers (SYSCTRL 0xB4..0xD8, five timers, 12 MHz).
+ * Timer 0 is the clock event (system interrupt 5), timer 4 a free-running
+ * down-counter used as clocksource and sched_clock.
+ * Register use from the vendor/OpenIPC 4.4 driver (drivers/clocksource/ak_timer.c).
+ */
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/sched_clock.h>
+
+#define AK39_TIMER(n)		(0xb4 + (n) * 8)	/* CTRL1, CTRL2 at +4 */
+#define CE			AK39_TIMER(0)
+#define CS			AK39_TIMER(4)
+
+#define TIMER_CLEAR		BIT(30)
+#define TIMER_FEED		BIT(29)
+#define TIMER_ENABLE		BIT(28)
+#define TIMER_STATUS		BIT(27)
+#define TIMER_READ_SEL		BIT(26)
+#define MODE_RELOAD		(0 << 24)
+#define MODE_ONESHOT		(1 << 24)
+
+static void __iomem *base;
+static u32 rate = 12000000;
+
+static u64 notrace ak39_read(void)
+{
+	unsigned long flags;
+	u32 c2, v;
+
+	local_irq_save(flags);
+	c2 = readl_relaxed(base + CS + 4);
+	writel_relaxed(c2 | TIMER_READ_SEL, base + CS + 4);
+	v = readl_relaxed(base + CS);
+	writel_relaxed(c2 & ~TIMER_READ_SEL, base + CS + 4);
+	local_irq_restore(flags);
+	return ~v;
+}
+
+static u64 ak39_cs_read(struct clocksource *cs)
+{
+	return ak39_read();
+}
+
+static struct clocksource ak39_cs = {
+	.name	= "ak39-timer",
+	.rating	= 200,
+	.read	= ak39_cs_read,
+	.mask	= CLOCKSOURCE_MASK(32),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+static int ak39_periodic(struct clock_event_device *evt)
+{
+	writel_relaxed(DIV_ROUND_CLOSEST(rate, HZ) - 1, base + CE);
+	writel_relaxed(MODE_RELOAD | TIMER_ENABLE | TIMER_FEED, base + CE + 4);
+	return 0;
+}
+
+static int ak39_next(unsigned long next, struct clock_event_device *evt)
+{
+	writel_relaxed(next, base + CE);
+	writel_relaxed(MODE_ONESHOT | TIMER_ENABLE | TIMER_FEED, base + CE + 4);
+	return 0;
+}
+
+static int ak39_shutdown(struct clock_event_device *evt)
+{
+	writel_relaxed(0, base + CE + 4);
+	return 0;
+}
+
+static struct clock_event_device ak39_ced = {
+	.name			= "ak39-timer0",
+	.features		= CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 200,
+	.set_next_event		= ak39_next,
+	.set_state_periodic	= ak39_periodic,
+	.set_state_oneshot	= ak39_shutdown,
+	.set_state_shutdown	= ak39_shutdown,
+	.tick_resume		= ak39_shutdown,
+};
+
+static irqreturn_t ak39_timer_irq(int irq, void *dev_id)
+{
+	struct clock_event_device *evt = dev_id;
+	u32 c2 = readl_relaxed(base + CE + 4);
+
+	if (!(c2 & TIMER_STATUS))
+		return IRQ_NONE;
+	writel_relaxed(c2 | TIMER_CLEAR, base + CE + 4);
+	evt->event_handler(evt);
+	return IRQ_HANDLED;
+}
+
+static int __init ak39_timer_init(struct device_node *node)
+{
+	int irq, ret;
+
+	base = of_iomap(node, 0);
+	if (!base)
+		return -ENOMEM;
+	of_property_read_u32(node, "clock-frequency", &rate);
+	irq = irq_of_parse_and_map(node, 0);
+	if (!irq)
+		return -EINVAL;
+
+	/* timer 4: free-running down-counter */
+	writel_relaxed(0xffffffff, base + CS);
+	writel_relaxed(MODE_RELOAD | TIMER_ENABLE | TIMER_FEED, base + CS + 4);
+	sched_clock_register(ak39_read, 32, rate);
+	clocksource_register_hz(&ak39_cs, rate);
+
+	ret = request_irq(irq, ak39_timer_irq, IRQF_TIMER | IRQF_IRQPOLL,
+			  "ak39-timer0", &ak39_ced);
+	if (ret)
+		return ret;
+	ak39_ced.cpumask = cpu_possible_mask;
+	clockevents_config_and_register(&ak39_ced, rate, 16, 0xffffffff);
+	return 0;
+}
+TIMER_OF_DECLARE(ak39_timer, "anyka,ak3918ev300-timer", ak39_timer_init);
