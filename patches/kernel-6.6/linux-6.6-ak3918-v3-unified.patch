 	.fill_txdesc = rtl8xxxu_fill_txdesc_v2,
 	.set_crystal_cap = rtl8188f_set_crystal_cap,
 	.cck_rssi = rtl8188f_cck_rssi,
-	.writeN_block_size = 128,
+	.writeN_block_size = 64,	/* Anyka AK39 host: one EP0 packet per transfer */
