#######################################################################
# Edit this file and move it to /mnt/config/monvifd.conf    #
# if you need to add options, otherwise defaults will be used         #
#######################################################################


ONVIF_PORT=8081

# Which ONVIF daemon runs: c (default: the free tc100-onvifd of src/onvifd: Device + Media + Media2 with the audio
# output/decoder for two-way audio, WS-Security login = the RTSP user and the password of user.pwd, snapshot URI, LAN
# filter) or monvifd (the closed original binary: only in the SD package since rc31; from the flash, c runs anyway).
ONVIF_IMPL=c
VENDOR_NAME=Anyka
HW_NAME=AK3918
DEVICE_LOCATION=Earth
DEVICE_NAME=Teckin
DEVICE_MODEL=TC100

# Optional ONVIF log file (default: /dev/null)
# ONVIF_LOGPATH=/mnt/log/onvif.log
