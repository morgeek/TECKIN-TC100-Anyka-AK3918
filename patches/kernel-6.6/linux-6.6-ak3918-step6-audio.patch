+/**
+ * @brief  hp det
+ * @author  Cheng Mingjuan
+ * @date   
+ * @return void
+ */
+static irqreturn_t ak39_codec_hpdet_irq(int irq, void *dev_id)
+{
+	struct ak39_codec *codec = dev_id;
+	
+	disable_irq_nosync(irq);
+
+	schedule_delayed_work(&codec->d_work, msecs_to_jiffies(100));
+	return IRQ_HANDLED;
+}
