diff --git a/drivers/tty/serial/ak39_uart.c b/drivers/tty/serial/ak39_uart.c
new file mode 100644
index 000000000..753f1b290
--- /dev/null
+++ b/drivers/tty/serial/ak39_uart.c
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Anyka AK3918EV300 UART: polled transmit (console + tty) and polled
+ * receive (timer, 20 ms). The line settings left by the boot loader are kept.
+ *
+ * Receive: the controller writes incoming bytes into a 128-byte ring in the
+ * L2 memory right after the TX buffer (+0x80); DATA_CONF bits 13-19 give
+ * the ring write position. Start-up sequence from the 4.4 ak_uart.c.
+ *
+ * The AK39 UART sends from a 128-byte buffer in the on-chip L2 memory:
+ * write the bytes there, write the "buffer full" marker at +0x3C, then set
+ * the byte count and the start bit in CONF2 and wait for TX end.
+ * Sequence from the vendor/OpenIPC 4.4 driver (drivers/tty/serial/ak_uart.c).
+ *
+ * reg[0] UART registers, reg[1] L2 controller, reg[2] this UART's L2 TX buffer.
+ */
+#include <linux/console.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/timer.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/serial_core.h>
+#include <linux/tty.h>
+#include <linux/tty_flip.h>
+
+#define UART_CONF1		0x00
+#define UART_CONF2		0x04
+#define DATA_CONF		0x08
+#define STOPBIT_TIMEOUT		0x18
+#define CONF1_EN		BIT(21)
+#define CONF1_TIMEOUT_EN	BIT(23)
+#define CONF1_RX_STA_CLR	BIT(29)
+#define RX_TH_CLR		BIT(5)
+#define RX_START		BIT(31)
+#define RX_RING			128
+#define RX_POLL_MS		5
+#define BUF_THRESHOLD		0x0c
+#define CONF1_TX_STA_CLR	BIT(28)
+#define CONF2_INT_MASK		0x3fe00000
+#define CONF2_TX_END		BIT(19)
+#define L2_BUF_STATUS		0x8c
+
+struct ak39_uart {
+	struct uart_port port;
+	void __iomem *l2ctrl;
+	void __iomem *txbuf;
+	void __iomem *rxbuf;
+	struct timer_list rx_timer;
+	unsigned int rx_pos;
+};
+
+static struct ak39_uart *ak39_ports[2];
+
+static void ak39_putc(struct ak39_uart *u, unsigned char c)
+{
+	void __iomem *b = u->port.membase;
+	u32 v;
+	int timeout = 100000;
+
+	writel_relaxed(readl_relaxed(b + UART_CONF1) | CONF1_TX_STA_CLR, b + UART_CONF1);
+	v = readl_relaxed(u->l2ctrl + L2_BUF_STATUS);
+	writel_relaxed(v | BIT(16 + u->port.line * 2), u->l2ctrl + L2_BUF_STATUS);
+	writel_relaxed(c, u->txbuf);
+	writel_relaxed(0, u->txbuf + 0x3c);
+	writel_relaxed(readl_relaxed(b + BUF_THRESHOLD) | BIT(11), b + BUF_THRESHOLD);
+	v = readl_relaxed(b + UART_CONF2) & CONF2_INT_MASK;
+	writel_relaxed(v | BIT(4) | BIT(16), b + UART_CONF2);
+	while (!(readl_relaxed(b + UART_CONF2) & CONF2_TX_END) && --timeout)
+		cpu_relax();
+}
+
+static unsigned int ak39_tx_empty(struct uart_port *port) { return TIOCSER_TEMT; }
+static void ak39_set_mctrl(struct uart_port *port, unsigned int mctrl) { }
+static unsigned int ak39_get_mctrl(struct uart_port *port)
+{
+	return TIOCM_CAR | TIOCM_DSR | TIOCM_CTS;
+}
+static void ak39_stop_tx(struct uart_port *port) { }
+static void ak39_stop_rx(struct uart_port *port) { }
+
+static void ak39_start_tx(struct uart_port *port)
+{
+	struct ak39_uart *u = container_of(port, struct ak39_uart, port);
+	struct circ_buf *xmit = &port->state->xmit;
+
+	while (!uart_circ_empty(xmit)) {
+		ak39_putc(u, xmit->buf[xmit->tail]);
+		uart_xmit_advance(port, 1);
+	}
+	if (uart_circ_chars_pending(xmit) < WAKEUP_CHARS)
+		uart_write_wakeup(port);
+}
+
+static void ak39_rx_drain(struct ak39_uart *u)
+{
+	struct uart_port *port = &u->port;
+	unsigned int wr, n = 0;
+	u32 st;
+	unsigned long flags;
+
+	spin_lock_irqsave(&port->lock, flags);
+	/*
+	 * After an RX timeout (line idle), a full buffer or a threshold hit the
+	 * receiver pauses until the status is write-cleared and RX_START set
+	 * again (4.4 uart_subint_clear()). Without this, input stops after the
+	 * first pause or 128 bytes.
+	 */
+	st = readl_relaxed(port->membase + UART_CONF2);
+	if (st & (BIT(1) | BIT(2) | BIT(30))) {
+		writel_relaxed((st & CONF2_INT_MASK) | (st & (BIT(1) | BIT(2) | BIT(30))),
+			       port->membase + UART_CONF2);
+		writel_relaxed(readl_relaxed(port->membase + BUF_THRESHOLD) | RX_START,
+			       port->membase + BUF_THRESHOLD);
+	}
+	wr = (readl_relaxed(port->membase + DATA_CONF) >> 13) & 0x7f;
+	while (u->rx_pos != wr) {
+		unsigned char c = readb_relaxed(u->rxbuf + u->rx_pos);
+
+		port->icount.rx++;
+		uart_insert_char(port, 0, 0, c, TTY_NORMAL);
+		u->rx_pos = (u->rx_pos + 1) % RX_RING;
+		n++;
+	}
+	spin_unlock_irqrestore(&port->lock, flags);
+	if (n)
+		tty_flip_buffer_push(&port->state->port);
+}
+
+/* 115200 baud fills the 128-byte ring in ~11 ms: the threshold (32 bytes)
+ * and timeout interrupts drain it; the timer only catches a lost interrupt. */
+static irqreturn_t ak39_rx_irq(int irq, void *dev)
+{
+	ak39_rx_drain(dev);
+	return IRQ_HANDLED;
+}
+
+static void ak39_rx_poll(struct timer_list *t)
+{
+	struct ak39_uart *u = from_timer(u, t, rx_timer);
+
+	ak39_rx_drain(u);
+	mod_timer(&u->rx_timer, jiffies + msecs_to_jiffies(RX_POLL_MS));
+}
+
+static int ak39_startup(struct uart_port *port)
+{
+	struct ak39_uart *u = container_of(port, struct ak39_uart, port);
+	void __iomem *b = port->membase;
+	u32 v;
+
+	/* clear the L2 RX buffer status, then the controller's RX state */
+	v = readl_relaxed(u->l2ctrl + L2_BUF_STATUS);
+	writel_relaxed(v | BIT(17 + port->line * 2), u->l2ctrl + L2_BUF_STATUS);
+	writel_relaxed(readl_relaxed(b + UART_CONF1) | CONF1_EN | CONF1_TIMEOUT_EN |
+		       CONF1_RX_STA_CLR, b + UART_CONF1);
+	writel_relaxed(0x1f << 16, b + STOPBIT_TIMEOUT);
+	v = readl_relaxed(b + BUF_THRESHOLD) & ~0x1f;
+	writel_relaxed(v | 0x1f, b + BUF_THRESHOLD);
+	writel_relaxed(readl_relaxed(b + BUF_THRESHOLD) | RX_TH_CLR, b + BUF_THRESHOLD);
+	udelay(10);
+	writel_relaxed(readl_relaxed(b + BUF_THRESHOLD) & ~RX_TH_CLR, b + BUF_THRESHOLD);
+	udelay(10);
+	writel_relaxed(readl_relaxed(b + BUF_THRESHOLD) | RX_START, b + BUF_THRESHOLD);
+	u->rx_pos = (readl_relaxed(b + DATA_CONF) >> 13) & 0x7f;
+	if (port->irq > 0 && !request_irq(port->irq, ak39_rx_irq, 0, "ak39-uart", u))
+		writel_relaxed((readl_relaxed(b + UART_CONF2) & CONF2_INT_MASK) |
+			       BIT(21) | BIT(22) | BIT(28), b + UART_CONF2);
+	timer_setup(&u->rx_timer, ak39_rx_poll, 0);
+	mod_timer(&u->rx_timer, jiffies + msecs_to_jiffies(RX_POLL_MS));
+	return 0;
+}
+
+static void ak39_shutdown(struct uart_port *port)
+{
+	struct ak39_uart *u = container_of(port, struct ak39_uart, port);
+
+	del_timer_sync(&u->rx_timer);
+	if (port->irq > 0) {
+		writel_relaxed(readl_relaxed(port->membase + UART_CONF2) &
+			       CONF2_INT_MASK & ~(BIT(21) | BIT(22) | BIT(28)),
+			       port->membase + UART_CONF2);
+		free_irq(port->irq, u);
+	}
+}
+static void ak39_set_termios(struct uart_port *port, struct ktermios *new,
+			     const struct ktermios *old)
+{
+	/* keep the boot loader's 115200 8N1 for now */
+	tty_termios_copy_hw(new, old ? old : new);
+	tty_termios_encode_baud_rate(new, 115200, 115200);
+}
+static const char *ak39_type(struct uart_port *port) { return "AK39"; }
+static void ak39_config_port(struct uart_port *port, int flags)
+{
+	port->type = PORT_UNKNOWN + 1;
+}
+
+static const struct uart_ops ak39_ops = {
+	.tx_empty	= ak39_tx_empty,
+	.set_mctrl	= ak39_set_mctrl,
+	.get_mctrl	= ak39_get_mctrl,
+	.stop_tx	= ak39_stop_tx,
+	.start_tx	= ak39_start_tx,
+	.stop_rx	= ak39_stop_rx,
+	.startup	= ak39_startup,
+	.shutdown	= ak39_shutdown,
+	.set_termios	= ak39_set_termios,
+	.type		= ak39_type,
+	.config_port	= ak39_config_port,
+};
+
+static void ak39_console_putchar(struct uart_port *port, unsigned char ch)
+{
+	ak39_putc(container_of(port, struct ak39_uart, port), ch);
+}
+
+static void ak39_console_write(struct console *co, const char *s, unsigned int n)
+{
+	struct ak39_uart *u = ak39_ports[co->index];
+
+	if (u)
+		uart_console_write(&u->port, s, n, ak39_console_putchar);
+}
+
+static struct uart_driver ak39_driver;
+
+static struct console ak39_console = {
+	.name	= "ttySAK",
+	.write	= ak39_console_write,
+	.device	= uart_console_device,
+	.flags	= CON_PRINTBUFFER,
+	.index	= -1,
+	.data	= &ak39_driver,
+};
+
+static struct uart_driver ak39_driver = {
+	.owner		= THIS_MODULE,
+	.driver_name	= "ak39-uart",
+	.dev_name	= "ttySAK",
+	.major		= 204,
+	.minor		= 64,
+	.nr		= 2,
+	.cons		= &ak39_console,
+};
+
+static int ak39_uart_probe(struct platform_device *pdev)
+{
+	struct ak39_uart *u;
+	struct resource *res;
+	int id, ret;
+
+	id = of_alias_get_id(pdev->dev.of_node, "serial");
+	if (id < 0)
+		id = 0;
+	if (id >= ARRAY_SIZE(ak39_ports))
+		return -EINVAL;
+	u = devm_kzalloc(&pdev->dev, sizeof(*u), GFP_KERNEL);
+	if (!u)
+		return -ENOMEM;
+	u->port.membase = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(u->port.membase))
+		return PTR_ERR(u->port.membase);
+	u->port.mapbase = res->start;
+	u->l2ctrl = devm_ioremap(&pdev->dev,
+				 platform_get_resource(pdev, IORESOURCE_MEM, 1)->start, 0x100);
+	u->txbuf = devm_ioremap(&pdev->dev,
+				platform_get_resource(pdev, IORESOURCE_MEM, 2)->start, 0x100);
+	if (!u->l2ctrl || !u->txbuf)
+		return -ENOMEM;
+	u->rxbuf = u->txbuf + 0x80;
+	u->port.irq = platform_get_irq_optional(pdev, 0);
+	u->port.dev = &pdev->dev;
+	u->port.ops = &ak39_ops;
+	u->port.line = id;
+	u->port.iotype = UPIO_MEM;
+	u->port.flags = UPF_BOOT_AUTOCONF;
+	u->port.uartclk = 115200 * 16;
+	u->port.fifosize = 1;
+	u->port.has_sysrq = 0;
+	ak39_ports[id] = u;
+	ret = uart_add_one_port(&ak39_driver, &u->port);
+	if (ret)
+		ak39_ports[id] = NULL;
+	return ret;
+}
+
+static const struct of_device_id ak39_uart_of_match[] = {
+	{ .compatible = "anyka,ak3918ev300-uart" },
+	{ }
+};
+
+static struct platform_driver ak39_uart_platform = {
+	.probe	= ak39_uart_probe,
+	.driver	= {
+		.name		= "ak39-uart",
+		.of_match_table	= ak39_uart_of_match,
+	},
+};
+
+static int __init ak39_uart_init(void)
+{
+	int ret = uart_register_driver(&ak39_driver);
+
+	if (ret)
+		return ret;
+	ret = platform_driver_register(&ak39_uart_platform);
+	if (ret)
+		uart_unregister_driver(&ak39_driver);
+	return ret;
+}
+module_init(ak39_uart_init);
+MODULE_LICENSE("GPL");
