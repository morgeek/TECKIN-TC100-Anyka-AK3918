+static int akpcm_capture_close(struct snd_pcm_substream *substream)
+{
+	struct snd_akpcm *akpcm = snd_pcm_substream_chip(substream);
+	capSync.adcCapture_bytes = 0;
+	akpcm->capturesubstrm=NULL;
