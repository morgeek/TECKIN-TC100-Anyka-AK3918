+	reg_val &= ~(0x7 << 29);
+	reg_val |= (value << 29);
+	REG32(codec->analog_ctrl_base + ANALOG_CTRL_REG1) = reg_val;
+}
+
+
+static void set_cur_pmos(struct ak39_codec *codec, unsigned long value)
+{
+	int reg_val;
+	reg_val = REG32(codec->analog_ctrl_base + ANALOG_CTRL_REG1);
+	reg_val &= ~(0xf << 25);
+	reg_val |= (value << 25);
+	REG32(codec->analog_ctrl_base + ANALOG_CTRL_REG1) = reg_val;
