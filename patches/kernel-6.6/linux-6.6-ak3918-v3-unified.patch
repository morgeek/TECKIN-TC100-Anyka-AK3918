+int ak_isp_vi_set_sub128(int sub)
+{
+	unsigned int cmd;
+
+	cmd = REG32(isp->base + CSI_ERR_CHECK_1);
+	CLEAR_BITS(cmd, 30, 1);
+	cmd |= sub ? (1<<30):0;
+	REG32(isp->base + CSI_ERR_CHECK_1) = cmd;
+
+	return 0;
+}
