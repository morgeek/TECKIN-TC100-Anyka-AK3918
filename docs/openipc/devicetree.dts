            clocks = <0x5 0x12>;
            compatible = "anyka,ak39ev330-uio-vencoder";
            interrupts = <0x2 0x0>;
            reg = <0x20020000 0x10000>;
            status = "okay";
        };
    };
    system-control-ic {
        compatible = "anyka,ak39ev330-system-ic";
        interrupt-controller;
        interrupts = <0x3 0x0>;
    };
    timer {
        clock-frequency = <0xb71b00>;
        compatible = "anyka,ak39ev330-system-timer";
        interrupts = <0x6 0x1 0x5 0x1 0x4 0x1 0x3 0x1 0x2 0x1>;
        status = "okay";
    };
    watchdog {
        compatible = "anyka,ak39ev330-wdt";
        def_heartbeat = <0xa>;
        status = "okay";
    };
};
