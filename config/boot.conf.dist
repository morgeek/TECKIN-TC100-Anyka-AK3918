# Boot-time performance settings
# Set to 1 to enable lightweight defaults (lower CPU/RAM).
LIGHTWEIGHT_MODE=0

# Service toggles (1=enable, 0=disable)
ENABLE_WATCHDOG=1
ENABLE_NTP=1
# If ENABLE_NTP=1 and NTP_ONE_SHOT=1, run a one-time sync and exit.
NTP_ONE_SHOT=0
ENABLE_CROND=1
ENABLE_AUTOSTART=1

# Web server mode:
# - full: https + redirect (lighttpd, default)
# - http: http only (lighttpd, no TLS)
# - ultra-lite: http only (busybox httpd, lightest CPU/RAM, no lighttpd auth/TLS layer)
# - off: web server disabled
WEB_MODE=full
# Optional listen port for WEB_MODE=ultra-lite
ULTRALITE_HTTP_PORT=80
# UI ultra-lite mode:
# - 1: aggressively lowers UI polling/live-preview cadence and pauses live feed by default
# - 0: normal UI behavior
UI_ULTRALITE_MODE=0

# Low CPU profile (recommended for very low usage)
# When enabled, the startup script applies conservative RTSP settings and
# can disable substream/audio/OSD/motion/jpeg. These options are only
# applied when LOW_CPU_PROFILE=1. To keep substream/audio, set the
# corresponding LOW_CPU_DISABLE_* value to 0.
LOW_CPU_PROFILE=0
LOW_CPU_DISABLE_SUBSTREAM=1
LOW_CPU_DISABLE_AUDIO=1
LOW_CPU_DISABLE_MOTION=1
LOW_CPU_DISABLE_OSD=1
LOW_CPU_DISABLE_JPEG=1

# Optional overrides for low CPU profile
LOW_CPU_MAIN_WIDTH=640
LOW_CPU_MAIN_HEIGHT=360
LOW_CPU_MAIN_FPS=10
LOW_CPU_MAIN_BPS=600
LOW_CPU_MAIN_GOPLEN=30
LOW_CPU_MAIN_MAXKBPS=800
LOW_CPU_MAIN_TARGETKBPS=500

LOW_CPU_SUB_WIDTH=320
LOW_CPU_SUB_HEIGHT=180
LOW_CPU_SUB_FPS=4
LOW_CPU_SUB_BPS=150
LOW_CPU_SUB_GOPLEN=16
LOW_CPU_SUB_MAXKBPS=200
LOW_CPU_SUB_TARGETKBPS=150

# Low RAM profile (recommended for 64MB-class devices)
# Enables memory guard defaults to shed non-critical services when memory is low.
LOW_RAM_PROFILE=0

# Memory guard runtime behavior
# - reads MemAvailable from /proc/meminfo
# - if below WARN threshold, stops soft services
# - if below CRITICAL threshold, also stops critical services and can drop caches
MEM_GUARD_ENABLE=0
MEM_GUARD_INTERVAL_SECONDS=20
MEM_GUARD_WARN_KB=8192
MEM_GUARD_CRITICAL_KB=4096
MEM_GUARD_EMERGENCY_KB=2048
MEM_GUARD_RECOVERY_MARGIN_KB=1536
MEM_GUARD_WARN_HITS=2
MEM_GUARD_CRITICAL_HITS=1
MEM_GUARD_COOLDOWN_SECONDS=120
MEM_GUARD_DROP_CACHES=1
MEM_GUARD_SOFT_SERVICES="network-monitor auto-night-detection"
MEM_GUARD_CRITICAL_SERVICES="ftp-server telnet-server timelapse recording motion-detection"
# Optional extra emergency stop list (only when MEM_GUARD_EMERGENCY_KB is hit)
MEM_GUARD_EMERGENCY_SERVICES=""

# Autostart filtering:
# - AUTOSTART_ALLOWLIST: if set, only these scripts will run.
# - AUTOSTART_DENYLIST: if set, these scripts will be skipped.
# Script names are files in /mnt/config/autostart (e.g. "rtsp-h26x").
# In LIGHTWEIGHT_MODE, if both lists are unset, a default denylist is applied.
AUTOSTART_ALLOWLIST=""
AUTOSTART_DENYLIST=""

# RTSP stream toggles (1=enable, 0=disable). Low CPU profile may
# default these to 0 unless you set them explicitly.
# Common topology presets:
# - Dual stream + audio: RTSP_SUBSTREAM=1, RTSP_AUDIO=1
# - Dual stream, audio off: RTSP_SUBSTREAM=1, RTSP_AUDIO=0
# - Main stream + audio: RTSP_SUBSTREAM=0, RTSP_AUDIO=1
# - Main stream only: RTSP_SUBSTREAM=0, RTSP_AUDIO=0
RTSP_SUBSTREAM=1
RTSP_AUDIO=1

# ONVIF advertised stream policy:
# - main-primary: ONVIF profile 1 = main stream (default)
# - sub-primary: ONVIF profile 1 = sub stream, profile 2 = main stream
# - sub-only: ONVIF exposes only sub stream (keeps main RTSP for recorder/direct clients)
# - main-only: ONVIF exposes only main stream
ONVIF_STREAM_POLICY=main-primary

# Health-probe timeout (seconds) for service watchdog checks.
RTSP_HEALTHCHECK_TIMEOUT_SECONDS=4
ONVIF_HEALTHCHECK_TIMEOUT_SECONDS=4
# ONVIF health hardening:
# - ONVIF_STARTUP_GRACE_SECONDS: skip ONVIF health failures right after start
# - ONVIF_HEALTHCHECK_RETRIES: retries for local ONVIF HTTP probe
# - ONVIF_RTSP_DEPENDENCY_MODE:
#     off    -> ONVIF health ignores RTSP state
#     status -> ONVIF health requires RTSP process only (recommended)
#     health -> ONVIF health requires RTSP deep health
ONVIF_STARTUP_GRACE_SECONDS=20
ONVIF_HEALTHCHECK_RETRIES=2
ONVIF_RTSP_DEPENDENCY_MODE=status
# Watchdog monitor interval in seconds (used by service-watchdog).
CHECK_TIMEOUT_SECONDS=60
# Watchdog mode per service:
# - status: restart only when process is not running (safer for flaky health probes)
# - health: use deep health checks (RTSP DESCRIBE/ONVIF HTTP probe) before deciding
RTSP_WATCHDOG_MODE=status
ONVIF_WATCHDOG_MODE=status
# service-watchdog log rotation safeguards
WATCHDOG_LOG_MAX_BYTES=262144
WATCHDOG_LOG_BACKUPS=2
# Chip temperature source for UI/statusline:
# - auto: try common Linux thermal nodes
# - custom path: e.g. /sys/class/thermal/thermal_zone0/temp
CHIP_TEMP_SOURCE_PATH=auto
# Raw value divisor:
# - auto: detect 1000-based millidegree or direct Celsius
# - explicit: set 1000 (millidegree), 1 (Celsius), etc.
CHIP_TEMP_RAW_DIVISOR=auto

# Example lightweight allowlist:
# AUTOSTART_ALLOWLIST="00_system-config rtsp-h26x"
# Example lightweight denylist:
# AUTOSTART_DENYLIST="01_system-emergency-telnet 02_system-webserver auto-night-detection blue-led"
