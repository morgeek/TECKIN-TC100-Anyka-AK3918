#!/bin/sh
SERVICE_NAME="ONVIF Discovery"
PIDFILE="/var/run/onvif.pid"
WATCHDOG_PIDFILE="/var/run/onvif-watch.pid"
START_TS_FILE="/var/run/onvif-start.ts"
export LD_LIBRARY_PATH='/mnt/lib/:/thirdlib:/system/lib/:/usr/lib/'
CONFIGPATH="/mnt/config"

. /mnt/scripts/common_functions.sh

install_config $CONFIGPATH/onvif.conf
. $CONFIGPATH/onvif.conf

install_config $CONFIGPATH/rtspserver.conf

# monvifd supports explicit ONVIF location metadata via -loc.
# Keep backward compatibility with older custom configs that used LOCATION.
: "${DEVICE_LOCATION:=}"
if [ -z "$DEVICE_LOCATION" ] && [ -n "$LOCATION" ]; then
  DEVICE_LOCATION="$LOCATION"
fi
: "${DEVICE_LOCATION:=Earth}"

BOOT_CONFIG="$CONFIGPATH/boot.conf"
WEB_MODE="full"
RTSP_SUBSTREAM="1"
if [ -f "$BOOT_CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$BOOT_CONFIG"
fi
: "${ONVIF_STREAM_POLICY:=main-primary}"
: "${ONVIF_HEALTHCHECK_TIMEOUT_SECONDS:=4}"
: "${ONVIF_WATCHDOG_MODE:=status}"
: "${ONVIF_HEALTHCHECK_RETRIES:=2}"
: "${ONVIF_STARTUP_GRACE_SECONDS:=20}"
: "${ONVIF_RTSP_DEPENDENCY_MODE:=status}"

case "$ONVIF_HEALTHCHECK_TIMEOUT_SECONDS" in
  ''|*[!0-9]*) ONVIF_HEALTHCHECK_TIMEOUT_SECONDS=4 ;;
esac
[ "$ONVIF_HEALTHCHECK_TIMEOUT_SECONDS" -lt 2 ] && ONVIF_HEALTHCHECK_TIMEOUT_SECONDS=2
[ "$ONVIF_HEALTHCHECK_TIMEOUT_SECONDS" -gt 30 ] && ONVIF_HEALTHCHECK_TIMEOUT_SECONDS=30

case "$ONVIF_HEALTHCHECK_RETRIES" in
  ''|*[!0-9]*) ONVIF_HEALTHCHECK_RETRIES=2 ;;
esac
[ "$ONVIF_HEALTHCHECK_RETRIES" -lt 1 ] && ONVIF_HEALTHCHECK_RETRIES=1
[ "$ONVIF_HEALTHCHECK_RETRIES" -gt 5 ] && ONVIF_HEALTHCHECK_RETRIES=5

case "$ONVIF_STARTUP_GRACE_SECONDS" in
  ''|*[!0-9]*) ONVIF_STARTUP_GRACE_SECONDS=20 ;;
esac
[ "$ONVIF_STARTUP_GRACE_SECONDS" -lt 0 ] && ONVIF_STARTUP_GRACE_SECONDS=0
[ "$ONVIF_STARTUP_GRACE_SECONDS" -gt 180 ] && ONVIF_STARTUP_GRACE_SECONDS=180

case "$ONVIF_WATCHDOG_MODE" in
  status|health) ;;
  *) ONVIF_WATCHDOG_MODE="status" ;;
esac

case "$ONVIF_RTSP_DEPENDENCY_MODE" in
  off|status|health) ;;
  *) ONVIF_RTSP_DEPENDENCY_MODE="status" ;;
esac

WEB_PROTO="https"
WEB_PORT="443"
case "$WEB_MODE" in
  http)
    WEB_PROTO="http"
    WEB_PORT="80"
    ;;
  ultra-lite|ultralite)
    WEB_PROTO="http"
    case "${ULTRALITE_HTTP_PORT}" in
      ''|*[!0-9]*) WEB_PORT="80" ;;
      *) WEB_PORT="${ULTRALITE_HTTP_PORT}" ;;
    esac
    ;;
esac

status()
{
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  if [ "$pid" ]; then
    # Prints PID: $pid if exists and returns 0(no error) else returns 1(error condition)
    kill -0 "$pid" >/dev/null && echo "PID: $pid" || return 1
  fi
}

start()
{
  if [ "$(status)" != "" ]; then
    echo "A ONVIF Discovery service is already running, please stop it or reboot"
  else
    echo "Starting ONVIF Discovery service"
    
    LOGPATH="${ONVIF_LOGPATH:-/dev/null}"

    WIDTH0=$(read_config  rtspserver.conf width   0)
    HEIGHT0=$(read_config rtspserver.conf height  0)
    CODEC0=$(read_config  rtspserver.conf codec   0)
    FPS0=$(read_config    rtspserver.conf fps     0)
    BPS0=$(read_config    rtspserver.conf bps     0)

    CODECSTR0="H264"
    if [ "$CODEC0" = "2" ]; then
      CODECSTR0="H265"
    fi

    WIDTH1=$(read_config  rtspserver.conf width   1)
    HEIGHT1=$(read_config rtspserver.conf height  1)
    CODEC1=$(read_config  rtspserver.conf codec   1)
    FPS1=$(read_config    rtspserver.conf fps     1)
    BPS1=$(read_config    rtspserver.conf bps     1)

    CODECSTR1="H264"
    if [ "$CODEC1" = "2" ]; then
      CODECSTR1="H265"
    fi

    PORT=$(read_config rtspserver.conf PORT)

    PRIMARY_RP="video0_unicast"
    PRIMARY_WIDTH="$WIDTH0"
    PRIMARY_HEIGHT="$HEIGHT0"
    PRIMARY_CODEC="$CODECSTR0"
    PRIMARY_BPS="$BPS0"
    PRIMARY_FPS="$FPS0"

    SECONDARY_ENABLED=0
    SECONDARY_RP=""
    SECONDARY_WIDTH=""
    SECONDARY_HEIGHT=""
    SECONDARY_CODEC=""
    SECONDARY_BPS=""
    SECONDARY_FPS=""

    if [ "$RTSP_SUBSTREAM" = "1" ]; then
      SECONDARY_ENABLED=1
      SECONDARY_RP="video1_unicast"
      SECONDARY_WIDTH="$WIDTH1"
      SECONDARY_HEIGHT="$HEIGHT1"
      SECONDARY_CODEC="$CODECSTR1"
      SECONDARY_BPS="$BPS1"
      SECONDARY_FPS="$FPS1"
    fi

    case "$ONVIF_STREAM_POLICY" in
      sub-primary)
        if [ "$RTSP_SUBSTREAM" = "1" ]; then
          PRIMARY_RP="video1_unicast"
          PRIMARY_WIDTH="$WIDTH1"
          PRIMARY_HEIGHT="$HEIGHT1"
          PRIMARY_CODEC="$CODECSTR1"
          PRIMARY_BPS="$BPS1"
          PRIMARY_FPS="$FPS1"

          SECONDARY_ENABLED=1
          SECONDARY_RP="video0_unicast"
          SECONDARY_WIDTH="$WIDTH0"
          SECONDARY_HEIGHT="$HEIGHT0"
          SECONDARY_CODEC="$CODECSTR0"
          SECONDARY_BPS="$BPS0"
          SECONDARY_FPS="$FPS0"
        fi
        ;;
      sub-only)
        if [ "$RTSP_SUBSTREAM" = "1" ]; then
          PRIMARY_RP="video1_unicast"
          PRIMARY_WIDTH="$WIDTH1"
          PRIMARY_HEIGHT="$HEIGHT1"
          PRIMARY_CODEC="$CODECSTR1"
          PRIMARY_BPS="$BPS1"
          PRIMARY_FPS="$FPS1"
        fi
        SECONDARY_ENABLED=0
        ;;
      main-only)
        SECONDARY_ENABLED=0
        ;;
      main-primary|*)
        # Default behavior.
        ;;
    esac

    if [ "$SECONDARY_ENABLED" = "1" ]; then
      ONVIF_STREAM2_ARGS="-en2 1 -rp2 $SECONDARY_RP -vw2 $SECONDARY_WIDTH -vh2 $SECONDARY_HEIGHT -vc2 $SECONDARY_CODEC -vcb2 $SECONDARY_BPS -fps2 $SECONDARY_FPS"
    else
      ONVIF_STREAM2_ARGS="-en2 0"
    fi

    /mnt/bin/monvifd -p "$ONVIF_PORT" -w "$WEB_PORT" -wp "$WEB_PROTO" -r "$PORT" -hwn "$HW_NAME" -vnn "$VENDOR_NAME" -loc "$DEVICE_LOCATION" -dn "$DEVICE_NAME" -mod "$DEVICE_MODEL" \
        -rp1 "$PRIMARY_RP" -vw1 "$PRIMARY_WIDTH" -vh1 "$PRIMARY_HEIGHT" -vc1 "$PRIMARY_CODEC" -vcb1 "$PRIMARY_BPS" -fps1 "$PRIMARY_FPS" \
        $ONVIF_STREAM2_ARGS 2>> "$LOGPATH" >> "$LOGPATH" &
    echo "$!" > "$PIDFILE"
    date +%s > "$START_TS_FILE" 2>/dev/null || true

    ## Watchdog
    if ! checkpid "$WATCHDOG_PIDFILE"; then
      CHECK_TIMEOUT_SECONDS="${CHECK_TIMEOUT_SECONDS:-60}" \
      WATCHDOG_LOG_MAX_BYTES="${WATCHDOG_LOG_MAX_BYTES:-262144}" \
      WATCHDOG_LOG_BACKUPS="${WATCHDOG_LOG_BACKUPS:-2}" \
      WATCHDOG_NO_REBOOT_BASE_DELAY_SECONDS="${WATCHDOG_NO_REBOOT_BASE_DELAY_SECONDS:-20}" \
      WATCHDOG_NO_REBOOT_BACKOFF_STEP_SECONDS="${WATCHDOG_NO_REBOOT_BACKOFF_STEP_SECONDS:-15}" \
      WATCHDOG_NO_REBOOT_MAX_DELAY_SECONDS="${WATCHDOG_NO_REBOOT_MAX_DELAY_SECONDS:-180}" \
      /mnt/scripts/service-watchdog.sh /mnt/controlscripts/onvif 0 "$ONVIF_WATCHDOG_MODE" &
      echo "$!" > "$WATCHDOG_PIDFILE"
    fi
  fi
}

health()
{
  if [ "$(status)" = "" ]; then
    return 1
  fi

  if [ "$ONVIF_STARTUP_GRACE_SECONDS" -gt 0 ] && [ -r "$START_TS_FILE" ]; then
    read -r start_ts < "$START_TS_FILE"
    case "$start_ts" in
      ''|*[!0-9]*) start_ts=0 ;;
    esac
    now_ts="$(date +%s 2>/dev/null)"
    case "$now_ts" in
      ''|*[!0-9]*) now_ts=0 ;;
    esac
    if [ "$start_ts" -gt 0 ] && [ "$now_ts" -gt "$start_ts" ]; then
      age=$((now_ts - start_ts))
      if [ "$age" -lt "$ONVIF_STARTUP_GRACE_SECONDS" ]; then
        echo "HEALTHY"
        return 0
      fi
    fi
  fi

  case "$ONVIF_RTSP_DEPENDENCY_MODE" in
    health)
      /mnt/controlscripts/rtsp-h26x health >/dev/null 2>&1 || return 1
      ;;
    status)
      /mnt/controlscripts/rtsp-h26x status >/dev/null 2>&1 || return 1
      ;;
  esac

  if [ -x /mnt/bin/curl ]; then
    attempt=1
    while [ "$attempt" -le "$ONVIF_HEALTHCHECK_RETRIES" ]; do
      if /mnt/bin/curl -s -S -m "$ONVIF_HEALTHCHECK_TIMEOUT_SECONDS" -o /dev/null "http://127.0.0.1:${ONVIF_PORT}/" >/dev/null 2>&1; then
        echo "HEALTHY"
        return 0
      fi
      attempt=$((attempt + 1))
      if [ "$attempt" -le "$ONVIF_HEALTHCHECK_RETRIES" ]; then
        sleep 1
      fi
    done
    return 1
  fi

  echo "HEALTHY"
}

restart()
{
  stop
  sleep 1
  start
}

stop()
{
  rm -f "$START_TS_FILE"
  killpid "$WATCHDOG_PIDFILE"
  killpid "$PIDFILE"
}

if [ $# -eq 0 ]; then
  start
else
  case "$1" in
    start|stop|status|restart|health)
      "$1"
      ;;
    *)
      echo "Usage: $0 {start|stop|status|restart|health}" >&2
      exit 1
      ;;
  esac
fi
