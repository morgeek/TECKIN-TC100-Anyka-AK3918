#!/bin/sh
SERVICE_NAME="Telnet Server"
PIDFILE="/var/run/telnet-server.pid"
CONFIGPATH="/mnt/config"
export LD_LIBRARY_PATH='/mnt/lib/:/thirdlib:/system/lib/:/usr/lib/'
PATH=/mnt/bin:/system/bin:/bin:/sbin:/usr/bin:/usr/sbin

. /mnt/scripts/common_functions.sh

install_config $CONFIGPATH/telnetd.conf
. $CONFIGPATH/telnetd.conf


status()
{
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  # Running = telnetd alive AND the port listens (see ftp-server).
  if kill -0 "$pid" 2>/dev/null && grep -q telnetd "/proc/$pid/cmdline" 2>/dev/null && port_listening "$TELNET_PORT"; then
    echo "PID: $pid"
    return 0
  fi
  rm -f "$PIDFILE"
  return 1
}

start()
{
  _security="$(read_kv_config_value /mnt/config/boot.conf SECURITY_HARDENING_MODE 0)"
  case "$_security" in 1|true|yes|on|enabled)
    echo "Service disabled by security hardening" >&2
    return 1 ;;
  esac
  if [ "$(status)" != "" ]; then
    echo "A telnet server is already running, please stop it or reboot"
  else
    # LAN only (netacl_exec), closed again after REMOTE_SHELL_TIMEOUT_MIN.
    ( netacl_exec telnet telnetd -p$TELNET_PORT )
    service_autoclose telnet-server
    sleep 1
    PID=$(ps | grep "[t]elnetd -p$TELNET_PORT" | awk 'NR==1 {print $1}')
    echo "$PID" > "$PIDFILE"
  fi
}

stop()
{
  killpid_graceful "$PIDFILE" 3
  [ -s /var/run/telnet-server.autoclose ] && kill "$(cat /var/run/telnet-server.autoclose)" 2>/dev/null
  rm -f /var/run/telnet-server.autoclose
}

health()
{
  if [ -n "$(status)" ]; then echo "ok: running"; else echo "warn: stopped"; fi
}

if [ $# -eq 0 ]; then
  start
else
  case $1 in start|stop|status|health)
    $1
    ;;
  esac
fi
