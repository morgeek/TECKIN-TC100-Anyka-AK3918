#!/bin/sh
SERVICE_NAME="Timelapse"
PIDFILE='/var/run/timelapse.pid'

. /mnt/scripts/common_functions.sh
. /mnt/scripts/update_timezone.sh

status()
{
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1; then
    echo "PID: $pid"
    return 0
  fi
  return 1
}

start()
{
  if status >/dev/null 2>&1; then
    echo "Timelapse already running"
    return 0
  fi

  rm -f "$PIDFILE" >/dev/null 2>&1 || true
  echo "Starting timelapse"
  /mnt/bin/busybox nohup /mnt/scripts/timelapse.sh >/dev/null 2>&1 &
  echo "$!" > "$PIDFILE"
}

stop()
{
  killpid_graceful "$PIDFILE" 5
}

health()
{
  if [ -n "$(status)" ]; then echo "ok: running"; else echo "warn: stopped"; fi
}

if [ $# -eq 0 ]; then
  start
else
  case "$1" in start|stop|status|health)
    "$1"
    ;;
  esac
fi
