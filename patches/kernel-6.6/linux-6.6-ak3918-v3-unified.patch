diff --git a/arch/arm/mach-anyka/anyka.c b/arch/arm/mach-anyka/anyka.c
new file mode 100644
index 000000000..de68cce9f
--- /dev/null
+++ b/arch/arm/mach-anyka/anyka.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Anyka AK3918EV300 device tree board support.
+ */
+#include <linux/io.h>
+#include <linux/reboot.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/minmax.h>
+#include <asm/mach/arch.h>
+
+#define AK39_SYSCTRL		0x08000000
+#define AK39_WDT_CFG1		0xe4
+#define AK39_WDT_CFG2		0xe8
+
+/*
+ * Restart through the "top" watchdog, as the vendor kernel does: a very
+ * short timeout (2 ticks), enable, then start/feed.
+ */
+static void anyka_restart(enum reboot_mode mode, const char *cmd)
+{
+	void __iomem *sys = ioremap(AK39_SYSCTRL, 0x100);
+
+	if (!sys)
+		return;
+	writel((0x55 << 24) | 2, sys + AK39_WDT_CFG1);
+	writel((0xaa << 24) | 1, sys + AK39_WDT_CFG2);
+	writel((0xaa << 24) | 3, sys + AK39_WDT_CFG2);
+	mdelay(1000);
+}
+
+/*
+ * Test safety net: "ak_wdt_reboot=<seconds>" on the command line arms the
+ * top watchdog once and never feeds it, so a test kernel that hangs (or
+ * loses its console) is back in the boot loader after that many seconds.
+ * One tick is 21.333 us (46875 per second); the counter is 24 bits (<= 357 s).
+ */
+static unsigned int ak_wdt_reboot;
+static int __init ak_wdt_reboot_setup(char *str)
+{
+	return kstrtouint(str, 0, &ak_wdt_reboot) == 0;
+}
+__setup("ak_wdt_reboot=", ak_wdt_reboot_setup);
+
+static int __init ak_wdt_reboot_arm(void)
+{
+	void __iomem *sys;
+	unsigned int ticks;
+
+	if (!ak_wdt_reboot)
+		return 0;
+	sys = ioremap(AK39_SYSCTRL, 0x100);
+	if (!sys)
+		return 0;
+	ticks = min(ak_wdt_reboot, 357u) * 46875;
+	writel((0x55 << 24) | ticks, sys + AK39_WDT_CFG1);
+	writel((0xaa << 24) | 1, sys + AK39_WDT_CFG2);
+	writel((0xaa << 24) | 3, sys + AK39_WDT_CFG2);
+	pr_warn("anyka: watchdog armed, reboot in %u s (ak_wdt_reboot)\n",
+		min(ak_wdt_reboot, 357u));
+	iounmap(sys);
+	return 0;
+}
+late_initcall(ak_wdt_reboot_arm);
+
+/*
+ * Core PLL. The boot loader leaves it at 400 MHz (SYSCTRL 0x08 =
+ * 0x010213c8: vclk 200, ASIC 100 MHz), too slow for the ISP at 1080p: the
+ * 4.4 kernel ran it at 640 MHz (0x010203a0: vclk 320, ASIC 160 MHz) and the
+ * stock 3.4 kernel at 480. Same write sequence as the stock aisc_freq_set():
+ * the value with bit 23 (load), then CPU PLL control bit 28 (apply). UART0's
+ * divisor follows the ASIC clock, so it is reprogrammed at once.
+ */
+#define AK39_CORE_PLL		0x08
+#define AK39_CPU_PLL		0x04
+#define AK39_CORE_PLL_640	0x010203a0
+#define AK39_ASIC_HZ		160000000
+#define AK39_UART0		0x20130000
+
+static int __init anyka_core_pll(void)
+{
+	void __iomem *sys = ioremap(AK39_SYSCTRL, 0x100);
+	void __iomem *uart = ioremap(AK39_UART0, 0x10);
+	u32 div = AK39_ASIC_HZ / 115200 - 1, v;
+	unsigned long flags;
+
+	if (!sys || !uart)
+		return 0;
+	if ((readl(sys + AK39_CORE_PLL) & 0x3fff) != (AK39_CORE_PLL_640 & 0x3fff)) {
+		local_irq_save(flags);
+		writel(AK39_CORE_PLL_640 | BIT(23), sys + AK39_CORE_PLL);
+		writel(readl(sys + AK39_CPU_PLL) | BIT(28), sys + AK39_CPU_PLL);
+		udelay(100);
+		v = readl(uart) & ~(0xffff | BIT(22));
+		v |= div | BIT(28) | BIT(29);
+		if (AK39_ASIC_HZ % 115200)
+			v |= BIT(22);
+		writel(v, uart);
+		local_irq_restore(flags);
+		pr_info("anyka: core PLL 640 MHz (ASIC 160 MHz), SYSCTRL 0x08 = %08x\n",
+			readl(sys + AK39_CORE_PLL));
+	}
+	iounmap(uart);
+	iounmap(sys);
+	return 0;
+}
+early_initcall(anyka_core_pll);
+
+static const char * const anyka_dt_compat[] __initconst = {
+	"anyka,ak3918ev300",
+	NULL
+};
+
+DT_MACHINE_START(ANYKA_DT, "Anyka AK3918EV300")
+	.dt_compat	= anyka_dt_compat,
+	.restart	= anyka_restart,
+MACHINE_END
