+void isp2_module_fini(void)
+{
+	ak_isp_vi_stop_capturing();
+	isp->cb.cb_msleep(500);
+	SET_BITS(REG32(ak_sysctrl_base + 0x1C), 19, 1);//disable isp clock (6.6: mapped SYSCTRL)
+    isp->cb.cb_dmafree(isp->area, isp->bytes, isp->handle);    
+    isp->cb.cb_free(isp);
+    isp = NULL;
+}
