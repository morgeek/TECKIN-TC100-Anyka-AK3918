#!/bin/sh
#
# Starts dropbear sshd (replaces the Buildroot S50dropbear in the initramfs: the program is not in the RAM image any
# more, it comes with the user space, ext/bin/dropbear).
#   Flash mode: /mnt/ext is the user space squashfs (S39tc100 has mounted it before this script runs).
#   SD mode:    /mnt is the card only once autorun-linux66.sh has mounted it, which races with this script: the card is
#               already at /mnt/sd (S39tc100, step 1) and carries the same tree.
# On by default; the Services page toggle "Boot" (config/autostart/ssh-server) turns it off. A camera that never made that
# choice keeps ssh (no lock-out after an upgrade): the choice exists once config/.services_ssh_done does (autorun-linux66.sh
# writes it at the first boot of this version). The config is read where the settings are at this point of the boot:
# /mnt/config in flash mode (flashmode-prep.sh has run), the card (/mnt/sd/config) in SD mode.
# Without dropbear (a user space older than the initramfs) the camera stays reachable by the busybox telnetd of
# S50telnet (v3/S50telnet-linux66), with the same root password; a line on the console says so.

DB=
for p in /mnt/ext/bin/dropbear /mnt/sd/ext/bin/dropbear; do
	[ -x $p ] && { DB=$p; break; }
done

# Allow a few customizations from a config file
test -r /etc/default/dropbear && . /etc/default/dropbear

start() {
	CFG=/mnt/sd/config; [ -f /tmp/flashmode ] && CFG=/mnt/config
	if [ ! -e $CFG/autostart/ssh-server ] && [ -e $CFG/.services_ssh_done ]; then
		echo "Starting dropbear sshd: off (Services page)"
		return 0
	fi
	if [ -z "$DB" ]; then
		echo "[tc100] dropbear is not in the user space (ext/bin): no ssh, telnetd is the way in" > /dev/console
		echo "Starting dropbear sshd: SKIP"
		return 0
	fi
	DROPBEAR_ARGS="$DROPBEAR_ARGS -R"

	# /etc/dropbear is a symlink to /var/run/dropbear (RAM): restore persistent host key and authorized_keys from config/
	if [ -L /etc/dropbear ] && [ "$(readlink /etc/dropbear)" = "/var/run/dropbear" ]; then
		if rm -f /etc/dropbear >/dev/null 2>&1; then
			mkdir -p /etc/dropbear
		else
			mkdir -p "$(readlink /etc/dropbear)"
		fi
	fi
	if [ -s "$CFG/dropbear_ed25519_host_key" ]; then
		cp "$CFG/dropbear_ed25519_host_key" /etc/dropbear/dropbear_ed25519_host_key 2>/dev/null
		chmod 600 /etc/dropbear/dropbear_ed25519_host_key 2>/dev/null
	elif [ ! -s /etc/dropbear/dropbear_ed25519_host_key ] && [ -x "${DB%/*}/dropbearkey" ]; then
		"${DB%/*}/dropbearkey" -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
		chmod 600 /etc/dropbear/dropbear_ed25519_host_key 2>/dev/null
		if [ -s /etc/dropbear/dropbear_ed25519_host_key ] && [ -d "$CFG" ]; then
			cp /etc/dropbear/dropbear_ed25519_host_key "$CFG/dropbear_ed25519_host_key" 2>/dev/null
			chmod 600 "$CFG/dropbear_ed25519_host_key" 2>/dev/null
		fi
	fi
	if [ -s "$CFG/authorized_keys" ]; then
		mkdir -p /root/.ssh 2>/dev/null
		chmod 700 /root/.ssh 2>/dev/null
		cp "$CFG/authorized_keys" /root/.ssh/authorized_keys 2>/dev/null
		chmod 600 /root/.ssh/authorized_keys "$CFG/authorized_keys" 2>/dev/null
	elif [ -s /root/.ssh/authorized_keys ] && [ -d "$CFG" ]; then
		cp /root/.ssh/authorized_keys "$CFG/authorized_keys" 2>/dev/null
		chmod 600 "$CFG/authorized_keys" 2>/dev/null
	fi

	# Ensure devpts pseudo-terminal filesystem is mounted for interactive SSH sessions
	if [ ! -d /dev/pts ] || ! grep -q ' /dev/pts devpts ' /proc/mounts 2>/dev/null; then
		mkdir -p /dev/pts 2>/dev/null
		mount -t devpts devpts /dev/pts -o mode=620,ptmxmode=666 2>/dev/null || true
	fi

	printf "Starting dropbear sshd: "
	(
		umask 022
		# LAN only like web, telnet and ftp (boot.conf NET_LAN_ONLY / NET_ALLOW_EXTRA): libnetacl-musl.so is preloaded
		# into dropbear itself (netacl_exec: its loader is musl; start-stop-daemon would not carry the variable, the
		# library drops it from the environment once loaded). dropbear forks into the background by itself (no -F)
		# and writes the pid file. The filter is IPv4 only, the 3.0 kernel has no IPv6. 127/8, the rescue AP
		# (10.42.0.0/24) and every private network are in the list. Without the library or the scripts (SD test
		# mode, a user space older than this script) ssh starts unfiltered and says so: ssh is never lost.
		if [ -s /var/run/dropbear.pid ] && kill -0 "$(cat /var/run/dropbear.pid)" 2>/dev/null; then
			:
		elif CF=/mnt/scripts/common_functions.sh; [ -f $CF ] || CF=/mnt/sd/scripts/common_functions.sh
		     [ -f $CF ] && . $CF && type netacl_exec >/dev/null 2>&1; then
			# SD mode: /mnt is not the stack yet, the settings and the library are on the card
			[ -f /tmp/flashmode ] || { NETACL_CONF=$CFG/boot.conf; NETACL_LIBDIR=/mnt/sd/lib; export NETACL_CONF NETACL_LIBDIR; }
			netacl_exec ssh "$DB" $DROPBEAR_ARGS -P /var/run/dropbear.pid
		else
			echo "[tc100] ssh: no LAN filter available (no common_functions.sh), dropbear starts unfiltered" > /dev/console
			start-stop-daemon -S -q -p /var/run/dropbear.pid \
				--exec $DB -- $DROPBEAR_ARGS -P /var/run/dropbear.pid
		fi
	)
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}
stop() {
	printf "Stopping dropbear sshd: "
	start-stop-daemon -K -q -p /var/run/dropbear.pid
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	stop
	start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
