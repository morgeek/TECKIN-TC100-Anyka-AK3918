#!/bin/sh
# sound-detection daemon for Anyka AK3918
# Publishes a "sound" event (MQTT, optional recording trigger) when the
# microphone level reaches THRESHOLD_DB.
#
# The level comes from libtc100fix.so inside v4l2rtspserver (rtsp-h26x sets
# TC100FIX_SOUND_LEVEL=/var/run/sound_level when ENABLE=1): it measures every
# second of the PCM the vendor audio encoder reads and counts the seconds at
# or above the threshold, so polling every INTERVAL seconds misses nothing.
# The previous implementation read /dev/voice or /dev/dsp, which do not exist
# on the AK3918 (the microphone is /dev/akpcm_cdev0 behind ak_ai), and then
# fell back to a "shim mode" that reported a level above the threshold.

. /mnt/scripts/common_functions.sh

CONFIG_FILE="/mnt/config/sound_detection.conf"
PID_FILE="/var/run/sound-detection.pid"
# RAM only: every event is also published over MQTT; nothing here needs to
# survive a reboot, and one SD write per event wore the card for nothing.
LOG_FILE="/tmp/log/sound-detection.log"
STATE_FILE="/tmp/sound-detection.state"

LOG_MAX_BYTES="${LOG_MAX_BYTES:-32768}"
LOG_BACKUPS="${LOG_BACKUPS:-1}"
EVENT_COOLDOWN_SECONDS="${EVENT_COOLDOWN_SECONDS:-10}"
MIN_INTERVAL_SECONDS="${MIN_INTERVAL_SECONDS:-2}"

sanitize_positive_int()
{
    raw="$1"
    fallback="$2"
    case "$raw" in
        ''|*[!0-9]*)
            echo "$fallback"
            ;;
        *)
            echo "$raw"
            ;;
    esac
}

clamp_int()
{
    value="$(sanitize_positive_int "$1" "$2")"
    min="$2"
    max="$3"
    if [ "$value" -lt "$min" ]; then
        value="$min"
    fi
    if [ "$value" -gt "$max" ]; then
        value="$max"
    fi
    echo "$value"
}

rotate_log_if_needed()
{
    max_bytes="$(sanitize_positive_int "$LOG_MAX_BYTES" 32768)"
    backups="$(clamp_int "$LOG_BACKUPS" 0 3)"
    [ -f "$LOG_FILE" ] || return 0

    log_size="$(wc -c < "$LOG_FILE" 2>/dev/null)"
    log_size="$(sanitize_positive_int "$log_size" 0)"
    if [ "$log_size" -lt "$max_bytes" ]; then
        return 0
    fi

    if [ "$backups" -gt 0 ]; then
        idx="$backups"
        while [ "$idx" -gt 1 ]; do
            prev=$((idx - 1))
            if [ -f "${LOG_FILE}.${prev}" ]; then
                mv "${LOG_FILE}.${prev}" "${LOG_FILE}.${idx}" 2>/dev/null || true
            fi
            idx=$((idx - 1))
        done
        mv "$LOG_FILE" "${LOG_FILE}.1" 2>/dev/null || : > "$LOG_FILE"
    else
        : > "$LOG_FILE"
    fi
}

log_msg()
{
    mkdir -p "$(dirname "$LOG_FILE")" >/dev/null 2>&1 || true
    rotate_log_if_needed
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" "$1" >> "$LOG_FILE"
}

LEVEL_FILE="${SOUND_LEVEL_FILE:-/var/run/sound_level}"

# Ensure we have a default config
if [ ! -f "$CONFIG_FILE" ]; then
    echo "ENABLE=0" > "$CONFIG_FILE"
    echo "THRESHOLD_DB=-24" >> "$CONFIG_FILE"
    echo "INTERVAL=2" >> "$CONFIG_FILE"
fi

# threshold_db -> THRESHOLD_DB clamped to -90..0 (dBFS), default -24.
threshold_db()
{
    _td="$(read_kv_config_value "$CONFIG_FILE" THRESHOLD_DB -24)"
    case "$_td" in -[0-9]|-[0-9][0-9]|0) ;; *) _td=-24 ;; esac
    [ "$_td" -lt -90 ] && _td=-90
    echo "$_td"
}

publish_sound_event()
{
    level="$1"
    threshold="$2"
    now_ts="${3:-$(date +%s 2>/dev/null)}"
    [ -n "$now_ts" ] || now_ts=0

    # Publish to MQTT via shared function. level / threshold are dBFS.
    publish_mqtt_event "{\"type\":\"sound\",\"ts\":$now_ts,\"level_db\":$level,\"threshold_db\":$threshold}"

    # Trigger recording if enabled.
    if [ "$(read_kv_config_value /mnt/config/recording.conf rec_motion_activated 0)" = "1" ]; then
        touch /tmp/motion_detected
    fi
}

# read_meter -> sets m_ts m_rms m_peak m_events m_last_ts m_last_db; 1 if no
# fresh reading (meter not running: RTSP server down or started without it).
# "Fresh" = the meter's timestamp changed within the last 10 s of uptime: no
# date(1) call, this runs every INTERVAL seconds.
read_meter()
{
    m_ts=""
    [ -r "$LEVEL_FILE" ] && read -r m_ts m_rms m_peak m_events m_last_ts m_last_db _m < "$LEVEL_FILE"
    case "$m_ts" in ''|*[!0-9]*) return 1 ;; esac
    read -r _rm_up _rm_rest < /proc/uptime
    _rm_up="${_rm_up%.*}"
    if [ "$m_ts" != "${rm_last_ts:-}" ]; then
        rm_last_ts="$m_ts"; rm_last_change="$_rm_up"
    fi
    [ $((_rm_up - ${rm_last_change:-0})) -le 10 ]
}

# sd_wait <seconds>: sleep without starting a process (read with a timeout
# on a FIFO nobody writes to); sleep(1) if the FIFO cannot be made.
SD_FIFO="${SD_FIFO:-/tmp/sound-detection.fifo}"
sd_wait()
{
    [ -p "$SD_FIFO" ] || mkfifo "$SD_FIFO" 2>/dev/null
    if [ -p "$SD_FIFO" ]; then
        # BusyBox ash returns 1 on the timeout; anything else (a shell without
        # read -t, data on the FIFO) falls back to sleep, never a busy loop.
        read -t "$1" _sd_nothing <> "$SD_FIFO" 2>/dev/null
        [ $? -eq 1 ] || sleep "$1"
    else
        sleep "$1"
    fi
}

# load_config -> enable threshold interval min_loud, read in one pass without
# a subshell; only when the file changed since the last load (shell -nt test).
SD_STAMP="${SD_STAMP:-/tmp/sound-detection.loaded}"
load_config()
{
    [ -n "${enable:-}" ] && [ -f "$SD_STAMP" ] && ! [ "$CONFIG_FILE" -nt "$SD_STAMP" ] && return 0
    enable=0; threshold=-24; interval=2; min_loud=1
    if [ -r "$CONFIG_FILE" ]; then
        while IFS='=' read -r _lc_k _lc_v; do
            case "$_lc_k" in
                ENABLE) enable="$_lc_v" ;;
                THRESHOLD_DB) threshold="$_lc_v" ;;
                INTERVAL) interval="$_lc_v" ;;
                MIN_LOUD_SECONDS) min_loud="$_lc_v" ;;
            esac
        done < "$CONFIG_FILE"
    fi
    case "$threshold" in -[0-9]|-[0-9][0-9]|0) ;; *) threshold=-24 ;; esac
    [ "$threshold" -lt -90 ] && threshold=-90
    case "$interval" in ''|*[!0-9]*) interval=2 ;; esac
    [ "$interval" -lt 1 ] && interval=1; [ "$interval" -gt 300 ] && interval=300
    case "$min_loud" in ''|*[!0-9]*) min_loud=1 ;; esac
    [ "$min_loud" -lt 1 ] && min_loud=1; [ "$min_loud" -gt 10 ] && min_loud=10
    : > "$SD_STAMP"
}

run_daemon()
{
    last_events=""
    last_threshold=""
    last_publish=0
    streak=0
    warned=0
    cooldown_seconds="$(clamp_int "$EVENT_COOLDOWN_SECONDS" 0 300)"

    enable=""
    rm -f "$SD_STAMP"
    while :; do
        load_config
        if [ "$enable" != "1" ]; then
            # Disabled: poll the config only occasionally.
            sd_wait 300
            continue
        fi

        # Tell the meter when it changes (it re-reads this file every 10 s).
        if [ "$threshold" != "$last_threshold" ] || [ ! -f "$LEVEL_FILE.threshold" ]; then
            echo "$threshold" > "$LEVEL_FILE.threshold" 2>/dev/null
            last_threshold="$threshold"
        fi

        if read_meter; then
            warned=0
            printf '%s %s %s\n' "$m_rms" "$m_peak" "$m_ts" > "$STATE_FILE"
            if [ -z "$last_events" ]; then
                last_events="$m_events"           # do not replay past events
            elif [ "$m_events" != "$last_events" ]; then
                # The meter counts loud seconds; a run of checks that each saw
                # some is one burst. Publish once it lasted MIN_LOUD_SECONDS.
                _delta=$((m_events - last_events))
                [ "$_delta" -gt 0 ] || _delta=1
                last_events="$m_events"
                streak=$((streak + _delta))
                if [ "$streak" -ge "$min_loud" ] && \
                   { [ "$cooldown_seconds" -eq 0 ] || [ $((m_last_ts - last_publish)) -ge "$cooldown_seconds" ]; }; then
                    log_msg "Triggered level=${m_last_db}dBFS threshold=${threshold}dBFS loud=${streak}s"
                    publish_sound_event "$m_last_db" "$threshold" "$m_last_ts"
                    last_publish="$m_last_ts"
                fi
            else
                streak=0
            fi
        else
            printf '%s\n' "none" > "$STATE_FILE"
            if [ "$warned" = 0 ]; then
                log_msg "No sound level from the RTSP server (is rtsp-h26x running, restarted since sound detection was enabled?)"
                warned=1
            fi
            last_events=""
        fi

        sd_wait "$interval"
    done
}

start()
{
    if status >/dev/null 2>&1; then
        pid="$(cat "$PID_FILE" 2>/dev/null)"
        echo "Already running ($pid)"
        return 0
    fi

    rm -f "$PID_FILE" >/dev/null 2>&1 || true
    echo "Starting sound detection daemon..."
    run_daemon >/dev/null 2>&1 &
    echo "$!" > "$PID_FILE"
}

stop()
{
    killpid_graceful "$PID_FILE" 5
    echo "Stopped"
}

status()
{
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "Running (PID: $pid)"
        if [ -f "$STATE_FILE" ]; then
            read -r last_level last_peak _ < "$STATE_FILE"
            if [ "$last_level" = none ]; then
                echo "Level: no reading (restart rtsp-h26x after enabling)"
            else
                echo "Level: ${last_level:-?} dBFS (peak ${last_peak:-?}), threshold $(threshold_db) dBFS"
            fi
        fi
        return 0
    fi

    rm -f "$PID_FILE" >/dev/null 2>&1 || true
    echo "Stopped"
    return 1
}

health()
{
    if status >/dev/null 2>&1; then echo "ok: running"; else echo "warn: stopped"; fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    health) health ;;
    *) echo "Usage: $0 {start|stop|status|restart|health}"; exit 1 ;;
esac
