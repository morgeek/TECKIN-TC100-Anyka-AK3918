+
+    //pp_reg_51
+    cmd = 0;
+    cmd = (LOW_BITS(isp->ch2_width, PP_DST_BITS) << PP_DST2_WIDTH)
+    	| (LOW_BITS(isp->ch2_height, PP_DST_BITS) << pp_DST2_HEIGHT);
+    isp->reg_blkaddr4[R4_SUB_SCALE + 1] = cmd;
