{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node tools/build-web-assets.mjs*)",
      "Bash(node .claude/hooks/*.mjs)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(ping -n * 192.168.1.*)",
      "Bash(curl --max-time * -s --ftp-create-dirs -T * ftp://root:pass@192.168.1.*)",
      "Bash(curl --max-time * -s ftp://root:pass@192.168.1.*)",
      "Bash(curl -s http://192.168.1.*/cgi-bin/*)",
      "Bash(curl -sk https://192.168.1.*/cgi-bin/*)"
    ],
    "additionalDirectories": [
      "C:\\tmp"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/build-frontend.mjs"
          }
        ]
      }
    ]
  }
}
