#!/bin/sh
SERVICE_NAME="Auto Night Detection"
PIDFILE="/var/run/auto-night-detection.pid"

# Linux 6.6 (3.0): scripts/auto-night-daemon.sh (or tc100-supervisord when SUPERVISOR_IMPL=c) switches day/night
# from the picture luminance that tc100_rtsp writes to /tmp/cam_luma.
# SUPERVISOR_IMPL=c (config/boot.conf): the loop runs as a job of tc100-supervisord (scripts/supervisor.sh), which keeps
# the pid of the daemon in PIDFILE; any failure there starts the shell loop below as before
[ -f /mnt/scripts/supervisor.sh ] && . /mnt/scripts/supervisor.sh

daemon_pid()
{
  _p="$(cat "$PIDFILE" 2>/dev/null)"
  [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null && echo "$_p"
}

status()
{
  _p="$(daemon_pid)" && echo "PID: $_p"
}

start()
{
  /mnt/bin/rwconf /mnt/config/rtspserver.conf w " " daynight 2 2>/dev/null
  if [ -z "$(daemon_pid)" ]; then
    if type sv_start >/dev/null 2>&1 && sv_start night "$PIDFILE" auto-night-detection; then
      :
    else
      /bin/sh /mnt/scripts/auto-night-daemon.sh </dev/null >/dev/null 2>&1 &
      echo "$!" > "$PIDFILE"
    fi
  fi
  return 0
}

stop()
{
  if type sv_stop >/dev/null 2>&1 && [ -e "${SV_RUN:-/var/run}/tc100-sv.night" ]; then
    sv_stop night "$PIDFILE" auto-night-detection   # a job of the shared daemon: switch it off, never kill the daemon
  else
    _p="$(daemon_pid)" && kill "$_p" 2>/dev/null
  fi
  rm -f "$PIDFILE"
  # daynight=3 = the user chose Day or Night by hand: persistent, the next boot does not start the switching.
  # halt (DN_KEEP_MODE=1) stops the job and leaves the setting alone: an update or an install stops the services
  # and the camera restarts in automatic mode (rc29, 2026-11-06: since the rc28 ships rwconf, the update's stop
  # wrote daynight=3 and both cameras came back in manual mode, "auto day/night not started").
  [ -n "$DN_KEEP_MODE" ] || /mnt/bin/rwconf /mnt/config/rtspserver.conf w " " daynight 3 2>/dev/null
  return 0
}

health()
{
  if [ -n "$(status)" ]; then echo "ok: running"; return; fi
  # stopped on purpose: a manual Day / Night choice (daynight=3) is not a fault, but say so (R9-02)
  if grep -q '^daynight=3' /mnt/config/rtspserver.conf 2>/dev/null; then
    echo "ok: manual day/night mode (daynight=3), automatic switching off"
  else
    echo "warn: stopped"
  fi
}

# restart = stop then start: service-watchdog, memory-guard, the MQTT bridge, the config import and the Settings
# pages call it (it was missing here: the call did nothing, rc27 tester R5)
restart() { stop; start; }
# halt: stop without writing the manual mode (update, install, a low-memory stop before an upload)
halt() { DN_KEEP_MODE=1 stop; }

if [ $# -eq 0 ]; then
  start
else
  case $1 in start|stop|status|health|restart|halt)
    $1
    ;;
  esac
fi
