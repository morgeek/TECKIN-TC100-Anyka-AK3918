diff --git a/arch/arm/mach-anyka/anyka.c b/arch/arm/mach-anyka/anyka.c
index 3ee7037db..fa911f996 100644
--- a/arch/arm/mach-anyka/anyka.c
+++ b/arch/arm/mach-anyka/anyka.c
@@ -2,8 +2,68 @@
 /*
  * Anyka AK3918EV300 device tree board support.
  */
+#include <linux/io.h>
+#include <linux/reboot.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/minmax.h>
 #include <asm/mach/arch.h>
 
+#define AK39_SYSCTRL		0x08000000
+#define AK39_WDT_CFG1		0xe4
+#define AK39_WDT_CFG2		0xe8
+
+/*
+ * Restart through the "top" watchdog, as the vendor kernel does: a very
+ * short timeout (2 ticks), enable, then start/feed.
+ */
+static void anyka_restart(enum reboot_mode mode, const char *cmd)
+{
+	void __iomem *sys = ioremap(AK39_SYSCTRL, 0x100);
+
+	if (!sys)
+		return;
+	writel((0x55 << 24) | 2, sys + AK39_WDT_CFG1);
+	writel((0xaa << 24) | 1, sys + AK39_WDT_CFG2);
+	writel((0xaa << 24) | 3, sys + AK39_WDT_CFG2);
+	mdelay(1000);
+}
+
+/*
+ * Test safety net: "ak_wdt_reboot=<seconds>" on the command line arms the
+ * top watchdog once and never feeds it, so a test kernel that hangs (or
+ * loses its console) is back in the boot loader after that many seconds.
+ * One tick is 21.333 us (46875 per second); the counter is 24 bits (<= 357 s).
+ */
+static unsigned int ak_wdt_reboot;
+static int __init ak_wdt_reboot_setup(char *str)
+{
+	return kstrtouint(str, 0, &ak_wdt_reboot) == 0;
+}
+__setup("ak_wdt_reboot=", ak_wdt_reboot_setup);
+
+static int __init ak_wdt_reboot_arm(void)
+{
+	void __iomem *sys;
+	unsigned int ticks;
+
+	if (!ak_wdt_reboot)
+		return 0;
+	sys = ioremap(AK39_SYSCTRL, 0x100);
+	if (!sys)
+		return 0;
+	ticks = min(ak_wdt_reboot, 357u) * 46875;
+	writel((0x55 << 24) | ticks, sys + AK39_WDT_CFG1);
+	writel((0xaa << 24) | 1, sys + AK39_WDT_CFG2);
+	writel((0xaa << 24) | 3, sys + AK39_WDT_CFG2);
+	pr_warn("anyka: watchdog armed, reboot in %u s (ak_wdt_reboot)\n",
+		min(ak_wdt_reboot, 357u));
+	iounmap(sys);
+	return 0;
+}
+late_initcall(ak_wdt_reboot_arm);
+
 static const char * const anyka_dt_compat[] __initconst = {
 	"anyka,ak3918ev300",
 	NULL
@@ -11,4 +71,5 @@ static const char * const anyka_dt_compat[] __initconst = {
 
 DT_MACHINE_START(ANYKA_DT, "Anyka AK3918EV300")
 	.dt_compat	= anyka_dt_compat,
+	.restart	= anyka_restart,
 MACHINE_END
