+static struct platform_device snd_akpcm_device = {
+	.name	= SND_AKPCM_DRIVER,
+	.id	= 0,
+	.dev	= {
+		.dma_mask	   = &snd_akpcm_dma_mask,
+		.coherent_dma_mask = DMA_BIT_MASK(32),
