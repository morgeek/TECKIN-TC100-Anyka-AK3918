+	pr_debug("  rL2_CONBUF0_7(C088) = 0x%08X, rL2_CONBUF8_15(C08C) = 0x%0X\n",__raw_readl(rL2_CONBUF0_7), __raw_readl(rL2_CONBUF8_15));
+	pr_debug("  rL2_BUFASSIGN1(C090)    = 0x%08X, rL2_BUFINTEN(C09C)  = 0x%0X\n",__raw_readl(rL2_BUFASSIGN1), __raw_readl(rL2_BUFINTEN));
+	pr_debug("  rL2_BUFSTAT1(C0A0)      = 0x%08X, rL2_BUFSTAT2(C0A8)    = 0x%0X\n",__raw_readl(rL2_BUFSTAT1), __raw_readl(rL2_BUFSTAT2));
+	pr_debug("ANYKA L2 Register Dumping End.\n");
+}
