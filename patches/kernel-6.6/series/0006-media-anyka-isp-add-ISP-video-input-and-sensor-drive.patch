+int  isp2_module_init(AK_ISP_FUNC_CB *cb, AK_ISP_SENSOR_CB *sensor_cb, void *reg_base)
+{
+    if (!cb || !cb->cb_malloc || !cb->cb_free || !cb->cb_printk || !sensor_cb)
+        return -EINVAL;
