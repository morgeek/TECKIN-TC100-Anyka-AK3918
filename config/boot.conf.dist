# Boot-time performance settings
# Set to 1 to enable lightweight defaults (lower CPU/RAM).
LIGHTWEIGHT_MODE=0

# Network guard (scripts/net-guard.sh, checked every minute by web-guard.sh):
# reboot when the default gateway has not answered for NET_GUARD_MIN minutes
# while the rest of the system runs (the hardware watchdog does not catch
# that). After such a reboot the next limit doubles, up to 2 h, until the
# network has been back for 10 min. Never while the Wi-Fi rescue access point
# is up. NET_GUARD=0 turns it off.
NET_GUARD=1
NET_GUARD_MIN=15
# NET_GUARD_SOFT=1: before that reboot, soft repairs while wlan0 exists: 2 min without the
# gateway -> Wi-Fi reassociation, 5 min -> Wi-Fi settings applied again, 8 min -> the USB
# Wi-Fi chip probed again (each once per outage). 0 = only the reboot.
NET_GUARD_SOFT=0
ENABLE_NTP=1
# NTP blocked (UDP port 123 filtered): the clock is taken from the "Date:" header of
# an HTTP answer after 2 minutes (scripts/time-fallback.sh). TIME_HTTP_URLS: space-separated
# http:// addresses, "gateway" = the router's own page (default: nothing leaves the
# local network). TIME_HTTP_FALLBACK=0 turns it off.
TIME_HTTP_FALLBACK=1
TIME_HTTP_URLS=gateway
ENABLE_CROND=1

# Managed scheduled reboot cron task:
# Cron expression is: REBOOT_SCHEDULE_MINUTE REBOOT_SCHEDULE_HOUR * * REBOOT_SCHEDULE_WEEKDAY
# REBOOT_SCHEDULE_WEEKDAY supports: *, 0..6, 1-5, 0,6
REBOOT_SCHEDULE_ENABLE=0
REBOOT_SCHEDULE_MINUTE=0
REBOOT_SCHEDULE_HOUR=4
REBOOT_SCHEDULE_WEEKDAY=*

# Web server: busybox httpd behind httpfront, plain HTTP on port 80, one login (root and config/user.pwd).
# HTTPS is not served by the camera: put a reverse proxy on your network in front of it.

# Security hardening mode: FTP and telnet stay off and cannot be started from the web UI.
SECURITY_HARDENING_MODE=0
# Network access. The kernel has no packet filter, so the web server
# (httpfront), the RTSP server, telnet and FTP refuse connections themselves.
# ssh (dropbear) is not filtered: do not forward port 22 on the router.
#   NET_LAN_ONLY=1   only the private networks may connect (10/8, 172.16/12,
#                    192.168/16, link-local, 100.64/10 for Tailscale): a port
#                    forwarded by the router by mistake is refused at once.
#                    0 = anyone may connect (to the password prompt).
#   NET_ALLOW_EXTRA  more networks, space-separated a.b.c.d/n (a VPN, ...).
NET_LAN_ONLY=1
NET_ALLOW_EXTRA=
# WEB_LOCKOUT=1: 10 wrong web logins from one address within 5 minutes close its connections for
# 5 minutes (httpfront; the camera itself never). The kernel has no packet filter, so this is the
# web server's own. 0 = no limit.
WEB_LOCKOUT=0
# WIFI_AIM=1: for 5 minutes after boot the blue front LED blinks faster as the Wi-Fi signal gets
# better (about 4 a second at -50 dBm, one every 2 s at -85), to aim the camera without a screen.
WIFI_AIM=0
# mDNS (tc100-mdnsd always answers <name>.local). MDNS_SERVICES=1: also the DNS-SD services (_http._tcp port 80,
# _rtsp._tcp port 554 path /video0_unicast), so VLC, Home Assistant or a browser list the camera. MDNS_INFO=1: adds
# the firmware version, the load and the Wi-Fi level to them (anyone on the network can read them). Restart mdns.
MDNS_SERVICES=0
MDNS_INFO=0
# WebRTC live view (item 35, tc100-whep, off by default): WHEP=1 starts the gateway at boot and the live view of the
# web page tries WebRTC first (about 150 ms of delay), then falls back to the usual live view. WHEP_STREAM=sub (the
# 640x360 H.264 stream, light) or main (only when the main stream is H.264). WHEP_MAX=1..2 viewers at the same time.
# WHEP_AUDIO=1: the microphone (PCMA) goes with the picture. The certificate is made once in /mnt/config/whep-*.pem.
# Restart the whep service after a change (Services page). Needs the base image with mbedTLS DTLS-SRTP.
WHEP=0
WHEP_STREAM=sub
WHEP_MAX=2
WHEP_AUDIO=1
# WIFI_ROAM=1 (repeaters, mesh: one SSID, several access points): below -75 dBm for 2 minutes, the camera moves
# to an access point of the same network at least 15 dB stronger, if there is one (scripts/wifi-roam.sh).
WIFI_ROAM=0
# LOW_RAM_PROFILE: set by the performance profile (Settings, MQTT "profile"): 1 for low-cpu and rtsp-only. A
# marker kept with the profile's snapshot (restore); nothing else reads it. Do not edit by hand.
LOW_RAM_PROFILE=0
# BOOT_SOUND=0: no startup chime on the speaker when the camera is ready (1 = the chime, default).
BOOT_SOUND=1
# BOOT_SOUND_NAME: which clip (Settings -> Sounds): a built-in one (startup_complete, chime, ...) or one sent to the
# SD card (tc100-3/sounds/NAME.pcm, played first when both exist); the built-in chime if it is missing.
BOOT_SOUND_NAME=startup_complete
# BOOT_STEALTH=1 (a baby's room, a bedroom): no chime, no LED aiming blinks, LEDs off while the camera boots (the
# kernel lights the blue one for a few seconds before the settings can be read); FRONT_LED / RED_LED apply at the end.
BOOT_STEALTH=0
# Telnet and FTP send passwords in clear: started from the web page, they
# stop by themselves after REMOTE_SHELL_TIMEOUT_MIN minutes (0 = never).
REMOTE_SHELL_TIMEOUT_MIN=15

# Low CPU profile (recommended for very low usage)
# When enabled, the startup script applies conservative RTSP settings and
# can disable substream/audio/OSD/motion/jpeg. These options are only
# applied when LOW_CPU_PROFILE=1. To keep substream/audio, set the
# corresponding LOW_CPU_DISABLE_* value to 0.
LOW_CPU_PROFILE=0
LOW_CPU_DISABLE_SUBSTREAM=1
LOW_CPU_DISABLE_AUDIO=1
LOW_CPU_DISABLE_MOTION=1
LOW_CPU_DISABLE_OSD=1
LOW_CPU_DISABLE_JPEG=1

# -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Memory Guard & Service Watchdog
# -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
MEM_GUARD_ENABLE=0
MEM_GUARD_INTERVAL_SECONDS=60
# Thresholds on MemAvailable (the 64 MB camera sits near 10.8 MB in normal use): warn stops the light services of
# MEM_GUARD_SOFT_SERVICES; critical also stops those of MEM_GUARD_CRITICAL_SERVICES (motion detection among them) and
# drops the caches. Before 3.0.2 the defaults were 8192 / 4096, too close to the normal value; a camera holding
# exactly those is moved to the new ones when the service starts.
MEM_GUARD_WARN_KB=6144
MEM_GUARD_CRITICAL_KB=3072
MEM_GUARD_EMERGENCY_KB=2048
MEM_GUARD_COOLDOWN_SECONDS=120
MEM_GUARD_DROP_CACHES=0

# List of services to stop based on stage (soft, critical, emergency)
MEM_GUARD_SOFT_SERVICES=""
MEM_GUARD_CRITICAL_SERVICES="ftp-server telnet-server motion-detection"
MEM_GUARD_EMERGENCY_SERVICES=""

# Service Watchdog: RESTARTS hung or crashed services (requires MEM_GUARD_ENABLE=1)
MEM_WATCHDOG_ENABLE=1
MEM_WATCHDOG_INTERVAL_SECONDS=40
MEM_WATCHDOG_MAX_RETRIES=3
MEM_WATCHDOG_SERVICES="web-server rtsp-h26x onvif"

# RTSP stream toggles (1=enable, 0=disable), read by rtsp-launch.sh.
# Common topology presets:
# - Dual stream + audio: RTSP_SUBSTREAM=1, RTSP_AUDIO=1
# - Dual stream, audio off: RTSP_SUBSTREAM=1, RTSP_AUDIO=0
# - Main stream + audio: RTSP_SUBSTREAM=0, RTSP_AUDIO=1
# - Main stream only: RTSP_SUBSTREAM=0, RTSP_AUDIO=0
RTSP_SUBSTREAM=1
RTSP_AUDIO=1
# Lower frame rate while nothing moves (tc100_rtsp, read while it runs; Settings -> Streams & audio): IDLE_FPS frames
# per second once motion detection has seen no motion and no sound event for IDLE_AFTER seconds, the full rate again at
# the first one. 0 = off (default). Needs motion detection on; not applied while recording continuously.
IDLE_FPS=0
IDLE_AFTER=10
# IDLE_WHEN (item 31): still = while nothing moves (needs motion detection, default); unwatched = while no RTSP client
# plays and no browser shows the live view (the full rate as soon as one does: less heat, less work for nobody);
# night = in night mode. A motion or sound event gives the full rate in every case.
IDLE_WHEN=still
# Logs kept across reboots (scripts/log-persist.sh): dmesg, syslog and the service logs are copied to the SD card
# (/mnt/sd/logs/boot-NNNN, last 5 boots, about 2 MB each) every LOG_PERSIST_MIN minutes and before a deliberate
# reboot; only with a healthy card and the recording not paused. 0 = off.
LOG_PERSIST=1
LOG_PERSIST_MIN=10
# Safe mode (v3/linux66-sd/boot-guard, camera running from its flash): after 3 runs in a row that ended within
# 5 minutes (crash, watchdog, automatic reboot), the next start brings up only the Wi-Fi, the web interface, ssh and
# the reset button (no video, MQTT or optional services), so the camera stays reachable without a serial console.
# A restart once it has run 5 minutes is a normal one again. Reboots from the web page or the reset button do not
# count. The history: /mnt/config/log/reboot-history.log. 0 = off.
BOOT_GUARD=1
# SERIAL_CONSOLE=auto: the UART login prompt (115200 8N1) is there for 5 minutes at every boot; if nobody has a
# session on it by then, it stops and its memory is freed (v3/linux66-sd/console-timer). It stays on for good in
# safe mode (BOOT_GUARD) and when /tmp/console-keep exists. on = never stopped. Takes effect at the next start.
SERIAL_CONSOLE=auto
# Encoder smart mode (item 56.5) is not a boot.conf switch: it is the keys vbr=1 and smart=1 (1 = long-term reference,
# 2 = variable GOP, only with RTSP_SMART_FORCE=1 in rtsp.env) under [0] / [1] of rtspserver.conf (Video page), off when
# absent. Mode 1 needs the 12 MB encoder pool of the item 9 kernel: on the default 9600K pool tc100_rtsp logs
# "smart mode 1 not used" and runs as before.
# VM_TUNE=1: kernel memory settings for this 64 MB camera (vm.vfs_cache_pressure=150, vm.dirty_background_ratio=5,
# vm.dirty_ratio=10: cached file names are given back sooner, the card's writes start earlier in the background).
# No data is at risk. 0 = the kernel's defaults. Takes effect at the next start.
VM_TUNE=1
# Wi-Fi quality over time (scripts/wifi-quality.sh): one sample a minute of the signal, the transmit retries and
# failures and the packet loss to the router, kept 24 h in RAM (/tmp/wifi-quality.log, nothing written to flash or
# card); the last hour goes to MQTT (Wi-Fi loss, retries, weakest signal). 1 = on, 0 = off (default). Read at boot.
WIFI_QUALITY=0
# Wi-Fi rules of the country where the camera works (allowed channels, transmit power), as its law asks: the ISO 3166
# code (FR, BE, CH, DE, ES, IT, GB, US, CA, ...; scripts/wifi-country.sh). Empty = the "world" rules, the most
# restrictive (channels 12-13 passive, lower power). Used from the first association at boot; Settings -> Network
# applies a change at once, without reconnecting.
WIFI_COUNTRY=
# One resident loop for the slow periodic jobs (scripts/housekeeper.sh: web guard, network guard, SD panel, the RTSP and
# MQTT service watchdogs, health snapshot, log persistence) instead of one shell process each: about 1 MB less RAM.
# 0 = the separate daemons of before (read at boot).
HOUSEKEEPER=1
# SUPERVISOR_IMPL: who runs the always-on loops of the automatic day/night switching (scripts/auto-night-daemon.sh) and of
# the reset button (scripts/button-watch.sh). sh (default) = one resident busybox shell each. c = both as jobs of ONE
# small C process, tc100-supervisord (src/supervisord): same decisions, same config files (daynight.conf), same scripts
# called for the actual work (nightmode.sh, wifi-rescue.sh, reboot-tracker.sh), fewer resident shells. Without the binary
# the shell loops run; if the C daemon dies they take over until the next boot. Read when the services start (boot, or
# restart the two services on Settings -> Services).
SUPERVISOR_IMPL=sh
# HTTPFRONT_NATIVE=1: the web front (httpfront) answers the status line every page polls (GET /cgi-bin/statusline.cgi, same
# URL, same JSON) itself, without starting busybox httpd and sh for each request (about 20 times faster). Only for a
# request with the right login, from an allowed network; anything it cannot answer exactly (no csrf token file yet, an
# odd value in a status file) still goes to the CGI. 0 (default) = always the CGI. Read when httpfront starts (boot, or
# restart the web server).
HTTPFRONT_NATIVE=0
# ISP_TUNE=1: live image tuning from /mnt/config/isp_tune.conf (brightness,
# contrast, saturation, sharpness, hue, 50/60 Hz, exposure cap), applied by
# tc100_rtsp without restarting the stream.
ISP_TUNE=0
# Rescue Wi-Fi access point (scripts/wifi-rescue.sh): when the Wi-Fi link
# (association + gateway ping) stays down for WIFI_RESCUE_AFTER_MIN minutes,
# the camera opens a WPA2 access point (SSID WIFI_RESCUE_SSID, default
# TC100-<end of MAC>) with the web interface at http://10.42.0.1 to fix the
# Wi-Fi settings; it closes once the Wi-Fi is back and nobody uses it. Holding
# the reset button 3-7 s opens it for WIFI_RESCUE_MANUAL_MIN minutes.
# WIFI_RESCUE_PSK empty = default fixed password 'tc100rescue' (or custom in Settings).
# WIFI_RESCUE_CHANNEL applies when the camera
# is not associated (otherwise the access point follows the Wi-Fi).
# On by default (owner, 2026-11-03): the access point only opens while the
# Wi-Fi is not working. 0 = never, not even with the reset button.
WIFI_RESCUE=1
WIFI_RESCUE_AFTER_MIN=10
WIFI_RESCUE_MANUAL_MIN=15
WIFI_RESCUE_SSID=
WIFI_RESCUE_PSK=tc100rescue
WIFI_RESCUE_CHANNEL=6
# Local backup recording (REC_LOCAL=1), made by tc100_rtsp: the frames the
# encoder already produces for RTSP are copied into fragmented MP4 files on the
# SD card, with no re-encoding: DCIM/YYYY-MM-DD_HH-MM-SS.mp4 and a .jpg
# thumbnail, REC_SEGMENT_SEC long; the oldest are deleted to keep REC_RESERVE_MB
# free. A file cut by a power loss stays playable up to its last second.
# REC_STREAM=main|sub.
# REC_WHEN=offline: record only while the recorder is not receiving the RTSP
# stream (Frigate down, Wi-Fi/network cut): from REC_OFFLINE_SEC after it stops
# (the file starts with the last seconds kept in memory) until REC_POSTROLL_SEC
# after it is back. REC_CLIENT = the recorder's IPv4 address; empty = the
# host of the Frigate URL in Settings, or any client. REC_WHEN=always records
# all the time, REC_WHEN=motion on motion.
REC_LOCAL=0
REC_SEGMENT_SEC=300
REC_RESERVE_MB=256
REC_STREAM=main
REC_WHEN=offline
REC_CLIENT=
REC_OFFLINE_SEC=5
REC_POSTROLL_SEC=30
# Pre-roll RAM buffer size in KB (default 1024 = 1 MB; min 128, max 8192).
# Keeps the last seconds of video in RAM ring buffer so recordings on motion or
# network cut start with the events leading up to the trigger.
REC_RING_KB=1024
# REC_AUDIO=1: the files get a second track with the microphone (G.711 A-law, 8 kHz
# mono, VLC plays it; browsers show the picture, the sound only if they decode A-law).
# The microphone then runs while the recorder is on.
REC_AUDIO=1
# REC_KEEP_EVENTS=1: a file during which motion or a sound event was detected gets an
# empty .evt next to it; when the card is full, the oldest recording WITHOUT an event
# is deleted first, the event clips only when nothing else is left. 0 = the oldest.
REC_KEEP_EVENTS=0
# SD_AUTO_REPAIR=1: a card the kernel found "not properly unmounted" at boot (power cut) is checked
# and repaired (fsck.fat -a) a minute later, recording paused meanwhile; flash mode only. 0 = only
# the Repair button of the SD card page.
SD_AUTO_REPAIR=0
# LOG_CAP_KB: a log in RAM (/tmp/log, /tmp/logs) above this size keeps its last 200 lines
# (scripts/log-cap.sh, every 10 minutes; most logs cap themselves well below it).
LOG_CAP_KB=64
# PRIVACY_SCREEN=1: privacy mode (Services page "Privacy Mode", MQTT switch): black picture
# on every stream, snapshot and recording, no sound, no motion detection. Kept over a restart.
PRIVACY_SCREEN=0
# RTSP_LITE_TALK=1: two-way audio. A client asking for the ONVIF backchannel (go2rtc,
# Frigate, the microphone button of Home Assistant) plays its sound on the speaker,
# volume as the push-to-talk. Only with the RTSP password. 0 = off.
RTSP_LITE_TALK=1

# ONVIF advertised stream policy:
# - main-primary: ONVIF profile 1 = main stream (default)
# - sub-primary: ONVIF profile 1 = sub stream, profile 2 = main stream
# - sub-only: ONVIF exposes only sub stream (keeps main RTSP for recorder/direct clients)
# - main-only: ONVIF exposes only main stream
ONVIF_STREAM_POLICY=main-primary

# Health-probe timeout (seconds) for service watchdog checks.
RTSP_HEALTHCHECK_TIMEOUT_SECONDS=4
ONVIF_HEALTHCHECK_TIMEOUT_SECONDS=4
# ONVIF health hardening:
# - ONVIF_STARTUP_GRACE_SECONDS: skip ONVIF health failures right after start
# - ONVIF_HEALTHCHECK_RETRIES: retries for local ONVIF HTTP probe
# - ONVIF_RTSP_DEPENDENCY_MODE:
#     off    -> ONVIF health ignores RTSP state
#     status -> ONVIF health requires RTSP process only (recommended)
#     health -> ONVIF health requires RTSP deep health
ONVIF_STARTUP_GRACE_SECONDS=20
ONVIF_HEALTHCHECK_RETRIES=2
ONVIF_RTSP_DEPENDENCY_MODE=status
# Watchdog monitor interval in seconds (used by service-watchdog).
CHECK_TIMEOUT_SECONDS=60
# Watchdog mode of ONVIF:
# - status: restart only when the process is not running (safer for flaky health probes)
# - health: use the ONVIF HTTP probe before deciding
ONVIF_WATCHDOG_MODE=status

# service-watchdog log rotation safeguards
WATCHDOG_LOG_MAX_BYTES=262144
WATCHDOG_LOG_BACKUPS=2
# Watchdog no-reboot (soft) service restart backoff:
# - BASE_DELAY: minimum seconds between restarts for NEED_REBOOT_ON_ERROR=0 services
# - BACKOFF_STEP: added to delay after each failed restart
# - MAX_DELAY: upper bound on the inter-restart delay
WATCHDOG_NO_REBOOT_BASE_DELAY_SECONDS=20
WATCHDOG_NO_REBOOT_BACKOFF_STEP_SECONDS=15
WATCHDOG_NO_REBOOT_MAX_DELAY_SECONDS=180
# Chip temperature source for UI/statusline:
# - auto: try common Linux thermal nodes
# - custom path: e.g. /sys/class/thermal/thermal_zone0/temp
CHIP_TEMP_SOURCE_PATH=auto
# Raw value divisor:
# - auto: detect 1000-based millidegree or direct Celsius
# - explicit: set 1000 (millidegree), 1 (Celsius), etc.
CHIP_TEMP_RAW_DIVISOR=auto

# Health snapshot daemon: pre-builds the health.cgi cache every N seconds (min 10, max 300).
# Lower values mean fresher health data at the cost of more CPU cycles per minute.
HEALTH_SNAPSHOT_INTERVAL_SECONDS=300

# Syslog forwarding: stream logs to a remote syslog server at SYSLOG_HOST:SYSLOG_PORT.
# Requires logger -n support in your busybox build.
SYSLOG_ENABLE=0
SYSLOG_HOST=
SYSLOG_PORT=514

# Integration profile — controls which optional daemons are started at boot.
# "default"    starts everything enabled in autostart/ (safe baseline).
# "frigate_ha" skips Telegram, Timelapse, FTP, Telnet and local Recording
#              (handled by Frigate / Home Assistant). Remote syslog
#              (SYSLOG_ENABLE) and sound detection (sound_detection.conf
#              ENABLE) still follow their own settings.
# Set to "frigate_ha" in boot.conf if this camera feeds Frigate/HA.
INTEGRATION_PROFILE=default

# Front (blue) and rear (red) status LED state applied at boot by
# initialize_gpio(). 0 = off, 1 = on. These keys were previously absent, which
# left the dashboard reporting a permanent "off" regardless of the hardware.
# The live LED state is read from /sys/class/leds/*/brightness — these values
# only decide what boot applies.
FRONT_LED=0
RED_LED=0
# UPDATE_CHECK=1: at boot, ask GitHub (api.github.com) whether a newer release
# exists and show it in the web UI. Off by default: the camera needs no
# internet access; updates are installed from Settings → Firmware update.
UPDATE_CHECK=0

# Camera tampering / occlusion detection: config/tamper.conf (ENABLE, its one switch).
