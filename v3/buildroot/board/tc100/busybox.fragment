# applets the V3 scripts use, on top of Buildroot's default BusyBox configuration
CONFIG_HTTPD=y
CONFIG_FEATURE_HTTPD_CGI=y
CONFIG_WATCHDOG=y
CONFIG_CHPASSWD=y
CONFIG_FEATURE_PASSWD_WEAK_CHECK=y
CONFIG_MOUNTPOINT=y
CONFIG_TIMEOUT=y
CONFIG_NTPD=y
CONFIG_UDHCPC=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_KILLALL=y
CONFIG_OD=y
CONFIG_SEQ=y
CONFIG_XXD=y
CONFIG_HEXDUMP=y
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_NC_EXTRA=y
CONFIG_DMESG=y
CONFIG_FREE=y
CONFIG_DF=y
