# applets the V3 scripts use, on top of Buildroot's default BusyBox configuration
CONFIG_HTTPD=y
CONFIG_FEATURE_HTTPD_CGI=y
CONFIG_FEATURE_HTTPD_BASIC_AUTH=y
CONFIG_FEATURE_HTTPD_AUTH_MD5=y
CONFIG_WATCHDOG=y
CONFIG_CHPASSWD=y
CONFIG_FEATURE_PASSWD_WEAK_CHECK=y
CONFIG_MOUNTPOINT=y
CONFIG_TIMEOUT=y
CONFIG_NTPD=y
CONFIG_UDHCPC=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_KILLALL=y
CONFIG_OD=y
CONFIG_SEQ=y
CONFIG_XXD=y
CONFIG_HEXDUMP=y
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_NC_EXTRA=y
CONFIG_DMESG=y
CONFIG_FREE=y
CONFIG_DF=y
CONFIG_FLASHCP=y
CONFIG_FLASH_ERASEALL=y
CONFIG_FEATURE_FLASHCP_ERASE=y
CONFIG_UDHCPD=y
CONFIG_TELNETD=y
CONFIG_FEATURE_TELNETD_STANDALONE=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_FTPD=y
CONFIG_FEATURE_FTPD_WRITE=y
CONFIG_TCPSVD=y
# web UI: precompressed .gz files, browser cache revalidation (304), seeking in recordings (Range)
CONFIG_FEATURE_HTTPD_GZIP=y
CONFIG_FEATURE_HTTPD_ETAG=y
CONFIG_FEATURE_HTTPD_LAST_MODIFIED=y
CONFIG_FEATURE_HTTPD_DATE=y
CONFIG_FEATURE_HTTPD_RANGES=y

# Slimming (2026-10-30 audit): applets and features that no script, CGI, init script or test of the repo calls and
# that the camera cannot use (no IPv6 in the kernel, no PCI, no VT, no framebuffer, no ext*, no UBI).
# To bring one back, delete its line here (and refresh tests/fixtures/busybox-6.6-applets.txt).
# console / VT / keyboard
# CONFIG_CHVT is not set
# CONFIG_DEALLOCVT is not set
