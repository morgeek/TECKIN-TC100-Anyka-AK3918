# Boot-time performance settings
# Set to 1 to enable lightweight defaults (lower CPU/RAM).
LIGHTWEIGHT_MODE=0

# Network guard (scripts/net-guard.sh, checked every minute by web-guard.sh):
# reboot when the default gateway has not answered for NET_GUARD_MIN minutes
# while the rest of the system runs (the hardware watchdog does not catch
# that). After such a reboot the next limit doubles, up to 2 h, until the
# network has been back for 10 min. Never while the Wi-Fi rescue access point
# is up. NET_GUARD=0 turns it off.
NET_GUARD=1
NET_GUARD_MIN=15
# SD card when running from flash (scripts/sd-card.sh): a FAT32/exFAT card
# without boot files and without card errors is mounted on /mnt/sd when it is
# put in (checked every minute), for the local recording and the web page.
# Formatting is offered in the web page. SD_AUTOMOUNT=0: never mounted
# automatically.
SD_AUTOMOUNT=1
ENABLE_NTP=1
ENABLE_CROND=1

# Managed scheduled reboot cron task:
# Cron expression is: REBOOT_SCHEDULE_MINUTE REBOOT_SCHEDULE_HOUR * * REBOOT_SCHEDULE_WEEKDAY
# REBOOT_SCHEDULE_WEEKDAY supports: *, 0..6, 1-5, 0,6
REBOOT_SCHEDULE_ENABLE=0
REBOOT_SCHEDULE_MINUTE=0
REBOOT_SCHEDULE_HOUR=4
REBOOT_SCHEDULE_WEEKDAY=*

# Web server: busybox httpd behind httpfront, plain HTTP on port 80, one login (root and config/user.pwd).
# WEB_MODE and ULTRALITE_HTTP_PORT are what the 2.x settings pages read; 3.0 serves port 80 whatever they say.
WEB_MODE=http
ULTRALITE_HTTP_PORT=80
# UI ultra-lite mode: 1 = the web pages poll less often and the live view starts paused.
UI_ULTRALITE_MODE=0

# Security hardening mode: FTP and telnet stay off and cannot be started from the web UI.
SECURITY_HARDENING_MODE=0
# Network access (src/netacl). The kernel has no packet filter, so the web
# server, telnet and FTP refuse connections themselves.
#   NET_LAN_ONLY=1   only the private networks may connect (10/8, 172.16/12,
#                    192.168/16, link-local, 100.64/10 for Tailscale): a port
#                    forwarded by the router by mistake is refused at once.
#                    0 = anyone may connect (to the password prompt).
#   NET_ALLOW_EXTRA  more networks, space-separated a.b.c.d/n (a VPN, ...).
NET_LAN_ONLY=1
NET_ALLOW_EXTRA=
# Telnet and FTP send passwords in clear: started from the web page, they
# stop by themselves after REMOTE_SHELL_TIMEOUT_MIN minutes (0 = never).
REMOTE_SHELL_TIMEOUT_MIN=15

# Low CPU profile (recommended for very low usage)
# When enabled, the startup script applies conservative RTSP settings and
# can disable substream/audio/OSD/motion/jpeg. These options are only
# applied when LOW_CPU_PROFILE=1. To keep substream/audio, set the
# corresponding LOW_CPU_DISABLE_* value to 0.
LOW_CPU_PROFILE=0
LOW_CPU_DISABLE_SUBSTREAM=1
LOW_CPU_DISABLE_AUDIO=1
LOW_CPU_DISABLE_MOTION=1
LOW_CPU_DISABLE_OSD=1
LOW_CPU_DISABLE_JPEG=1

# -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Memory Guard & Service Watchdog
# -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
MEM_GUARD_ENABLE=0
MEM_GUARD_INTERVAL_SECONDS=60
# Thresholds on MemAvailable (the 64 MB camera sits near 10.8 MB in normal use): warn stops the light services of
# MEM_GUARD_SOFT_SERVICES; critical also stops those of MEM_GUARD_CRITICAL_SERVICES (motion detection among them) and
# drops the caches. Before 3.0.2 the defaults were 8192 / 4096, too close to the normal value; a camera holding
# exactly those is moved to the new ones when the service starts.
MEM_GUARD_WARN_KB=6144
MEM_GUARD_CRITICAL_KB=3072
MEM_GUARD_EMERGENCY_KB=2048
MEM_GUARD_COOLDOWN_SECONDS=120
MEM_GUARD_DROP_CACHES=0

# List of services to stop based on stage (soft, critical, emergency)
MEM_GUARD_SOFT_SERVICES="network-monitor"
MEM_GUARD_CRITICAL_SERVICES="ftp-server telnet-server motion-detection"
MEM_GUARD_EMERGENCY_SERVICES=""

# Service Watchdog: RESTARTS hung or crashed services (requires MEM_GUARD_ENABLE=1)
MEM_WATCHDOG_ENABLE=1
MEM_WATCHDOG_INTERVAL_SECONDS=40
MEM_WATCHDOG_MAX_RETRIES=3
MEM_WATCHDOG_SERVICES="web-server rtsp-h26x onvif"

# RTSP stream toggles (1=enable, 0=disable), read by rtsp-launch.sh.
# Common topology presets:
# - Dual stream + audio: RTSP_SUBSTREAM=1, RTSP_AUDIO=1
# - Dual stream, audio off: RTSP_SUBSTREAM=1, RTSP_AUDIO=0
# - Main stream + audio: RTSP_SUBSTREAM=0, RTSP_AUDIO=1
# - Main stream only: RTSP_SUBSTREAM=0, RTSP_AUDIO=0
RTSP_SUBSTREAM=1
RTSP_AUDIO=1
# Lower frame rate while nothing moves (tc100_rtsp, read while it runs; Settings -> Streams & audio): IDLE_FPS frames
# per second once motion detection has seen no motion and no sound event for IDLE_AFTER seconds, the full rate again at
# the first one. 0 = off (default). Needs motion detection on; not applied while recording continuously.
IDLE_FPS=0
IDLE_AFTER=10
# Logs kept across reboots (scripts/log-persist.sh): dmesg, syslog and the service logs are copied to the SD card
# (/mnt/sd/logs/boot-NNNN, last 5 boots, about 2 MB each) every LOG_PERSIST_MIN minutes and before a deliberate
# reboot; only with a healthy card and the recording not paused. 0 = off.
LOG_PERSIST=1
LOG_PERSIST_MIN=10
# ISP_TUNE=1: live image tuning from /mnt/config/isp_tune.conf (brightness,
# contrast, saturation, sharpness, hue, 50/60 Hz, exposure cap), applied by
# tc100_rtsp without restarting the stream.
ISP_TUNE=0
# Rescue Wi-Fi access point (scripts/wifi-rescue.sh): when the Wi-Fi link
# (association + gateway ping) stays down for WIFI_RESCUE_AFTER_MIN minutes,
# the camera opens a WPA2 access point (SSID WIFI_RESCUE_SSID, default
# TC100-<end of MAC>) with the web interface at http://10.42.0.1 to fix the
# Wi-Fi settings; it closes once the Wi-Fi is back and nobody uses it. Holding
# the reset button 3-7 s opens it for WIFI_RESCUE_MANUAL_MIN minutes.
# WIFI_RESCUE_PSK empty = a password generated once, shown in Settings (and on
# the card, tc100-3/ADRESSE.txt). WIFI_RESCUE_CHANNEL applies when the camera
# is not associated (otherwise the access point follows the Wi-Fi).
WIFI_RESCUE=0
WIFI_RESCUE_AFTER_MIN=10
WIFI_RESCUE_MANUAL_MIN=15
WIFI_RESCUE_SSID=
WIFI_RESCUE_PSK=
WIFI_RESCUE_CHANNEL=6
# Local backup recording (REC_LOCAL=1), made by tc100_rtsp: the frames the
# encoder already produces for RTSP are copied into fragmented MP4 files on the
# SD card, with no re-encoding: DCIM/YYYY-MM-DD_HH-MM-SS.mp4 and a .jpg
# thumbnail, REC_SEGMENT_SEC long; the oldest are deleted to keep REC_RESERVE_MB
# free. A file cut by a power loss stays playable up to its last second.
# REC_STREAM=main|sub.
# REC_WHEN=offline: record only while the recorder is not receiving the RTSP
# stream (Frigate down, Wi-Fi/network cut): from REC_OFFLINE_SEC after it stops
# (the file starts with the last seconds kept in memory) until REC_POSTROLL_SEC
# after it is back. REC_CLIENT = the recorder's IPv4 address; empty = the
# host of the Frigate URL in Settings, or any client. REC_WHEN=always records
# all the time, REC_WHEN=motion on motion.
REC_LOCAL=0
REC_SEGMENT_SEC=300
REC_RESERVE_MB=256
REC_STREAM=main
REC_WHEN=offline
REC_CLIENT=
REC_OFFLINE_SEC=5
REC_POSTROLL_SEC=30
# REC_AUDIO=1: the files get a second track with the microphone (G.711 A-law, 8 kHz
# mono, VLC plays it; browsers show the picture, the sound only if they decode A-law).
# The microphone then runs while the recorder is on.
REC_AUDIO=1
# RTSP_LITE_TALK=1: two-way audio. A client asking for the ONVIF backchannel (go2rtc,
# Frigate, the microphone button of Home Assistant) plays its sound on the speaker,
# volume as the push-to-talk. Only with the RTSP password. 0 = off.
RTSP_LITE_TALK=1

# ONVIF advertised stream policy:
# - main-primary: ONVIF profile 1 = main stream (default)
# - sub-primary: ONVIF profile 1 = sub stream, profile 2 = main stream
# - sub-only: ONVIF exposes only sub stream (keeps main RTSP for recorder/direct clients)
# - main-only: ONVIF exposes only main stream
ONVIF_STREAM_POLICY=main-primary

# Health-probe timeout (seconds) for service watchdog checks.
RTSP_HEALTHCHECK_TIMEOUT_SECONDS=4
ONVIF_HEALTHCHECK_TIMEOUT_SECONDS=4
# ONVIF health hardening:
# - ONVIF_STARTUP_GRACE_SECONDS: skip ONVIF health failures right after start
# - ONVIF_HEALTHCHECK_RETRIES: retries for local ONVIF HTTP probe
# - ONVIF_RTSP_DEPENDENCY_MODE:
#     off    -> ONVIF health ignores RTSP state
#     status -> ONVIF health requires RTSP process only (recommended)
#     health -> ONVIF health requires RTSP deep health
ONVIF_STARTUP_GRACE_SECONDS=20
ONVIF_HEALTHCHECK_RETRIES=2
ONVIF_RTSP_DEPENDENCY_MODE=status
# Watchdog monitor interval in seconds (used by service-watchdog).
CHECK_TIMEOUT_SECONDS=60
# Watchdog mode of ONVIF:
# - status: restart only when the process is not running (safer for flaky health probes)
# - health: use the ONVIF HTTP probe before deciding
ONVIF_WATCHDOG_MODE=status

# service-watchdog log rotation safeguards
WATCHDOG_LOG_MAX_BYTES=262144
WATCHDOG_LOG_BACKUPS=2
# Watchdog no-reboot (soft) service restart backoff:
# - BASE_DELAY: minimum seconds between restarts for NEED_REBOOT_ON_ERROR=0 services
# - BACKOFF_STEP: added to delay after each failed restart
# - MAX_DELAY: upper bound on the inter-restart delay
WATCHDOG_NO_REBOOT_BASE_DELAY_SECONDS=20
WATCHDOG_NO_REBOOT_BACKOFF_STEP_SECONDS=15
WATCHDOG_NO_REBOOT_MAX_DELAY_SECONDS=180
# Chip temperature source for UI/statusline:
# - auto: try common Linux thermal nodes
# - custom path: e.g. /sys/class/thermal/thermal_zone0/temp
CHIP_TEMP_SOURCE_PATH=auto
# Raw value divisor:
# - auto: detect 1000-based millidegree or direct Celsius
# - explicit: set 1000 (millidegree), 1 (Celsius), etc.
CHIP_TEMP_RAW_DIVISOR=auto

# Health snapshot daemon: pre-builds the health.cgi cache every N seconds (min 10, max 300).
# Lower values mean fresher health data at the cost of more CPU cycles per minute.
HEALTH_SNAPSHOT_INTERVAL_SECONDS=300

# Syslog forwarding: stream logs to a remote syslog server at SYSLOG_HOST:SYSLOG_PORT.
# Requires logger -n support in your busybox build.
SYSLOG_ENABLE=0
SYSLOG_HOST=
SYSLOG_PORT=514

# Integration profile — controls which optional daemons are started at boot.
# "default"    starts everything enabled in autostart/ (safe baseline).
# "frigate_ha" skips Telegram, Timelapse, FTP, Telnet and local Recording
#              (handled by Frigate / Home Assistant). Remote syslog
#              (SYSLOG_ENABLE) and sound detection (sound_detection.conf
#              ENABLE) still follow their own settings.
# Set to "frigate_ha" in boot.conf if this camera feeds Frigate/HA.
INTEGRATION_PROFILE=default

# Front (blue) and rear (red) status LED state applied at boot by
# initialize_gpio(). 0 = off, 1 = on. These keys were previously absent, which
# left the dashboard reporting a permanent "off" regardless of the hardware.
# The live LED state is read from /sys/class/leds/*/brightness — these values
# only decide what boot applies.
FRONT_LED=0
RED_LED=0
# UPDATE_CHECK=1: at boot, ask GitHub (api.github.com) whether a newer release
# exists and show it in the web UI. Off by default: the camera needs no
# internet access; updates are installed from Settings → Firmware update.
UPDATE_CHECK=0
