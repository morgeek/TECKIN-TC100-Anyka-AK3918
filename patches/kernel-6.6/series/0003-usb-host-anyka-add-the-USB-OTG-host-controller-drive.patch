+
+/**
+    enum for DMA channel status
+ */
+enum
+{
+    USB_DMA_CHANNEL_IDLE,       //idle
+    USB_DMA_CHANNEL_ALLOC,      //alloced for a specific ep fifo but not under tranfering
+    USB_DMA_CHANNEL_TRANS       //there is a dma tranfering in this channel
+};
