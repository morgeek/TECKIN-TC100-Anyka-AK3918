+    CLEAR_BITS(cmd, FCS_HUE_SAT_EN, 1);
+    cmd |= (LOW_BITS(hue->hue_sat_en, 1) << FCS_HUE_SAT_EN);     
+    isp->reg_blkaddr5[R5_ENABLE] = cmd;
+	
+	ak_isp_vo_update_setting();
+
+	return 0;
