#!/bin/sh
BOUNDARY="thinginoframe"
printf "Content-Type: multipart/x-mixed-replace; boundary=%s\r\n\r\n" "$BOUNDARY"
IMG="/tmp/frame_ch0.jpg"
[ -f "$IMG" ] || exit 0

while true; do
    printf -- "--%s\r\n" "$BOUNDARY"
    printf "Content-Type: image/jpeg\r\n\r\n"
    cat "$IMG"
    printf "\r\n"
    sleep 1
done
