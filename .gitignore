# macOS Finder metadata
.DS_Store

# Live configs (may hold credentials) — only the .dist templates are tracked;
# the camera seeds live copies from .dist at boot via install_config.
config/mqtt.conf
config/user.pwd
wpa_supplicant.conf
# Last-known-good snapshots and corruption quarantine written by the camera
config/.lkg/
config/*.conf.corrupt

# Runtime artifacts generated during local upgrade/testing
log/*.log
!log/.gitignore

# Local host-side backup snapshots
backup/package-upgrades/
# Pre-deploy camera snapshots pulled over FTP (backup-<camera-ip>-<timestamp>/)
backup-*/
# Last deployed commit (machine-local state)
.last-deploy-sha

# Accidental local symlink; runtime script recreates this on camera when needed
lib/libcurl.so.4

# Local development tooling (not published)
/CLAUDE.md
/.claude/
/package.json
/tools/
/frontend/
node_modules/

# Host regression test bytecode
__pycache__/
*.pyc
dist/

# tc100_rtsp link stand-ins, made by its Makefile
/src/tc100rtsp/test_livemp4
/src/tc100rtsp/test_rtsp
/src/tc100rtsp/test_rec
/src/tc100rtsp/test_aacenc
/src/tc100rtsp/test_adsp
/src/tc100rtsp/test_util
/src/tc100rtsp/defined.txt
/src/tc100rtsp/imports.txt
/src/tc100rtsp/libpthread.so.0
/src/tc100rtsp/tc100_rtsp.dbg
/src/libakuio/libakuio.dbg.so
/src/tc100rtsp/stub_pthread.c

# tc100-mqttd build products
/src/mqttd/*.o
/src/mqttd/*.dbg
/src/mqttd/stubs.c
/src/mqttd/defined.txt
/src/mqttd/imports.txt
/src/mqttd/libc.so.0
/src/mqttd/tc100-mqttd
/src/mqttd/tc100-mqttd-host
# tc100-supervisord build products
/src/supervisord/*.o
/src/supervisord/*.dbg
/src/supervisord/stubs.c
/src/supervisord/defined.txt
/src/supervisord/imports.txt
/src/supervisord/libc.so.0
/src/supervisord/tc100-supervisord
/src/supervisord/tc100-supervisord-host

# build products that CI makes (audit 2026-11-04 D3: the old copies in git were stale and shipped by nothing)
/src/libakuio/libakuio.so
/src/httpfront/httpfront
/src/jpegenc/jpegenc
/src/tc100rtsp/tc100_rtsp

# tc100-onvifd build products
/src/onvifd/*.o
/src/onvifd/*.dbg
/src/onvifd/stubs.c
/src/onvifd/defined.txt
/src/onvifd/imports.txt
/src/onvifd/libc.so.0
/src/onvifd/tc100-onvifd
/src/onvifd/tc100-onvifd-host
