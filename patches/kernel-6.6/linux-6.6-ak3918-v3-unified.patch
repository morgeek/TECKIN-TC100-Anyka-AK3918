+static void ak39_set_sel_vref(struct ak39_codec *codec, bool bOn) 
+{
+	unsigned long reg_val;
+	reg_val = REG32(codec->analog_ctrl_base + ADC1_CONF_REG1);
+	if(bOn)
+		reg_val |= SEL_VREF;
+	else	
+		reg_val &= ~SEL_VREF;
+
+	REG32(codec->analog_ctrl_base + ADC1_CONF_REG1) = reg_val;
