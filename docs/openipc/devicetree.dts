        spi1@20128000 {
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            clocks = <0x5 0x5>;
            compatible = "anyka,ak39ev330-spi1";
            interrupts = <0x9 0x0>;
            reg = <0x20128000 0x7fff>;
            status = "disable";
        };
        uart0@20130000 {
            clocks = <0x5 0x6>;
            compatible = "anyka,ak39ev330-uart0";
            current-speed = <0x1c200>;
            fifosize = <0x40>;
            interrupts = <0xa 0x0>;
            pinctrl-0 = <0x10>;
            pinctrl-names = "default";
            reg = <0x20130000 0x7fff>;
            status = "okay";
        };
        uart1@20138000 {
            clocks = <0x5 0x7>;
            compatible = "anyka,ak39ev330-uart1";
            current-speed = <0x1c200>;
            fifosize = <0x40>;
            interrupts = <0xb 0x0>;
            pinctrl-0 = <0x11>;
            pinctrl-names = "default";
            reg = <0x20138000 0x7fff>;
            status = "disable";
        };
        usb@20200000 {
            clocks = <0x5 0xe>;
            compatible = "anyka,ak39ev330-usb";
            interrupts = <0x12 0x0 0x13 0x0>;
            reg = <0x20200000 0xffff>;
            status = "okay";
        };
        vi0@20000000 {
            clock-frequency_isp_clk = <0x16e3600>;
            clock-names = "isp_clk", "mipi_csi_clk", "csi_sclk";
            clocks = <0x5 0x11 0x5 0xf 0x14 0x0>;
            compatible = "anyka,ak39ev330-vi";
            interface = <0x0>;
            interrupts = <0x1 0x0>;
            pinctrl-0 = <0x16>;
            pinctrl-1 = <0x2>;
            pinctrl-2 = <0x17>;
            pinctrl-3 = <0x4>;
            pinctrl-4 = <0x3>;
            pinctrl-5 = <0x18>;
            pinctrl-6 = <0x19>;
            pinctrl-names = "dvp0_12bits", "dvp0_10bits", "dvp0_8bits", "mipi0_2lane", "mipi0_1lane", "csi0_sclk", "csi1_sclk";
            reg = <0x20000000 0x1fff 0x20400000 0xfff>;
            status = "disabled";
            port@0 {
                #address-cells = <0x1>;
                #size-cells = <0x0>;
                endpoint@0 {
                    reg = <0x0>;
                    remote-endpoint = <0x7>;
                };
            };
        };
        video-encoder-m2m@20020000 {
            clocks = <0x5 0x12>;
            compatible = "anyka,ak3918ev200-venc";
            interrupts = <0x2 0x0>;
            reg = <0x20020000 0x1000>;
            status = "disable";
