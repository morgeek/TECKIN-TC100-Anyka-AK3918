#!/bin/sh
SERVICE_NAME="ONVIF Discovery"
PIDFILE="/var/run/onvif.pid"
WATCHDOG_PIDFILE="/var/run/onvif-watch.pid"
START_TS_FILE="/var/run/onvif-start.ts"
export LD_LIBRARY_PATH='/mnt/lib/:/thirdlib:/system/lib/:/usr/lib/'
CONFIGPATH="/mnt/config"

. /mnt/scripts/common_functions.sh

install_config $CONFIGPATH/onvif.conf
. $CONFIGPATH/onvif.conf

install_config $CONFIGPATH/rtspserver.conf

# tc100-onvifd reports the device location given with -loc.
# Keep backward compatibility with older custom configs that used LOCATION.
: "${DEVICE_LOCATION:=}"
if [ -z "$DEVICE_LOCATION" ] && [ -n "$LOCATION" ]; then
  DEVICE_LOCATION="$LOCATION"
fi
: "${DEVICE_LOCATION:=Earth}"

BOOT_CONFIG="$CONFIGPATH/boot.conf"
RTSP_SUBSTREAM="1"
if [ -f "$BOOT_CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$BOOT_CONFIG"
fi
: "${ONVIF_IMPL:=c}"   # c: the free tc100-onvifd (src/onvifd), the only ONVIF daemon since rc32 (monvifd removed)
: "${ONVIF_STREAM_POLICY:=main-primary}"
: "${ONVIF_HEALTHCHECK_TIMEOUT_SECONDS:=4}"
: "${ONVIF_WATCHDOG_MODE:=status}"
: "${ONVIF_HEALTHCHECK_RETRIES:=2}"
: "${ONVIF_STARTUP_GRACE_SECONDS:=20}"
: "${ONVIF_RTSP_DEPENDENCY_MODE:=status}"

case "$ONVIF_HEALTHCHECK_TIMEOUT_SECONDS" in
  ''|*[!0-9]*) ONVIF_HEALTHCHECK_TIMEOUT_SECONDS=4 ;;
esac
[ "$ONVIF_HEALTHCHECK_TIMEOUT_SECONDS" -lt 2 ] && ONVIF_HEALTHCHECK_TIMEOUT_SECONDS=2
[ "$ONVIF_HEALTHCHECK_TIMEOUT_SECONDS" -gt 30 ] && ONVIF_HEALTHCHECK_TIMEOUT_SECONDS=30

case "$ONVIF_HEALTHCHECK_RETRIES" in
  ''|*[!0-9]*) ONVIF_HEALTHCHECK_RETRIES=2 ;;
esac
[ "$ONVIF_HEALTHCHECK_RETRIES" -lt 1 ] && ONVIF_HEALTHCHECK_RETRIES=1
[ "$ONVIF_HEALTHCHECK_RETRIES" -gt 5 ] && ONVIF_HEALTHCHECK_RETRIES=5

case "$ONVIF_STARTUP_GRACE_SECONDS" in
  ''|*[!0-9]*) ONVIF_STARTUP_GRACE_SECONDS=20 ;;
esac
[ "$ONVIF_STARTUP_GRACE_SECONDS" -lt 0 ] && ONVIF_STARTUP_GRACE_SECONDS=0
[ "$ONVIF_STARTUP_GRACE_SECONDS" -gt 180 ] && ONVIF_STARTUP_GRACE_SECONDS=180

case "$ONVIF_WATCHDOG_MODE" in
  status|health) ;;
  *) ONVIF_WATCHDOG_MODE="status" ;;
esac

case "$ONVIF_RTSP_DEPENDENCY_MODE" in
  off|status|health) ;;
  *) ONVIF_RTSP_DEPENDENCY_MODE="status" ;;
esac

# the web server (snapshot URL) is plain HTTP on port 80
WEB_PROTO="http"
WEB_PORT="80"

status()
{
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  if [ "$pid" ]; then
    # Prints PID: $pid if exists and returns 0(no error) else returns 1(error condition)
    kill -0 "$pid" >/dev/null && echo "PID: $pid" || return 1
  fi
  [ -n "$pid" ] || return 1
}

start()
{
  if [ "$(status)" != "" ]; then
    echo "A ONVIF Discovery service is already running, please stop it or reboot"
  else
    echo "Starting ONVIF Discovery service"
    
    LOGPATH="${ONVIF_LOGPATH:-/dev/null}"

    IFS=" "
    set -- $(/mnt/bin/rwconf $CONFIGPATH/rtspserver.conf r \
      0 width 0 height 0 codec 0 fps 0 bps \
      1 width 1 height 1 codec 1 fps 1 bps \
      " " PORT 0 mainres)

    WIDTH0=$1; HEIGHT0=$2; CODEC0=$3; FPS0=$4; BPS0=$5
    WIDTH1=$6; HEIGHT1=$7; CODEC1=$8; FPS1=$9; BPS1=${10}
    PORT=${11}; MAINRES=${12}

    # what tc100_rtsp really sends, whatever else rtspserver.conf says (the same rules as v3/linux66-sd/rtsp-launch.sh
    # and state.cgi): 1920x1080, or 1280x720 when [0] mainres is 720 and the kernel scales the picture (ak39_vi
    # main_scale); 640x360 for video1. One frame rate for both streams, [0] fps when it is 10, 12, 15, 20 or 25, else
    # tc100_rtsp's default of 15 (rc27 tester R6: it was capped at 15 while the streams ran at 25)
    WIDTH0=1920; HEIGHT0=1080; WIDTH1=640; HEIGHT1=360
    if [ "$MAINRES" = 720 ] && [ -e "${TC100_VI_SCALE_PARAM:-/sys/module/ak39_vi/parameters/main_scale}" ]; then
      WIDTH0=1280; HEIGHT0=720
    fi
    case "$FPS0" in 10|12|15|20|25) ;; *) FPS0=15 ;; esac
    FPS1=$FPS0
    CODECSTR0="H264"; [ "$CODEC0" = "2" ] && CODECSTR0="H265"
    CODECSTR1="H264"; [ "$CODEC1" = "2" ] && CODECSTR1="H265"

    PRIMARY_RP="video0_unicast"
    PRIMARY_WIDTH="$WIDTH0"
    PRIMARY_HEIGHT="$HEIGHT0"
    PRIMARY_CODEC="$CODECSTR0"
    PRIMARY_BPS="$BPS0"
    PRIMARY_FPS="$FPS0"

    SECONDARY_ENABLED=0
    SECONDARY_RP=""
    SECONDARY_WIDTH=""
    SECONDARY_HEIGHT=""
    SECONDARY_CODEC=""
    SECONDARY_BPS=""
    SECONDARY_FPS=""

    if [ "$RTSP_SUBSTREAM" = "1" ]; then
      SECONDARY_ENABLED=1
      SECONDARY_RP="video1_unicast"
      SECONDARY_WIDTH="$WIDTH1"
      SECONDARY_HEIGHT="$HEIGHT1"
      SECONDARY_CODEC="$CODECSTR1"
      SECONDARY_BPS="$BPS1"
      SECONDARY_FPS="$FPS1"
    fi

    case "$ONVIF_STREAM_POLICY" in
      sub-primary)
        if [ "$RTSP_SUBSTREAM" = "1" ]; then
          PRIMARY_RP="video1_unicast"
          PRIMARY_WIDTH="$WIDTH1"
          PRIMARY_HEIGHT="$HEIGHT1"
          PRIMARY_CODEC="$CODECSTR1"
          PRIMARY_BPS="$BPS1"
          PRIMARY_FPS="$FPS1"

          SECONDARY_ENABLED=1
          SECONDARY_RP="video0_unicast"
          SECONDARY_WIDTH="$WIDTH0"
          SECONDARY_HEIGHT="$HEIGHT0"
          SECONDARY_CODEC="$CODECSTR0"
          SECONDARY_BPS="$BPS0"
          SECONDARY_FPS="$FPS0"
        fi
        ;;
      sub-only)
        if [ "$RTSP_SUBSTREAM" = "1" ]; then
          PRIMARY_RP="video1_unicast"
          PRIMARY_WIDTH="$WIDTH1"
          PRIMARY_HEIGHT="$HEIGHT1"
          PRIMARY_CODEC="$CODECSTR1"
          PRIMARY_BPS="$BPS1"
          PRIMARY_FPS="$FPS1"
        fi
        SECONDARY_ENABLED=0
        ;;
      main-only)
        SECONDARY_ENABLED=0
        ;;
      main-primary|*)
        # Default behavior.
        ;;
    esac

    if [ "$SECONDARY_ENABLED" = "1" ]; then
      ONVIF_STREAM2_ARGS="-en2 1 -rp2 $SECONDARY_RP -vw2 $SECONDARY_WIDTH -vh2 $SECONDARY_HEIGHT -vc2 $SECONDARY_CODEC -vcb2 $SECONDARY_BPS -fps2 $SECONDARY_FPS"
    else
      ONVIF_STREAM2_ARGS="-en2 0"
    fi

    ONVIFD_BIN=/mnt/tc100test/tc100-onvifd
    if [ -x "$ONVIFD_BIN" ]; then
      # free daemon: reads rtspserver.conf / boot.conf / user.pwd itself (1080p or 720p, codecs, frame rate, sub-stream,
      # same login as the RTSP server); the stream policy is the only stream option it needs. SIGHUP re-reads the files.
      TC100_NET_ALLOW="$(sh -c '. /mnt/scripts/common_functions.sh; netacl_allow_list' 2>/dev/null)"; export TC100_NET_ALLOW
      "$ONVIFD_BIN" -p "$ONVIF_PORT" -w "$WEB_PORT" -wp "$WEB_PROTO" -r "$PORT" -hwn "$HW_NAME" -vnn "$VENDOR_NAME" -loc "$DEVICE_LOCATION" -dn "$DEVICE_NAME" -mod "$DEVICE_MODEL"           -sp "$ONVIF_STREAM_POLICY" 2>> "$LOGPATH" >> "$LOGPATH" &
    else
      echo "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) no ONVIF daemon: $ONVIFD_BIN is missing" >> "$LOGPATH"
      return 1
    fi
    echo "$!" > "$PIDFILE"
    date +%s > "$START_TS_FILE" 2>/dev/null || true

    ## Watchdog
    if ! checkpid "$WATCHDOG_PIDFILE"; then
      CHECK_TIMEOUT_SECONDS="${CHECK_TIMEOUT_SECONDS:-60}" \
      WATCHDOG_LOG_MAX_BYTES="${WATCHDOG_LOG_MAX_BYTES:-262144}" \
      WATCHDOG_LOG_BACKUPS="${WATCHDOG_LOG_BACKUPS:-2}" \
      WATCHDOG_NO_REBOOT_BASE_DELAY_SECONDS="${WATCHDOG_NO_REBOOT_BASE_DELAY_SECONDS:-20}" \
      WATCHDOG_NO_REBOOT_BACKOFF_STEP_SECONDS="${WATCHDOG_NO_REBOOT_BACKOFF_STEP_SECONDS:-15}" \
      WATCHDOG_NO_REBOOT_MAX_DELAY_SECONDS="${WATCHDOG_NO_REBOOT_MAX_DELAY_SECONDS:-180}" \
      sh /mnt/scripts/housekeeper.sh watch-add onvif "$WATCHDOG_PIDFILE" "$CHECK_TIMEOUT_SECONDS" 0 "$ONVIF_WATCHDOG_MODE" \
        </dev/null >/dev/null 2>&1 || {
      /mnt/scripts/service-watchdog.sh /mnt/controlscripts/onvif 0 "$ONVIF_WATCHDOG_MODE" </dev/null >/dev/null 2>&1 &
      echo "$!" > "$WATCHDOG_PIDFILE"
      }
    fi
  fi
}

health()
{
  if [ "$(status)" = "" ]; then
    return 1
  fi

  if [ "$ONVIF_STARTUP_GRACE_SECONDS" -gt 0 ] && [ -r "$START_TS_FILE" ]; then
    read -r start_ts < "$START_TS_FILE"
    case "$start_ts" in
      ''|*[!0-9]*) start_ts=0 ;;
    esac
    now_ts="$(date +%s 2>/dev/null)"
    case "$now_ts" in
      ''|*[!0-9]*) now_ts=0 ;;
    esac
    if [ "$start_ts" -gt 0 ] && [ "$now_ts" -gt "$start_ts" ]; then
      age=$((now_ts - start_ts))
      if [ "$age" -lt "$ONVIF_STARTUP_GRACE_SECONDS" ]; then
        echo "HEALTHY"
        return 0
      fi
    fi
  fi

  case "$ONVIF_RTSP_DEPENDENCY_MODE" in
    health)
      /mnt/controlscripts/rtsp-h26x health >/dev/null 2>&1 || return 1
      ;;
    status)
      /mnt/controlscripts/rtsp-h26x status >/dev/null 2>&1 || return 1
      ;;
  esac

  if [ -x /mnt/bin/curl ]; then
    attempt=1
    while [ "$attempt" -le "$ONVIF_HEALTHCHECK_RETRIES" ]; do
      # Plain HTTP (the curl in flash has no TLS).
      if /mnt/bin/curl -s -S -m "$ONVIF_HEALTHCHECK_TIMEOUT_SECONDS" -o /dev/null \
          "http://127.0.0.1:${ONVIF_PORT}/" >/dev/null 2>&1; then
        echo "HEALTHY"
        return 0
      fi
      attempt=$((attempt + 1))
      if [ "$attempt" -le "$ONVIF_HEALTHCHECK_RETRIES" ]; then
        sleep 1
      fi
    done
    return 1
  fi

  echo "HEALTHY"
}

restart()
{
  stop
  sleep 1
  start
}

stop()
{
  rm -f "$START_TS_FILE"
  sh /mnt/scripts/housekeeper.sh watch-del onvif </dev/null >/dev/null 2>&1   # job of the housekeeper: its pid file goes
  killpid_graceful "$WATCHDOG_PIDFILE" 3
  killpid_graceful "$PIDFILE" 5
}

if [ $# -eq 0 ]; then
  start
else
  case "$1" in
    start|stop|status|restart|health)
      "$1"
      ;;
    *)
      echo "Usage: $0 {start|stop|status|restart|health}" >&2
      exit 1
      ;;
  esac
fi
