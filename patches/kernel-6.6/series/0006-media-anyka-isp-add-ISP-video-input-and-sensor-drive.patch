+static int f22_set_power_off(const int pwdn_pin, const int reset_pin)
+{
+#if 0
+    u8 Reg0x3d = 0x48;
+    u8 Reg0xc3 = 0x00;
+#endif
+
+#if 0
+	//sccb software standby mode
+    
+    f22_sensor_write_register(0x3d, Reg0x3d);
