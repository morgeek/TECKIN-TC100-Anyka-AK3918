+        break;
+    case BUFFER_FOUR:
+        isp->reg_blkaddr1[33] = yaddr_main_chan_addr;   //y4
+        isp->reg_blkaddr1[36] = yaddr_main_chan_addr+isp->ch1_height*isp->ch1_width; //u4 
