# Sound detection configuration
# Managed by: controlscripts/sound-detection
#
# The level is measured inside the RTSP server (tc100_rtsp, -S /var/run/sound_level) on the raw
# microphone signal, once a second. Enabling or disabling restarts the RTSP
# service; while enabled the RTSP server serves audio (the meter needs the
# vendor audio encoder running) and the vendor echo canceller / noise gate
# are off.
#
# ENABLE — 1 to publish a "sound" event (MQTT; also triggers a recording when
#   recording on motion is enabled) when the level reaches THRESHOLD_DB.
ENABLE=0

# THRESHOLD_DB — level in dBFS (0 = loudest the microphone can capture).
#   A quiet room is around -60, speech near the camera around -35 to -25,
#   a shout or a dog barking around -20 to -10. Range -90..0. Default: -24
#   (measured on a TC100: at -30, an evening at home gave ~170 events an hour,
#   70 % of them within 3 dB of the threshold).
#   Watch "Level" in Services → sound-detection → status to tune it.
THRESHOLD_DB=-24

# MIN_LOUD_SECONDS — publish only once a burst has been loud for this many
#   seconds (1 = any loud second). 2 ignores single knocks and clicks but also
#   a single short bark. Range 1-10. Default: 1
MIN_LOUD_SECONDS=1

# INTERVAL — seconds between checks of the meter. Every loud second is counted
#   by the meter, so a longer interval only delays the event, it never misses
#   one. Range 1–300. Default: 2
INTERVAL=2

# VOX_MODE — 1 to enable continuous babyphone / Vox state tracking.
#   Needs ENABLE=1 as well (VOX_MODE alone does nothing).
#   When VOX_MODE=1, sound bursts emit babyphone binary_sensor ON to MQTT,
#   and hold ON until VOX_HOLD_SECONDS of silence elapsed before resetting to OFF.
VOX_MODE=0
VOX_HOLD_SECONDS=5

# ALARM_DETECT — 1 to enable alarm sound alert tracking.
#   Needs ENABLE=1 as well. Fires on ANY sound above THRESHOLD_DB for at least
#   3 seconds in a row (level only, the pitch is not analysed): a smoke / CO
#   alarm does that, but so do music, a vacuum cleaner or a long shout.
#   A help, never a safety device: it does not replace a real alarm.
#   Publishes alarm/state ON, back to OFF after ALARM_HOLD_SECONDS.
ALARM_DETECT=0
ALARM_HOLD_SECONDS=15

# THRESHOLD — legacy (1.8.3 and earlier, raw sample sum); no longer used.
