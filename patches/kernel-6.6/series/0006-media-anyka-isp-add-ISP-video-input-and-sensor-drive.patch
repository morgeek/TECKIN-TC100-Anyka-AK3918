+
+/*
+ * ak_sensor_set_sensor_cb() can be called before akisp_init() has
+ * allocated priv (the sensor driver's own module_init can run before this
+ * misc device's), silently dropping the callback block with no error
+ * returned to the caller. Stash it here and install it once priv exists,
+ * regardless of which module_init runs first.
+ */
+static AK_ISP_SENSOR_CB *pending_sensor_cb = NULL;
+
+void ak_sensor_set_sensor_cb(AK_ISP_SENSOR_CB *cb)
+{
+	if (priv)
+		priv->sensor_cb = cb;
+	else
+		pending_sensor_cb = cb;
+}
+EXPORT_SYMBOL(ak_sensor_set_sensor_cb);
+
+AK_ISP_SENSOR_CB *ak_sensor_get_sensor_cb(void)
+{
+	return priv ? priv->sensor_cb : NULL;
+}
