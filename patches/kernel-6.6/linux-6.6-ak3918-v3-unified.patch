+		_set_hue_attr(&(isp->hue_para.manual_hue));
+		
+		return 0;
+	}
+	else
+	{
+		unsigned int total_gain;
+		unsigned int isp_d_gain;
+
+		isp_d_gain= isp->ae_run_info_para.current_isp_d_gain;		
+		_calc_wb_step();
