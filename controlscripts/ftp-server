#!/bin/sh
SERVICE_NAME="FTP Server"
PIDFILE="/var/run/ftp-server.pid"
export LD_LIBRARY_PATH='/mnt/lib/:/thirdlib:/system/lib/:/usr/lib/'
PATH=/mnt/bin:/system/bin:/bin:/sbin:/usr/bin:/usr/sbin
CONFIGPATH="/mnt/config"

. /mnt/scripts/common_functions.sh

install_config $CONFIGPATH/ftp.conf
. $CONFIGPATH/ftp.conf

status()
{
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  # Running = our tcpsvd is alive AND the port listens. A stale pidfile (dead
  # tcpsvd, PID reused) used to report "running" and block start.
  if kill -0 "$pid" 2>/dev/null && grep -q tcpsvd "/proc/$pid/cmdline" 2>/dev/null && port_listening "$PORT"; then
    echo "PID: $pid"
    return 0
  fi
  rm -f "$PIDFILE"
  return 1
}

start()
{
  _security="$(read_kv_config_value /mnt/config/boot.conf SECURITY_HARDENING_MODE 0)"
  case "$_security" in 1|true|yes|on|enabled)
    echo "Service disabled by security hardening" >&2
    return 1 ;;
  esac
  if [ "$(status)" != "" ]; then
    echo "A ftp server is already running, please stop it or reboot"
  else
    stop
    /mnt/bin/busybox tcpsvd 0 $PORT /mnt/bin/busybox ftpd -w -t 600 / </dev/null >/dev/null 2>&1 &
    # $! is tcpsvd itself (it stays in the foreground); ps|awk also matched
    # ftpd session children and wrote several PIDs.
    echo "$!" > "$PIDFILE"
    sleep 1
  fi
}

stop()
{
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  if [ "$pid" ]; then
    rm "$PIDFILE" 1> /dev/null 2>&1
  fi
  ps|awk '/[f]tpd/ {print $1}' | while read OLDPID; do kill -9 $OLDPID; done;
}

health()
{
  if [ -n "$(status)" ]; then echo "ok: running"; else echo "warn: stopped"; fi
}

if [ $# -eq 0 ]; then
  start
else
  case $1 in start|stop|status|health)
    $1
    ;;
  esac
fi
