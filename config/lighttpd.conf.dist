server.document-root = "/mnt/www"

server.port = 80

# uncomment to allow more exotic hostnames e.g. with underscores
#server.http-parseopt-host-strict = "disable"

mimetype.assign = (
  ".html" => "text/html",
  ".txt" => "text/plain",
  ".jpg" => "image/jpeg",
  ".png" => "image/png",
  ".css" => "text/css",
  ".js" => "text/javascript"
)
index-file.names = ( "index.html" )
server.modules = ("mod_auth",
                  "mod_authn_file",
                  "mod_redirect",
                  "mod_cgi",
                  "mod_staticfile",
                  "mod_openssl",
                  "mod_setenv",
                  "mod_deflate",
                  "mod_alias")

cgi.assign = ( ".cgi" => "/bin/sh" )
alias.url = ( "/DCIM/" => "/mnt/DCIM/" )

$SERVER["socket"] == ":443" {
  ssl.engine = "enable"
  ssl.pemfile = "/mnt/config/lighttpd.pem"
}


# Support letsencrypt SSL cert paths
# (we don't want to upgrade to SSL nor auth' this path)
$HTTP["url"] !~ "^/.well-known/(.*)" {

    auth.backend                = "htdigest"
    auth.backend.htdigest.userfile = "/mnt/config/lighttpd.user"
    auth.require = ( "/" => ("method" => "basic", "realm" => "all", "require" => "user=root"))

    $HTTP["scheme"] == "http" {
        # capture vhost name with regex conditiona -> %0 in redirect pattern
        # must be the most inner block to the redirect rule
        $HTTP["host"] =~ ".*" {
            url.redirect = (".*" => "https://%0$0")
        }
    }
}

## IP allowlist — restrict web UI to a specific subnet.
## Uncomment and set your LAN CIDR to block access from other networks/interfaces.
## Example: allow only 192.168.1.x
#$HTTP["remoteip"] !~ "^192\.168\.1\." {
#    url.access-deny = ("")
#}
## To allow multiple subnets, extend the pattern:
#$HTTP["remoteip"] !~ "^(192\.168\.1\.|10\.0\.0\.)" {
#    url.access-deny = ("")
#}

## enable debugging
#debug.log-request-header     = "enable"
#debug.log-response-header    = "enable"
#debug.log-request-handling   = "enable"
#debug.log-file-not-found     = "enable"
#debug.log-condition-handling = "enable"

## where to send error-messages to
server.errorlog             = "/var/log/lighttpd-error.log"
server.upload-dirs          = ("/tmp/")

# Security headers applied to all responses to harden the web UI
setenv.add-response-header = (
  "X-Content-Type-Options" => "nosniff",
  "X-Frame-Options" => "SAMEORIGIN",
  "Content-Security-Policy" => "default-src 'self' 'unsafe-inline'"
)

# Cache static assets (css/js/images) so browsers skip the request entirely
# instead of re-validating via conditional GET on every page load.
$HTTP["url"] =~ "\.(css|js|png|jpg|jpeg|svg|gif|ico|woff|woff2|ttf)$" {
  setenv.add-response-header = (
    "Cache-Control" => "public, max-age=86400"
  )
}

# Compress CSS/JS once per boot into tmpfs and serve from cache (~75% smaller
# first loads). Restricted to static text assets: CGI output stays uncompressed
# so dynamic responses cost no CPU and leak nothing via compressed lengths.
deflate.cache-dir = "/tmp/lighttpd-deflate/"
deflate.mimetypes = ("text/css", "text/javascript")
deflate.allowed-encodings = ("gzip", "deflate")

## CGI (etc) stderr log
server.breakagelog = "/var/log/lighttpd-cgi-stderr.log"

## accesslog module
#accesslog.filename = "/var/log/lighttpd-access.log"

# Keep-alive: the dashboard polls every 20 s, but lighttpd default idle is 5 s,
# so every poll paid a full RSA handshake (~1-5 s of CPU on the AK3918 —
# measured: reused connection answers in 0.3 s, fresh one in up to 5.7 s).
# Holding an idle connection costs a few KB of RAM; the handshake costs CPU.
server.max-keep-alive-idle = 45
server.max-keep-alive-requests = 500
