# Service trimming (the "rtsp-only" performance profile), the only place of this setting.
#
# SERVICE_TRIM=1 is written by the rtsp-only profile (Settings -> Performance profile, MQTT "profile") and by
# service_trim_on: the non-essential services (FTP, telnet, motion detection, automatic night mode, front LED,
# night mode) are stopped, and the Services page, the MQTT bridge and the state report show the profile as
# rtsp-only. 0 (default): nothing is trimmed.
SERVICE_TRIM=0
