/dts-v1/;

/ {
    #address-cells = <0x1>;
    #size-cells = <0x1>;
    compatible = "anyka,ak3918ev300";
    interrupt-parent = <0x1>;
    model = "AK3918EV300 (OpenIPC)";
    version = "V1.0.00";
    adkeys {
        compatible = "anyka,ak39ev330-adckeys";
        status = "disable";
    };
    aliases {
        adkeys = "/adkeys";
        ethernet0 = "/soc/ethernet@20300000";
        gpio = "/soc/gpio@20170000";
        gpiokeys = "/gpiokeys";
        i2c0 = "/soc/i2c0@20150000";
        i2c1 = "/soc/i2c1@20190000";
        i2c2 = "/soc/i2c2@201a0000";
        intc = "/interrupt-controller";
        ir_rx = "/ir_rx";
        leds = "/leds";
        mipicsi0 = "/soc/mipicsi0@20400000";
        mmc0 = "/soc/mmc0@20100000";
        mmc1 = "/soc/mmc1@20108000";
        motor0 = "/motor0";
        motor1 = "/motor1";
        pwm0 = "/pwm0";
        pwm1 = "/pwm1";
        pwm2 = "/pwm2";
        pwm3 = "/pwm3";
        pwm4 = "/pwm4";
        rtc = "/rtc";
        spi0 = "/soc/spi0@20120000";
        spi1 = "/soc/spi1@20128000";
        uart0 = "/soc/uart0@20130000";
        uart1 = "/soc/uart1@20138000";
        usb = "/soc/usb@20200000";
        watchdog = "/watchdog";
    };
    battery {
        compatible = "anyka,ak39-battery";
        status = "disable";
    };
    chosen {
        bootargs = "console=ttySAK0,115200n8 mem=64M root=/dev/ram0 rdinit=/init initrd=0x80900000,3491008 mtdparts=spi0.0:8192k(all)ro initcall_blacklist=gpio_keys_init panic=0 loglevel=7";
    };
    clocks {
        clk_asic {
            #clock-cells = <0x1>;
            clock-id = <0x0 0x1>;
            clock-output-names = "adchs", "dachs";
            clocks = <0x20>;
            compatible = "anyka,ak39ev330-factor-clk";
            linux,phandle = <0xb>;
            phandle = <0xb>;
        };
        clk_peri {
            #clock-cells = <0x1>;
            clock-id = <0x2 0x3 0x4 0x5 0x6>;
            clock-output-names = "csi_sclk", "csi_pclk", "dsi_pclk", "opclk", "usb_phy";
            clocks = <0x21>;
            compatible = "anyka,ak39ev330-factor-clk";
            linux,phandle = <0x14>;
            phandle = <0x14>;
        };
        clk_saradc {
            #clock-cells = <0x1>;
            clock-id = <0x9>;
            clock-output-names = "saradc";
            clocks = <0x22>;
            compatible = "anyka,ak39ev330-factor-clk";
            linux,phandle = <0xe>;
            phandle = <0xe>;
        };
        clk_sdadc_sddac {
            #clock-cells = <0x1>;
            clock-id = <0x7 0x8>;
            clock-output-names = "clk_sdadc", "clk_sddac";
            clocks = <0x20>;
            compatible = "anyka,ak39ev330-factor-clk";
            linux,phandle = <0xa>;
            phandle = <0xa>;
        };
        core_pll {
            #clock-cells = <0x0>;
            clock-div-n = <0x3>;
            clock-div-od = <0x0>;
            clock-frequency = <0x2625a000>;
            clock-id = <0x3>;
            clock-output-names = "core_pll";
            clocks = <0x1f>;
            compatible = "anyka,ak39ev330-fixed-clk";
            linux,phandle = <0x20>;
            phandle = <0x20>;
        };
        cpu_pll {
            #clock-cells = <0x1>;
            clock-id = <0x0 0x1 0x2>;
            clock-output-names = "jclk", "hclk", "dphy";
            clocks = <0x1f>;
            compatible = "anyka,ak39ev330-fixed-clk";
        };
        gclk_asic {
            #clock-cells = <0x1>;
            clock-ctrlbit = [00 00 00 01 00 00 00 02 00 00 00 03 00 00 00 04 00 00 00 05 00 00 00 06 00 00 00 07 00 00 00 08 00 00 00 09 00 00 00 0a 00 00 00 0b 00 00 00 0c 00 00 00 0d 00 00 00 0e 00 00 00 0f 00 00 00 10 00 00 00 11 00 00 00 13 00 00 00 14 00 00 00 1f 00 00 00 12];
            clock-output-names = "mmc0", "mmc1", "adc", "dac", "spi0", "spi1", "uart0", "uart1", "l2buffer", "i2c0", "irda", "gpio", "ethernet", "encrypt", "usb-otg", "mipi", "i2c1", "isp", "vencoder", "i2c2", "sensor-sclk";
            clocks = <0x20>;
            compatible = "anyka,ak39ev330-gate-clk";
            linux,phandle = <0x5>;
            phandle = <0x5>;
        };
        osc12M {
            #clock-cells = <0x0>;
            clock-frequency = <0xb71b00>;
            clock-output-names = "osc12M";
            clocks = <0x1f>;
            compatible = "fixed-clock";
            linux,phandle = <0x22>;
            phandle = <0x22>;
        };
        osc24M {
            #clock-cells = <0x0>;
            clock-frequency = <0x16e3600>;
            clock-output-names = "osc24M";
            compatible = "fixed-clock";
            linux,phandle = <0x1f>;
            phandle = <0x1f>;
        };
        osc32K {
            #clock-cells = <0x0>;
            clock-frequency = <0x8000>;
            clock-output-names = "osc32K";
            compatible = "fixed-clock";
        };
        peri_pll {
            #clock-cells = <0x0>;
            clock-div-n = <0x2>;
            clock-div-od = <0x1>;
            clock-frequency = <0x23c34600>;
            clock-id = <0x4>;
            clock-output-names = "peri_pll";
            clocks = <0x1f>;
            compatible = "anyka,ak39ev330-fixed-clk";
            linux,phandle = <0x21>;
            phandle = <0x21>;
        };
        uv_det_pd {
            compatible = "anyka,ak39ev330-uv_det_pd";
            enable = <0x1>;
            status = "okay";
            threshold = <0x2>;
        };
    };
    cpus {
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        cpu@0 {
            bus-frequency = <0x0>;
            clock-frequency = <0x0>;
            compatible = "arm, arm926ej-s";
            d-cache-line-size = <0x20>;
            d-cache-size = <0x8000>;
            device_type = "cpu";
            i-cache-line-size = <0x20>;
            i-cache-size = <0x8000>;
            reg = <0x0>;
            timebase-frequency = <0x0>;
        };
    };
    crc {
        compatible = "anyka,ak39ev330-crc";
        status = "disable";
    };
    gpiokeys {
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        compatible = "anyka,ak39ev330-gpiokeys";
        pinctrl-0 = <0x1c>;
        pinctrl-names = "default";
        status = "okay";
        key_detect {
            debounce-interval = <0x64>;
            gpios = <0xd 0x54 0x1>;
            label = "key_detect";
            linux,code = <0x74>;
            wakeup-source;
        };
    };
    interrupt-controller {
        #interrupt-cells = <0x2>;
        bank_irqs = <0x17 0x10>;
        compatible = "anyka,ak39ev330-ic";
        interrupt-controller;
        linux,phandle = <0x1>;
        phandle = <0x1>;
    };
    ion {
        #address-cells = <0x1>;
        #size-cells = <0x1>;
        compatible = "anyka,ak39ev330-ion-reserve";
        heaps-nr = <0x1>;
        memory-region = <0x6>;
        ranges;
        status = "disabled";
        dma_reserved_heap {
            align = <0x4>;
            base-address = <0x81400000>;
            compatible = "anyka,dma-reserve";
            ion-id = <0x1>;
            ion-type = <0x1>;
            size = <0x2000000>;
            status = "okay";
        };
    };
    ir_rx {
        status = "disable";
    };
    ircut {
        compatible = "anyka,ak39ev330-ircut";
        ircut-a = "0";
        ircut-a-day-level = "0";
        pinctrl-0 = <0x1a>;
        pinctrl-names = "default";
        status = "okay";
    };
    leds {
        compatible = "anyka,ak39ev330-leds";
        pinctrl-0 = <0x1b>;
        pinctrl-names = "default";
        status = "okay";
        ir_led {
            gpios = <0xd 0x5 0x0>;
            label = "irled";
        };
    };
    memory {
        device_type = "memory";
        reg = <0x80000000 0x4000000>;
    };
    motor0 {
        attach-timer = <0x2>;
        boundary-steps = <0x32>;
        compatible = "anyka,ak39ev330-motor0";
        part-number = "HZF-24BYJ48";
        pinctrl-0 = <0x1d>;
        pinctrl-names = "default";
        pwm-pins = <0x44 0x9 0x8 0x7>;
        pwm-tbl-cw = <0x9 0x1 0x3 0x2 0x6 0x4 0xc 0x8>;
        speed-step = <0xc8>;
        status = "disable";
        steps-one-circle = <0x1000>;
        total-steps = <0x9c4>;
    };
    motor1 {
        attach-timer = <0x3>;
        boundary-steps = <0x32>;
        compatible = "anyka,ak39ev330-motor1";
        part-number = "HZF-24BYJ48";
        pinctrl-0 = <0x1e>;
        pinctrl-names = "default";
        pwm-pins = <0x6 0x43 0x42 0x41>;
        pwm-tbl-cw = <0x9 0x1 0x3 0x2 0x6 0x4 0xc 0x8>;
        speed-step = <0xc8>;
        status = "disable";
        steps-one-circle = <0x1000>;
        total-steps = <0x258>;
    };
    photosensitive {
        compatible = "anyka,ak39ev330-photosensitive";
        photosensitive-day-level = "high";
        photosensitive-higher-level = "900";
        photosensitive-lower-level = "400";
        photosensitive-port = "saradc0";
        status = "okay";
    };
    pwm0 {
        compatible = "anyka,ak39ev330-pwm0";
        duty-ns = <0x7a120>;
        period-ns = <0xf4240>;
        pinctrl-names = "default";
        pwm-enable = <0x1>;
        status = "disable";
    };
    pwm1 {
        compatible = "anyka,ak39ev330-pwm1";
        duty-ns = <0x7a120>;
        period-ns = <0xf4240>;
        pinctrl-names = "default";
        pwm-enable = <0x1>;
        status = "disable";
    };
    pwm2 {
        compatible = "anyka,ak39ev330-pwm2";
        duty-ns = <0x7a120>;
        period-ns = <0xf4240>;
        pinctrl-names = "default";
        pwm-enable = <0x1>;
        status = "disable";
    };
    pwm3 {
        compatible = "anyka,ak39ev330-pwm3";
        duty-ns = <0x7a120>;
        period-ns = <0xf4240>;
        pinctrl-names = "default";
        pwm-enable = <0x1>;
        status = "disable";
    };
    pwm4 {
        compatible = "anyka,ak39ev330-pwm4";
        duty-ns = <0x7a120>;
        period-ns = <0xf4240>;
        pinctrl-names = "default";
        pwm-enable = <0x1>;
        status = "disable";
    };
    ramdisk {
        compatible = "anyka,ak39ev330-ramdisk";
        status = "disabled";
    };
    reserved-memory {
        #address-cells = <0x1>;
        #size-cells = <0x1>;
        ranges;
        dma_reserved@0x81400000 {
            compatible = "shared-dma-pool";
            linux,phandle = <0x6>;
            no-map;
            phandle = <0x6>;
            reg = <0x81400000 0x1800000>;
            size = <0x1800000>;
            status = "okay";
        };
    };
    rtc {
        adjust-time = <0x1d4c0>;
        compatible = "anyka,ak39ev330-rtc";
        osc-select = <0x1>;
        status = "okay";
    };
    soc {
        #address-cells = <0x1>;
        #size-cells = <0x1>;
        compatible = "simple-bus";
        ranges;
        adc_dac@20110000 {
            clock-names = "sdadc_gclk", "sdadc_clk", "sdadchs_clk", "sddac_gclk", "sddac_clk", "sddachs_clk";
            clocks = <0x5 0x2 0xa 0x0 0xb 0x0 0x5 0x3 0xa 0x1 0xb 0x1>;
            compatible = "anyka,ak39ev330-adc-dac";
            interrupts = <0x6 0x0 0x7 0x0>;
            pinctrl-0 = <0xc>;
            pinctrl-names = "default";
            reg = <0x8000000 0xffff 0x20110000 0x7fff>;
            speak-gpios = <0xd 0x4f 0x1>;
            speak-gpios-en = <0x1>;
            status = "okay";
        };
        dram-controller@21000000 {
            compatible = "anyka,ak39ev330-dram-controller";
            reg = <0x21000000 0xffffff>;
            status = "disable";
        };
        encrypt@20180000 {
            clocks = <0x5 0xd>;
            compatible = "anyka,ak39ev330-encrypt";
            encrypt-mode = <0x1>;
            interrupts = <0x11 0x0>;
            reg = <0x20180000 0xffff>;
            status = "okay";
        };
        ethernet@20300000 {
            clock-names = "ethernet", "opclk";
            clocks = <0x5 0xc 0x14 0x3>;
            compatible = "anyka,ak39ev330-ethernet";
            interrupts = <0x10 0x0>;
            mac-address = [00 00 00 00 00 00];
            phy-address = <0x1>;
            pinctrl-0 = <0x15>;
            pinctrl-names = "default";
            reg = <0x20300000 0x1fff>;
            status = "okay";
        };
        gpio@20170000 {
            #gpio-cells = <0x2>;
            #interrupt-cells = <0x2>;
            clocks = <0x5 0xb>;
            compatible = "anyka,ak39ev330-gpio";
            gpio-controller;
            interrupt-controller;
            interrupts = <0xf 0x0>;
            linux,phandle = <0xd>;
            phandle = <0xd>;
            reg = <0x20170000 0xffff 0x20400000 0x1000 0x20480000 0x1000>;
            status = "okay";
            csi0_sclk_pin {
                anyka,function = <0x0>;
                anyka,pins = <0x40>;
                anyka,pull = <0x1>;
                linux,phandle = <0x18>;
                phandle = <0x18>;
            };
            csi1_sclk_pin {
                anyka,function = <0x2>;
                anyka,pins = <0x3>;
                anyka,pull = <0x1>;
                linux,phandle = <0x19>;
                phandle = <0x19>;
            };
            dvp0_10bits_pins {
                anyka,function = <0x0>;
                anyka,map = <0x49 0x4b 0x48 0x4a 0x46 0x47 0x47 0x46 0x4a 0x48 0x4b 0x49>;
                anyka,pins = <0x8 0x9 0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b>;
                anyka,pull = <0x1>;
                linux,phandle = <0x2>;
                phandle = <0x2>;
            };
            dvp0_12bits_pins {
                anyka,function = <0x0>;
                anyka,map = <0x49 0x4b 0x48 0x4a 0x46 0x47 0x47 0x46 0x4a 0x48 0x4b 0x49>;
                anyka,pins = <0x6 0x7 0x8 0x9 0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b>;
                anyka,pull = <0x1>;
                linux,phandle = <0x16>;
                phandle = <0x16>;
            };
            dvp0_8bits_pins {
                anyka,function = <0x0>;
                anyka,map = <0x49 0x4b 0x48 0x4a 0x46 0x47 0x47 0x46 0x4a 0x48 0x4b 0x49>;
                anyka,pins = <0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b>;
                anyka,pull = <0x1>;
                linux,phandle = <0x17>;
                phandle = <0x17>;
            };
            ethernet_pins_rmii {
                anyka,function = <0x1>;
                anyka,pins = <0xa 0xb 0xd 0xe 0xf 0x13 0x14 0x17 0x18 0x2f>;
                anyka,pull = <0x11 0x10 0x11 0x11 0x11 0x11 0x11 0x11 0x11 0x1>;
                linux,phandle = <0x15>;
                phandle = <0x15>;
            };
            gpiokey_pins {
                anyka,function = <0x0>;
                anyka,pins = <0x54>;
                anyka,pull = <0x10>;
                linux,phandle = <0x1c>;
                phandle = <0x1c>;
            };
            i2c0_pins {
                anyka,function = <0x1>;
                anyka,pins = <0x1b 0x1c>;
                anyka,pull = <0x10>;
                linux,phandle = <0x12>;
                phandle = <0x12>;
            };
            ircut_pins {
                anyka,function = <0x0>;
                anyka,pins = <0x0>;
                anyka,pull = <0x10>;
                linux,phandle = <0x1a>;
                phandle = <0x1a>;
            };
            led_pins {
                anyka,function = <0x0>;
                anyka,pins = <0x5>;
                anyka,pull = <0x10>;
                linux,phandle = <0x1b>;
                phandle = <0x1b>;
            };
            mci0_pins {
                anyka,function = <0x1 0x1 0x1 0x1 0x2 0x2>;
                anyka,pins = <0x1f 0x20 0x21 0x22 0x50 0x51>;
                anyka,pull = <0x10>;
                linux,phandle = <0x8>;
                phandle = <0x8>;
            };
            mci1_pins {
                anyka,function = <0x1 0x1 0x2 0x2 0x2 0x2>;
                anyka,pins = <0x29 0x2a 0x18 0x17 0x14 0x13>;
                anyka,pull = <0x10>;
                linux,phandle = <0x9>;
                phandle = <0x9>;
            };
            mipi0_1lane_pins {
                anyka,function = <0x3 0x3 0x3 0x2 0x2 0x2>;
                anyka,pins = <0x46 0x47 0x48 0x49 0x4a 0x4b>;
                anyka,pull = <0x10>;
                linux,phandle = <0x3>;
                phandle = <0x3>;
            };
            mipi0_2lane_pins {
                anyka,function = <0x3 0x3 0x3 0x2 0x2 0x2>;
                anyka,pins = <0x46 0x47 0x48 0x49 0x4a 0x4b>;
                anyka,pull = <0x10>;
                linux,phandle = <0x4>;
                phandle = <0x4>;
            };
            motor0_pins {
                anyka,function = <0x1>;
                anyka,pins = <0x44 0x9 0x8 0x7>;
                anyka,pull = <0x10>;
                linux,phandle = <0x1d>;
                phandle = <0x1d>;
            };
            motor1_pins {
                anyka,function = <0x1>;
                anyka,pins = <0x6 0x43 0x42 0x41>;
                anyka,pull = <0x10>;
                linux,phandle = <0x1e>;
                phandle = <0x1e>;
            };
            phy_reset_pins {
                anyka,function = <0x0>;
                anyka,pins = <0x52>;
                anyka,pull = <0x10>;
            };
            speak_en_pins {
                anyka,function = <0x0>;
                anyka,pins = <0x4f>;
                anyka,pull = <0x10>;
                linux,phandle = <0xc>;
                phandle = <0xc>;
            };
            spiflash_pins {
                anyka,function = <0x1 0x1 0x2 0x2>;
                anyka,pins = <0x19 0x1a 0x23 0x24>;
                anyka,pull = <0x10>;
                linux,phandle = <0xf>;
                phandle = <0xf>;
            };
            uart0_pins {
                anyka,function = <0x1>;
                anyka,pins = <0x1 0x2>;
                anyka,pull = <0x10>;
                linux,phandle = <0x10>;
                phandle = <0x10>;
            };
            uart1_pins {
                anyka,function = <0x2>;
                anyka,pins = <0x0 0x5>;
                anyka,pull = <0x10>;
                linux,phandle = <0x11>;
                phandle = <0x11>;
            };
        };
        i2c0@20150000 {
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            clock-frequency = <0x4c2c0>;
            clocks = <0x5 0x9>;
            compatible = "anyka,ak3918ev300-i2c";
            interrupts = <0xd 0x0>;
            pinctrl-0 = <0x12>;
            pinctrl-names = "default";
            reg = <0x20150000 0xffff>;
            sda-delay = <0x64>;
            status = "okay";
            camera@0x30 {
                compatible = "anyka,sensor0";
                pwdn-gpio = <0xd 0xffff 0x1>;
                reg = <0x30>;
                reset-gpio = <0xd 0x31 0x1>;
                port {
                    endpoint@0 {
                        linux,phandle = <0x7>;
                        phandle = <0x7>;
                        remote-endpoint = <0x13>;
                    };
                };
            };
        };
        i2c1@20190000 {
            clock-frequency = <0x4c2c0>;
            clocks = <0x5 0x10>;
            compatible = "anyka,ak39ev330-i2c1";
            interrupts = <0x14 0x0>;
            pinctrl-names = "default";
            reg = <0x20190000 0xffff>;
            sda-delay = <0x64>;
            status = "disabled";
        };
        i2c2@201a0000 {
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            clock-frequency = <0x4c2c0>;
            clocks = <0x5 0x13>;
            compatible = "anyka,ak39ev330-i2c2";
            interrupts = <0x1d 0x0>;
            pinctrl-names = "default";
            reg = <0x201a0000 0xffff>;
            sda-delay = <0x64>;
            status = "disabled";
        };
        irda@20160000 {
            compatible = "anyka,ak39ev330-irda";
            interrupts = <0xe 0x0>;
            reg = <0x20160000 0xffff>;
            status = "disable";
        };
        isp@20000000 {
            clock-names = "camera";
            clocks = <0x5 0x11>;
            compatible = "anyka,ak39ev330-isp";
            interrupts = <0x1 0x0>;
            mclk-mhz = <0x18>;
            memory-region = <0x6>;
            pinctrl-0 = <0x2>;
            pinctrl-1 = <0x3>;
            pinctrl-2 = <0x4>;
            pinctrl-names = "default", "mipi0_1lane", "mipi0_2lane";
            reg = <0x20000000 0xffff>;
            status = "okay";
            port {
                endpoint {
                    linux,phandle = <0x13>;
                    phandle = <0x13>;
                    remote-endpoint = <0x7>;
                };
            };
        };
        l2-buffer@20140000 {
            clocks = <0x5 0x8>;
            compatible = "anyka,ak39ev330-l2-dma";
            interrupts = <0xc 0x0>;
            reg = <0x20140000 0xffff>;
            status = "disable";
        };
        mipicsi0@20400000 {
            clock-names = "mipi_csi_clk";
            clocks = <0x5 0xf>;
            compatible = "anyka,ak39ev330-mipi-csi0";
            reg = <0x20400000 0x7ffff>;
            status = "okay";
        };
        mmc0@20100000 {
            bus-width = <0x4>;
            cap-sd-highspeed;
            cd_clk;
