+struct ak_codec_ops ak39_codec_ops = {
+	.dac_init		= ak39_codec_dac_open,
+	.dac_exit		= ak39_codec_dac_close,
+	.adc_init		= ak39_codec_adc2_open,
+	.adc_exit		= ak39_codec_adc2_close,
+	.set_dac_samplerate	= ak39_codec_set_dac_samplerate,
+	.set_adc_samplerate	= ak39_codec_set_adc2_samplerate,
+	.set_dac_channels	= ak39_codec_set_dac_channels,
+	.set_adc_channels	= ak39_codec_set_adc2_channels,
+	.playback_start		= ak39_codec_playback_start,
+	.playback_end		= ak39_codec_playback_stop,
+	.speaker_enable		= ak39_codec_speaker_enable,
+	.capture_start		= ak39_codec_capture_start,
+	.capture_end		= ak39_codec_capture_stop,
+	.start_to_play		= ak39_start_to_play,
+};
+
+
+static struct clk *ak39_codec_get_clk(struct device *dev, const char *name)
+{
+	struct clk *clk = devm_clk_get_optional(dev, name);
+
+	if (!IS_ERR_OR_NULL(clk)) {
+		clk_prepare_enable(clk);
+		return clk;
+	}
+	return NULL;
+}
+
+static int ak39_codec_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	int err = 0;
+	int i;
+	struct ak39_codec *codec;
+	struct resource *res;
+
+	codec = kzalloc(sizeof(*codec), GFP_KERNEL);
+	if (!codec)
+		return -ENOMEM;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res) {
+		dev_err(&pdev->dev, "no memory resource for analog_ctrl_res\n");
+		err = -ENXIO;
+		goto out_free_codec;
+	}
+
+	codec->analog_ctrl_base = ioremap(res->start, resource_size(res));
+	if (!codec->analog_ctrl_base) {
+		dev_err(&pdev->dev, "could not remap analog_ctrl_res memory\n");
+		err = -ENXIO;
+		goto out_free_codec;
+	}
+
+	/* ADC2/DAC digital block */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!res) {
+		dev_err(&pdev->dev, "no memory resource for adda_cfg_res\n");
+		err = -ENXIO;
+		goto out_unremap_analog;
+	}
+	codec->adda_cfg_base = ioremap(res->start, resource_size(res));
+	if (!codec->adda_cfg_base) {
+		dev_err(&pdev->dev, "could not remap adda_cfg_res memory\n");
+		err = -ENXIO;
+		goto out_unremap_analog;
+	}
+
+	codec->sdadc_gclk = ak39_codec_get_clk(&pdev->dev, "sdadc_gclk");
+	codec->sdadc_clk = ak39_codec_get_clk(&pdev->dev, "sdadc_clk");
+	codec->sdadchs_clk = ak39_codec_get_clk(&pdev->dev, "sdadchs_clk");
+	codec->sddac_gclk = ak39_codec_get_clk(&pdev->dev, "sddac_gclk");
+	codec->sddac_clk = ak39_codec_get_clk(&pdev->dev, "sddac_clk");
+	codec->sddachs_clk = ak39_codec_get_clk(&pdev->dev, "sddachs_clk");
+
+	for(i=0; i<MIXER_PORT_VOL_COUNT; i++) {
+		set_mixer_volume(codec, i, get_volume_info(i, VOL_INFO_DEFAULT));
+		ak39_set_gain(codec, i, get_mixer_volume(codec, i));
+	}
+
+	for(i=0; i<MIXER_DST_COUNT; i++) {
+		set_route_src_on_dst(codec, i, default_route[i], SOURCE_MIXED_ALL_MASK);
+	}
+
+	/*only a hp output at arch-ak39*/
+	codec->mixer_outmode[MIXER_ADDR_OUTMODE_DAC] = OUTMODE_HP;
+	codec->mixer_ch_duration[MIXER_ADDR_PLAY_DURATION] = CHNLDURATION_CONSTANT;
+
+	/*FIXME:can add the code for worker vaild when switch auto mode*/
+	INIT_DELAYED_WORK(&codec->d_work, hp_det_worker);
+
+	codec->playmode = PLAYMODE_AUTO_SWITCH;
+	of_property_read_u32(np, "anyka,playback-mode", (u32 *)&codec->playmode);
+
+	/* speaker shutdown/enable gpio -- optional, board-dependent */
+	codec->spkrshdn_gpio = of_get_named_gpio(np, "speak-gpios", 0);
+	codec->spk_gpios_en = 1;
+	of_property_read_u32(np, "speak-gpios-en", (u32 *)&codec->spk_gpios_en);
+	if (gpio_is_valid(codec->spkrshdn_gpio)) {
+		err = gpio_request_one(codec->spkrshdn_gpio,
+				codec->spk_gpios_en ? GPIOF_OUT_INIT_LOW
+						     : GPIOF_OUT_INIT_HIGH,
+				"ak39-codec-spk");
+		if (err) {
+			dev_err(&pdev->dev, "failed to request speak-gpios\n");
+			goto out_unremap_adda;
+		}
+	}
+
+	/* headphone detect gpio -- optional, board-dependent */
+	codec->hpdet_gpio = of_get_named_gpio(np, "hpdet-gpios", 0);
+	codec->hp_on_value = 0;
+	of_property_read_u32(np, "hpdet-active-level", (u32 *)&codec->hp_on_value);
+
+	if (gpio_is_valid(codec->hpdet_gpio)) {
+		err = gpio_request_one(codec->hpdet_gpio, GPIOF_IN,
+					"ak39-codec-hpdet");
+		if (err) {
+			dev_err(&pdev->dev, "failed to request hpdet-gpios\n");
+			goto out_free_spk_gpio;
+		}
+
+		codec->hp_det_irq = gpio_to_irq(codec->hpdet_gpio);
+
+		if(0 == codec->hp_on_value)
+			codec->irq_hp_on_type = IRQ_TYPE_LEVEL_LOW;
+		else
+			codec->irq_hp_on_type = IRQ_TYPE_LEVEL_HIGH;
+
+		set_hpdet_status(codec);
+		err = request_irq(codec->hp_det_irq, ak39_codec_hpdet_irq,
+			   	0, pdev->name, codec);
+		if(err)
+		{
+			dev_err(&pdev->dev, "request irq error!\n");
+			goto out_free_hpdet_gpio;
+		}
+	}
+
+	codec->dai.ops = &ak39_codec_ops;
+	codec->dai.num_kcontrols = ARRAY_SIZE(codec_controls);
+	codec->dai.kcontrols = codec_controls;
+	codec->dai.num_pentries = ARRAY_SIZE(codec_pentries);
+	codec->dai.pentries = codec_pentries;
+	codec->dai.entries_private = codec;
+
+	err = ak_codec_register(&codec->dai);
+	if (err) {
+		goto out_free_irq;
+	}
+
+	/* headphone de-pipa mute gpio -- optional, board-dependent */
+	codec->hpmute_gpio = of_get_named_gpio(np, "hpmute-gpios", 0);
+	codec->hpmute_en_val = 1;
+	of_property_read_u32(np, "hpmute-active-level", (u32 *)&codec->hpmute_en_val);
+	codec->used_hp_mute = gpio_is_valid(codec->hpmute_gpio);
+
+	if(codec->used_hp_mute){
+		err = gpio_request_one(codec->hpmute_gpio,
+				codec->hpmute_en_val ? GPIOF_OUT_INIT_LOW
+						      : GPIOF_OUT_INIT_HIGH,
+				"ak39-codec-hpmute");
+		if (err) {
+			dev_err(&pdev->dev, "failed to request hpmute-gpios\n");
+			goto out_free_irq;
+		}
+	}
+
+	codec->outputing = false;
+
+	platform_set_drvdata(pdev, codec);
+	return 0;
+
+out_free_irq:
+	if (gpio_is_valid(codec->hpdet_gpio))
+		free_irq(codec->hp_det_irq, codec);
+out_free_hpdet_gpio:
+	if (gpio_is_valid(codec->hpdet_gpio))
+		gpio_free(codec->hpdet_gpio);
+out_free_spk_gpio:
+	if (gpio_is_valid(codec->spkrshdn_gpio))
+		gpio_free(codec->spkrshdn_gpio);
+out_unremap_adda:
+	iounmap(codec->adda_cfg_base);
+out_unremap_analog:
+	iounmap(codec->analog_ctrl_base);
+out_free_codec:
+	kfree(codec);
+	return err;
+}
+
+static void ak39_codec_remove(struct platform_device *pdev)
+{
+	struct ak39_codec *codec = platform_get_drvdata(pdev);
+
+	if (!codec)
+		return;
+
+	if (gpio_is_valid(codec->hpdet_gpio)) {
+		free_irq(codec->hp_det_irq, codec);
+		gpio_free(codec->hpdet_gpio);
+	}
+	if (codec->used_hp_mute)
+		gpio_free(codec->hpmute_gpio);
+	if (gpio_is_valid(codec->spkrshdn_gpio))
+		gpio_free(codec->spkrshdn_gpio);
+
+	/*FIXME:can add the code for worker vaild when switch auto mode*/
+	cancel_delayed_work_sync(&codec->d_work);
+
+	if (codec->sdadc_gclk)
+		clk_disable_unprepare(codec->sdadc_gclk);
+	if (codec->sdadc_clk)
+		clk_disable_unprepare(codec->sdadc_clk);
+	if (codec->sdadchs_clk)
+		clk_disable_unprepare(codec->sdadchs_clk);
+	if (codec->sddac_gclk)
+		clk_disable_unprepare(codec->sddac_gclk);
+	if (codec->sddac_clk)
+		clk_disable_unprepare(codec->sddac_clk);
+	if (codec->sddachs_clk)
+		clk_disable_unprepare(codec->sddachs_clk);
+
+	iounmap(codec->analog_ctrl_base);
+	iounmap(codec->adda_cfg_base);
+
+	platform_set_drvdata(pdev, NULL);
+	kfree(codec);
+}
+
+static const struct of_device_id ak39_codec_of_match[] = {
+	{ .compatible = "anyka,ak39ev330-adc-dac" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ak39_codec_of_match);
+
+static struct platform_driver ak39_codec_driver = {
+	.driver	= {
+		.owner		= THIS_MODULE,
+		.name		= "ak39-codec",
+		.of_match_table	= ak39_codec_of_match,
+	},
+	.probe		= ak39_codec_probe,
+	.remove_new	= ak39_codec_remove,
+};
+module_platform_driver(ak39_codec_driver);
+
+MODULE_AUTHOR("anyka");
+MODULE_DESCRIPTION("ak39 codec Driver");
+MODULE_LICENSE("GPL");
+
