diff --git a/drivers/irqchip/irq-ak39.c b/drivers/irqchip/irq-ak39.c
new file mode 100644
index 000000000..076bff093
--- /dev/null
+++ b/drivers/irqchip/irq-ak39.c
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Anyka AK39 (AK3918EV300) interrupt controller.
+ *
+ * Module interrupts: status at SYSCTRL+0x4C, enable mask at +0x24, one bit
+ * per line (bit n = hwirq n). Line 3 is the system-control cascade, whose
+ * own interrupts (timers, RTC, GPIO...) have status at +0x30 and mask at
+ * +0x2C, bit n = hwirq n of the second domain.
+ *
+ * Register layout from the vendor/OpenIPC 4.4 driver (drivers/irqchip/ak_irq.c).
+ */
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqchip.h>
+#include <linux/irqchip/chained_irq.h>
+#include <linux/irqdomain.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <asm/exception.h>
+
+#define AK39_IRQ_MASK		0x24
+#define AK39_FIQ_MASK		0x28
+#define AK39_SYS_MASK		0x2c
+#define AK39_SYS_STATUS		0x30
+#define AK39_INT_STATUS		0x4c
+
+#define AK39_NR_IRQS		32
+#define AK39_NR_SYS_IRQS	11
+
+static void __iomem *ak39_base;
+static struct irq_domain *ak39_domain;
+static struct irq_domain *ak39_sys_domain;
+
+static void ak39_rmw(unsigned int reg, u32 clear, u32 set)
+{
+	unsigned long flags;
+	u32 v;
+
+	local_irq_save(flags);
+	v = readl_relaxed(ak39_base + reg);
+	writel_relaxed((v & ~clear) | set, ak39_base + reg);
+	local_irq_restore(flags);
+}
+
+static void ak39_mask(struct irq_data *d)
+{
+	ak39_rmw(AK39_IRQ_MASK, BIT(d->hwirq), 0);
+}
+
+static void ak39_unmask(struct irq_data *d)
+{
+	ak39_rmw(AK39_IRQ_MASK, 0, BIT(d->hwirq));
+}
+
+static struct irq_chip ak39_chip = {
+	.name		= "ak39-intc",
+	.irq_mask	= ak39_mask,
+	.irq_unmask	= ak39_unmask,
+};
+
+static void ak39_sys_mask(struct irq_data *d)
+{
+	ak39_rmw(AK39_SYS_MASK, BIT(d->hwirq), 0);
+}
+
+static void ak39_sys_unmask(struct irq_data *d)
+{
+	ak39_rmw(AK39_SYS_MASK, 0, BIT(d->hwirq));
+}
+
+static struct irq_chip ak39_sys_chip = {
+	.name		= "ak39-sysirq",
+	.irq_mask	= ak39_sys_mask,
+	.irq_unmask	= ak39_sys_unmask,
+};
+
+static void __exception_irq_entry ak39_handle_irq(struct pt_regs *regs)
+{
+	u32 pending;
+
+	for (;;) {
+		pending = readl_relaxed(ak39_base + AK39_INT_STATUS) &
+			  readl_relaxed(ak39_base + AK39_IRQ_MASK);
+		if (!pending)
+			break;
+		generic_handle_domain_irq(ak39_domain, __ffs(pending));
+	}
+}
+
+static void ak39_sys_cascade(struct irq_desc *desc)
+{
+	struct irq_chip *chip = irq_desc_get_chip(desc);
+	u32 pending;
+
+	chained_irq_enter(chip, desc);
+	pending = readl_relaxed(ak39_base + AK39_SYS_STATUS) &
+		  readl_relaxed(ak39_base + AK39_SYS_MASK) &
+		  GENMASK(AK39_NR_SYS_IRQS - 1, 0);
+	while (pending) {
+		unsigned int bit = __ffs(pending);
+
+		pending &= ~BIT(bit);
+		generic_handle_domain_irq(ak39_sys_domain, bit);
+	}
+	chained_irq_exit(chip, desc);
+}
+
+static int ak39_map(struct irq_domain *d, unsigned int virq, irq_hw_number_t hw)
+{
+	irq_set_chip_and_handler(virq, d == ak39_sys_domain ? &ak39_sys_chip : &ak39_chip,
+				 handle_level_irq);
+	irq_set_probe(virq);
+	return 0;
+}
+
+static const struct irq_domain_ops ak39_domain_ops = {
+	.map	= ak39_map,
+	.xlate	= irq_domain_xlate_onecell,
+};
+
+static int __init ak39_intc_init(struct device_node *node,
+				 struct device_node *parent)
+{
+	ak39_base = of_iomap(node, 0);
+	if (!ak39_base)
+		return -ENOMEM;
+
+	/* everything off, stale status read away */
+	writel_relaxed(0, ak39_base + AK39_IRQ_MASK);
+	writel_relaxed(0, ak39_base + AK39_FIQ_MASK);
+	writel_relaxed(0, ak39_base + AK39_SYS_MASK);
+	readl_relaxed(ak39_base + AK39_INT_STATUS);
+	readl_relaxed(ak39_base + AK39_SYS_STATUS);
+
+	ak39_domain = irq_domain_add_linear(node, AK39_NR_IRQS,
+					    &ak39_domain_ops, NULL);
+	if (!ak39_domain)
+		return -ENOMEM;
+	set_handle_irq(ak39_handle_irq);
+	return 0;
+}
+IRQCHIP_DECLARE(ak39_intc, "anyka,ak3918ev300-intc", ak39_intc_init);
+
+static int __init ak39_sysintc_init(struct device_node *node,
+				    struct device_node *parent)
+{
+	int irq;
+
+	if (!ak39_base)
+		return -EPROBE_DEFER;
+	ak39_sys_domain = irq_domain_add_linear(node, AK39_NR_SYS_IRQS,
+						&ak39_domain_ops, NULL);
+	if (!ak39_sys_domain)
+		return -ENOMEM;
+	irq = irq_of_parse_and_map(node, 0);
+	if (!irq)
+		return -EINVAL;
+	irq_set_chained_handler(irq, ak39_sys_cascade);
+	return 0;
+}
+IRQCHIP_DECLARE(ak39_sysintc, "anyka,ak3918ev300-sysintc", ak39_sysintc_init);
