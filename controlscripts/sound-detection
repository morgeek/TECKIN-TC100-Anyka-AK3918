#!/bin/sh
# sound-detection daemon for Anyka AK3918
# Monitors audio level and triggers MQTT/Recording events.

. /mnt/scripts/common_functions.sh

CONFIG_FILE="/mnt/config/sound_detection.conf"
PID_FILE="/var/run/sound-detection.pid"
LOG_FILE="/mnt/log/sound-detection.log"
STATE_FILE="/tmp/sound-detection.state"

LOG_MAX_BYTES="${LOG_MAX_BYTES:-131072}"
LOG_BACKUPS="${LOG_BACKUPS:-1}"
EVENT_COOLDOWN_SECONDS="${EVENT_COOLDOWN_SECONDS:-10}"
MIN_INTERVAL_SECONDS="${MIN_INTERVAL_SECONDS:-2}"

sanitize_positive_int()
{
    raw="$1"
    fallback="$2"
    case "$raw" in
        ''|*[!0-9]*)
            echo "$fallback"
            ;;
        *)
            echo "$raw"
            ;;
    esac
}

clamp_int()
{
    value="$(sanitize_positive_int "$1" "$2")"
    min="$2"
    max="$3"
    if [ "$value" -lt "$min" ]; then
        value="$min"
    fi
    if [ "$value" -gt "$max" ]; then
        value="$max"
    fi
    echo "$value"
}

rotate_log_if_needed()
{
    max_bytes="$(sanitize_positive_int "$LOG_MAX_BYTES" 131072)"
    backups="$(clamp_int "$LOG_BACKUPS" 0 3)"
    [ -f "$LOG_FILE" ] || return 0

    log_size="$(wc -c < "$LOG_FILE" 2>/dev/null)"
    log_size="$(sanitize_positive_int "$log_size" 0)"
    if [ "$log_size" -lt "$max_bytes" ]; then
        return 0
    fi

    if [ "$backups" -gt 0 ]; then
        idx="$backups"
        while [ "$idx" -gt 1 ]; do
            prev=$((idx - 1))
            if [ -f "${LOG_FILE}.${prev}" ]; then
                mv "${LOG_FILE}.${prev}" "${LOG_FILE}.${idx}" 2>/dev/null || true
            fi
            idx=$((idx - 1))
        done
        mv "$LOG_FILE" "${LOG_FILE}.1" 2>/dev/null || : > "$LOG_FILE"
    else
        : > "$LOG_FILE"
    fi
}

log_msg()
{
    mkdir -p "$(dirname "$LOG_FILE")" >/dev/null 2>&1 || true
    rotate_log_if_needed
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" "$1" >> "$LOG_FILE"
}

# Ensure we have a default config
if [ ! -f "$CONFIG_FILE" ]; then
    echo "ENABLE=0" > "$CONFIG_FILE"
    echo "THRESHOLD=1500" >> "$CONFIG_FILE"
    echo "INTERVAL=5" >> "$CONFIG_FILE"
fi

publish_sound_event()
{
    level="$1"
    threshold="$2"
    now_ts="$(date +%s 2>/dev/null)"
    [ -n "$now_ts" ] || now_ts=0

    # Publish to MQTT via shared function.
    publish_mqtt_event "{\"type\":\"sound\",\"ts\":$now_ts,\"level\":$level,\"threshold\":$threshold}"

    # Trigger recording if enabled.
    if [ "$(read_kv_config_value /mnt/config/recording.conf rec_motion_activated 0)" = "1" ]; then
        touch /tmp/motion_detected
    fi
}

read_level()
{
    threshold="$1"
    level=0
    if [ -c /dev/voice ]; then
        level="$(dd if=/dev/voice bs=512 count=1 2>/dev/null | hexdump -v -e '1/1 "%u\n"' | awk 'BEGIN{s=0} {v=$1-128; if(v<0)v=-v; s+=v} END{print s}')"
    elif [ -c /dev/dsp ]; then
        level="$(dd if=/dev/dsp bs=512 count=1 2>/dev/null | hexdump -v -e '1/1 "%u\n"' | awk 'BEGIN{s=0} {v=$1-128; if(v<0)v=-v; s+=v} END{print s}')"
    else
        if [ ! -f /tmp/sound_hw_missing ]; then
            log_msg "Warning: no audio device found (/dev/voice or /dev/dsp). Shim mode active."
            touch /tmp/sound_hw_missing
        fi
        if [ -f /tmp/test-sound-trigger ]; then
            level=$((threshold + 100))
            rm -f /tmp/test-sound-trigger
        fi
    fi

    level="$(sanitize_positive_int "$level" 0)"
    echo "$level"
}

run_daemon()
{
    last_event_ts=0
    cooldown_seconds="$(clamp_int "$EVENT_COOLDOWN_SECONDS" 0 300)"
    min_interval="$(clamp_int "$MIN_INTERVAL_SECONDS" 1 30)"

    while :; do
        enable="$(read_kv_config_value "$CONFIG_FILE" ENABLE 0)"
        if [ "$enable" != "1" ]; then
            # Disabled: poll the config only occasionally. This daemon is started
            # unconditionally at boot, so a tight 10s idle loop woke the 400MHz
            # core 8,640x/day for nothing; 300s cuts that ~30x while still picking
            # up an enable within 5 minutes.
            sleep 300
            continue
        fi

        threshold="$(clamp_int "$(read_kv_config_value "$CONFIG_FILE" THRESHOLD 1500)" 100 10000)"
        interval="$(clamp_int "$(read_kv_config_value "$CONFIG_FILE" INTERVAL 5)" "$min_interval" 300)"
        level="$(read_level "$threshold")"

        printf '%s\n' "$level" > "$STATE_FILE"

        if [ "$level" -gt "$threshold" ]; then
            now_ts="$(date +%s 2>/dev/null)"
            now_ts="$(sanitize_positive_int "$now_ts" 0)"

            if [ "$cooldown_seconds" -gt 0 ] && [ "$last_event_ts" -gt 0 ]; then
                if [ $((now_ts - last_event_ts)) -lt "$cooldown_seconds" ]; then
                    sleep "$interval"
                    continue
                fi
            fi

            log_msg "Triggered level=$level threshold=$threshold"
            publish_sound_event "$level" "$threshold"
            last_event_ts="$now_ts"
        fi

        sleep "$interval"
    done
}

start()
{
    if status >/dev/null 2>&1; then
        pid="$(cat "$PID_FILE" 2>/dev/null)"
        echo "Already running ($pid)"
        return 0
    fi

    rm -f "$PID_FILE" >/dev/null 2>&1 || true
    echo "Starting sound detection daemon..."
    run_daemon >/dev/null 2>&1 &
    echo "$!" > "$PID_FILE"
}

stop()
{
    killpid_graceful "$PID_FILE" 5
    echo "Stopped"
}

status()
{
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "Running (PID: $pid)"
        if [ -f "$STATE_FILE" ]; then
            read -r last_level < "$STATE_FILE"
            echo "Last Level: ${last_level:-0}"
        fi
        return 0
    fi

    rm -f "$PID_FILE" >/dev/null 2>&1 || true
    echo "Stopped"
    return 1
}

health()
{
    if status >/dev/null 2>&1; then echo "ok: running"; else echo "warn: stopped"; fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    health) health ;;
    *) echo "Usage: $0 {start|stop|status|restart|health}"; exit 1 ;;
esac
