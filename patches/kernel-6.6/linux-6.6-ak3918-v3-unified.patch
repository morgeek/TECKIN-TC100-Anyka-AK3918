+static int f22_get_fps(void)
+{
+	return g_fps;
+}
+
+static int f22_get_valid_coordinate(int *x, int *y)
+{
+	*x = SENSOR_VALID_OFFSET_X;
+	*y = SENSOR_VALID_OFFSET_Y;
