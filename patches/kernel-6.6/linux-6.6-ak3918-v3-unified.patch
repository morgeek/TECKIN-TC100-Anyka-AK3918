+static int __init alsa_card_akpcm_init(void)
+{
+	int err;
+
+	err = platform_device_register(&snd_akpcm_device);
+	if (err < 0)
+		return err;
+
+	err = platform_driver_register(&snd_akpcm_driver);
+	if (err < 0) {
+		platform_device_unregister(&snd_akpcm_device);
+		return err;
+	}
+
+	register_reboot_notifier(&akpcm_reboot_notifier);
+
+	return 0;
+}
