#!/bin/sh
# Linux 6.6 (3.0): the vendor RTSP server is replaced by tc100_rtsp. This keeps the control-script interface
# (start|stop|restart|status|health|watchdog) so the web UI (Services, Video streams "Apply") and the watchdog work.
# (3.0 has no vendor RTSP server: it needed the vendor libraries and would fight tc100_rtsp for the encoder;
# the 2.x script is on the 2.x branch).
# One restarter: scripts/service-watchdog.sh (pid file /var/run/v4l2rtspserver-watch.pid) checks the pid written by
# rtsp-launch.sh (/var/run/v4l2rtspserver.pid) every 60 s and runs "start" when tc100_rtsp is gone. memory-guard
# leaves services that have their own watchdog alone.
SERVICE_NAME="RTSP server (tc100_rtsp)"
PIDFILE=/var/run/v4l2rtspserver.pid
WATCHDOG_PIDFILE=/var/run/v4l2rtspserver-watch.pid

launcher() {
  for l in /mnt/tc100test/rtsp-launch.sh /mnt/v3/linux66-sd/rtsp-launch.sh; do
    [ -f "$l" ] && { echo "$l"; return 0; }
  done
  return 1
}
alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
# the pid file (written by rtsp-launch.sh) is what the Services page reads; refreshed when tc100_rtsp was restarted
status() {
  p=$(cat "$PIDFILE" 2>/dev/null)
  alive "$p" && { echo "PID: $p"; return 0; }
  for p in $(pidof tc100_rtsp 2>/dev/null); do echo "$p" > "$PIDFILE"; echo "PID: $p"; return 0; done
  return 1
}
watchdog_start() {
  wp=$(cat "$WATCHDOG_PIDFILE" 2>/dev/null)
  alive "$wp" && return 0
  [ -f /mnt/scripts/service-watchdog.sh ] || return 0
  ( CHECK_TIMEOUT_SECONDS=60 exec /bin/sh /mnt/scripts/service-watchdog.sh /mnt/controlscripts/rtsp-h26x 0 status ) \
    </dev/null >/dev/null 2>&1 &
  echo $! > "$WATCHDOG_PIDFILE"
}
watchdog_stop() {
  wp=$(cat "$WATCHDOG_PIDFILE" 2>/dev/null)
  alive "$wp" && kill "$wp" 2>/dev/null
  rm -f "$WATCHDOG_PIDFILE"
}
start() {
  if [ -z "$(status)" ]; then
    l=$(launcher) || { echo "no rtsp-launch.sh" >&2; return 1; }
    sh "$l" </dev/null >/dev/null 2>&1
  else
    # already running (boot): make sure the pid file the watchdog and the web UI read is right
    pidof tc100_rtsp 2>/dev/null | awk '{print $1}' > "$PIDFILE"
  fi
  watchdog_start
  [ -n "$(status)" ]
}
stop() {
  watchdog_stop
  # SIGTERM, then up to 5 s for the recorder to close its file, then SIGKILL
  killall tc100_rtsp 2>/dev/null
  i=0; while pidof tc100_rtsp >/dev/null && [ $i -lt 10 ]; do sleep 0.5; i=$((i+1)); done
  killall -9 tc100_rtsp 2>/dev/null
  rm -f "$PIDFILE"
  return 0
}
health() {
  [ -n "$(status)" ] || return 1
  port=$(sed -n 's/^PORT=//p' /mnt/config/rtspserver.conf 2>/dev/null | head -n 1)
  case "$port" in ''|*[!0-9]*) port=554 ;; esac
  r=$(printf 'DESCRIBE rtsp://127.0.0.1:%s/video0_unicast RTSP/1.0\r\nCSeq: 1\r\nAccept: application/sdp\r\n\r\n' "$port" |
      nc -w 3 127.0.0.1 "$port" 2>/dev/null)
  case "$r" in *'RTSP/1.0 401'*|*'RTSP/1.0 200 OK'*) echo HEALTHY; return 0 ;; esac
  return 1
}
case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  health) health ;;
  watchdog) watchdog_start ;;   # boot: tc100_rtsp was started by autorun-linux66.sh, add its restarter
  *) echo "Usage: $0 {start|stop|status|restart|health|watchdog}" >&2; exit 1 ;;
esac
