+    	|  (LOW_BITS(fcs->fcs_uv_nr_enable, 1) <<FCS_UV_NR_EN));
+    isp->reg_blkaddr5[R5_ENABLE] = cmd;
+
+	ak_isp_vo_update_setting();
+	
+    return 0;
