#!/bin/sh
# WebRTC live view (item 35): tc100-whep, the WHEP gateway. The web page (and any WHEP client) plays the camera's H.264
# stream over WebRTC with about 150 ms of delay; the daemon takes the RTP packets from tc100_rtsp on the loopback and
# sends them SRTP-protected (src/whep, docs/linux-port/whep-design.md). It starts at boot by default: set WHEP=0 in
# boot.conf to disable it (the Services page "Boot" toggle writes this one switch; autorun-linux66.sh reads it).
# Start/Stop here act immediately; stopping it does not change the boot setting.
# The other keys of boot.conf are read at each start: WHEP_STREAM (sub|main), WHEP_MAX (1-2), WHEP_AUDIO (0|1).
# The browser reaches it through www/cgi-bin/whep.cgi, behind the web login; the daemon itself listens on 127.0.0.1.
SERVICE_NAME="WebRTC live view (WHEP)"
PIDFILE="/var/run/whep.pid"
BIN=/mnt/ext/bin/tc100-whep
LOG=/tmp/logs/whep.log

. /mnt/scripts/common_functions.sh

status()
{
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  if kill -0 "$pid" 2>/dev/null && grep -q whep "/proc/$pid/cmdline" 2>/dev/null; then
    echo "PID: $pid"
    return 0
  fi
  rm -f "$PIDFILE"
  return 1
}

# value of a boot.conf key (last line wins, quotes removed) or the default
bc()
{
  _v=$(sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" /mnt/config/boot.conf 2>/dev/null | tail -n 1)
  [ -n "$_v" ] && echo "$_v" || echo "$2"
}

start()
{
  [ -n "$(status)" ] && return 0
  [ -x "$BIN" ] || { echo "tc100-whep is not installed ($BIN): the base image has no WebRTC gateway" >&2; return 1; }
  _stream=$(bc WHEP_STREAM sub); case "$_stream" in sub|main) ;; *) _stream=sub ;; esac
  _max=$(bc WHEP_MAX 2); case "$_max" in 1|2) ;; *) _max=2 ;; esac
  _aud=$(bc WHEP_AUDIO 1); case "$_aud" in 0|no|off|false) _aud=0 ;; *) _aud=1 ;; esac
  _port=$(sed -n 's/^PORT=\([0-9][0-9]*\).*/\1/p' /mnt/config/rtspserver.conf 2>/dev/null | head -n 1)
  _ruser=$(sed -n 's/^RTSP_USER=\([A-Za-z0-9_.-]*\)$/\1/p' /mnt/config/rtsp.env 2>/dev/null | tail -n 1)
  mkdir -p /tmp/logs
  "$BIN" -i wlan0,eth0 -s "$_stream" -m "$_max" -a "$_aud" -r "${_port:-554}" -U "${_ruser:-root}" \
    -w /mnt/config/user.pwd -c /mnt/config </dev/null >>"$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  sleep 2	# the first start makes the certificate (about a second)
  [ -n "$(status)" ]
}

stop()
{
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  case "$pid" in ''|*[!0-9]*) ;; *) kill "$pid" 2>/dev/null ;; esac
  rm -f "$PIDFILE"
  return 0
}

health()
{
  if [ -n "$(status)" ]; then echo "ok: running"; else echo "warn: stopped"; fi
}

# restart = stop then start: service-watchdog, memory-guard, the MQTT bridge, the config import and the Settings
# pages call it (it was missing here: the call did nothing, rc27 tester R5)
restart() { stop; start; }

if [ $# -eq 0 ]; then
  start
else
  case $1 in start|stop|status|health|restart)
    $1
    ;;
  esac
fi
