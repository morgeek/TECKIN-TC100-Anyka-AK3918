+static struct clk *ak39_codec_get_clk(struct device *dev, const char *name)
+{
+	struct clk *clk = devm_clk_get_optional(dev, name);
+
+	if (!IS_ERR_OR_NULL(clk)) {
+		clk_prepare_enable(clk);
+		return clk;
+	}
+	return NULL;
+}
