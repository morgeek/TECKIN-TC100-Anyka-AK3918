#!/bin/sh
SERVICE_NAME="Black and White"
export LD_LIBRARY_PATH='/mnt/lib/:/lib/:/usr/lib/'

. /mnt/scripts/common_functions.sh

status()
{
  state=$(black_white status)
  if [ "$state" = "ON" ] || [ "$state" = "on" ]; then
    echo "PID: OK" 
  fi
}

start()
{
  auto_night_mode off
  black_white on
}

stop()
{
  auto_night_mode off
  black_white off
}

# restart = stop then start: service-watchdog, memory-guard, the MQTT bridge, the config import and the Settings
# pages call it (it was missing here: the call did nothing, rc27 tester R5)
restart() { stop; start; }

if [ $# -eq 0 ]; then
  start
else
  case $1 in start|stop|status|restart)
    $1
    ;;
  esac
fi

