#!/bin/sh
# https-server — Control script for tc100-httpsd (low-CPU TLS 1.2+ reverse proxy on :443 -> 127.0.0.1:80).

SERVICE_NAME="HTTPS Reverse Proxy"
# a plain PIDFILE= line: the Services page (www/cgi-bin/scripts.cgi, FAST_PIDFILE_SERVICES) reads it without running
# this script; HTTPSD_PIDFILE overrides it for the tests
PIDFILE="/var/run/https-server.pid"
[ -n "${HTTPSD_PIDFILE:-}" ] && PIDFILE="$HTTPSD_PIDFILE"
LOG="${HTTPSD_LOG:-/tmp/logs/https-server.log}"
BIN="${HTTPSD_BIN:-/mnt/ext/bin/tc100-httpsd}"
[ -x "$BIN" ] || BIN="/usr/bin/tc100-httpsd"
CONF="${HTTPSD_CONF:-/mnt/config/boot.conf}"
CERTDIR="${HTTPSD_CERTDIR:-/mnt/config}"

[ -r /mnt/scripts/common_functions.sh ] && . /mnt/scripts/common_functions.sh

bc()
{
  sed -n "s/^$1=[\"']\{0,1\}\([^\"' 	#]*\).*\$/\1/p" "$CONF" 2>/dev/null | tail -n 1
}

_is_uint()
{
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

_detect_lan_ip()
{
  _ip=""
  if command -v ip >/dev/null 2>&1; then
    for _dev in wlan0 eth0; do
      _ip="$(ip -4 addr show dev "$_dev" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\)\/.*/\1/p' | head -n 1)"
      [ -n "$_ip" ] && break
    done
  fi
  if [ -z "$_ip" ] && command -v ifconfig >/dev/null 2>&1; then
    _ip="$(ifconfig 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p' | grep -v '^127\.' | head -n 1)"
  fi
  printf '%s\n' "$_ip"
}

_pid_alive()
{
  _p="$1"
  [ -n "$_p" ] || return 1
  kill -0 "$_p" 2>/dev/null || return 1
  if [ -r "/proc/$_p/cmdline" ]; then
    grep -q 'tc100-httpsd' "/proc/$_p/cmdline" 2>/dev/null || return 1
  fi
  return 0
}

status()
{
  # the pidfile only, as the Services fast path reads it (start writes it; stop finds a stray daemon by name)
  _pid="$(cat "$PIDFILE" 2>/dev/null)"
  if _pid_alive "$_pid"; then
    echo "running (PID $_pid)"
    return 0
  fi
  echo "stopped" >&2
  return 1
}

health()
{
  _port="$(bc HTTPS_PORT)"
  _is_uint "$_port" || _port=443
  status >/dev/null || return 1
  if command -v port_listening >/dev/null 2>&1; then
    port_listening "$_port" || return 1
  fi
  echo "HEALTHY"
  return 0
}

start()
{
  _en="$(bc HTTPS)"
  # off unless switched on (owner 2026-11-28: HTTPS off by default; an absent key, a 3.0 boot.conf, is off too)
  case "$_en" in
    1|yes|on|true) ;;
    *) echo "$SERVICE_NAME: disabled in boot.conf (HTTPS=${_en:-unset})"; return 0 ;;
  esac

  [ -x "$BIN" ] || { echo "$SERVICE_NAME: binary missing ($BIN)" >&2; return 1; }

  _cur="$(cat "$PIDFILE" 2>/dev/null)"
  if _pid_alive "$_cur"; then
    echo "$SERVICE_NAME already running (PID $_cur)"
    return 0
  fi
  rm -f "$PIDFILE" 2>/dev/null || true

  _port="$(bc HTTPS_PORT)"
  _is_uint "$_port" && [ "$_port" -ge 1 ] && [ "$_port" -le 65535 ] || _port=443

  _bport="${HTTPS_BE_PORT:-80}"
  _is_uint "$_bport" && [ "$_bport" -ge 1 ] && [ "$_bport" -le 65535 ] || _bport=80

  _max="$(bc HTTPS_MAX_CONNS)"
  _is_uint "$_max" && [ "$_max" -ge 1 ] && [ "$_max" -le 8 ] || _max=4

  _nice="$(bc HTTPS_NICE)"
  case "$_nice" in
    ''|*[!-0-9]*) _nice=5 ;;
  esac

  _lockout="$(bc WEB_LOCKOUT)"
  [ "$_lockout" = "1" ] || _lockout=0

  _host="$(cat /etc/hostname 2>/dev/null)"
  [ -n "$_host" ] || _host="tc100"
  _ip="$(_detect_lan_ip)"

  mkdir -p "${LOG%/*}" "${PIDFILE%/*}" 2>/dev/null || true
  command -v secret_modes_fix >/dev/null 2>&1 && secret_modes_fix "$CERTDIR" 2>/dev/null || true

  _allow=""
  if command -v netacl_allow_list >/dev/null 2>&1; then
    _allow="$(netacl_allow_list 2>/dev/null)"
  fi
  _drop=""
  if command -v privdrop_opt >/dev/null 2>&1; then
    _drop="$(privdrop_opt net 2>/dev/null)"
  fi

  set -- -p "$_port" -b "$_bport" -c "$CERTDIR" -H "$_host" -m "$_max" -n "$_nice"
  [ -n "$_ip" ] && set -- "$@" -I "$_ip"
  [ "$_lockout" = "1" ] && set -- "$@" -L
  [ -n "$_drop" ] && set -- "$@" $_drop

  TC100_NET_ALLOW="$_allow" TC100_WEB_LOCKOUT="$_lockout" "$BIN" "$@" </dev/null >>"$LOG" 2>&1 &
  _dpid=$!

  _tries=0
  while [ "$_tries" -lt 10 ]; do
    kill -0 "$_dpid" 2>/dev/null || break
    if ! command -v port_listening >/dev/null 2>&1 || port_listening "$_port" 2>/dev/null; then
      echo "$_dpid" > "$PIDFILE"
      echo "$SERVICE_NAME started on :$_port (PID $_dpid)"
      return 0
    fi
    _tries=$((_tries + 1))
    usleep 100000 2>/dev/null || sleep 1
  done

  if kill -0 "$_dpid" 2>/dev/null; then
    echo "$_dpid" > "$PIDFILE"
    echo "$SERVICE_NAME started on :$_port (PID $_dpid)"
    return 0
  fi
  echo "$SERVICE_NAME failed to start (see $LOG)" >&2
  return 1
}

stop()
{
  _pid="$(cat "$PIDFILE" 2>/dev/null)"
  if _pid_alive "$_pid"; then
    kill "$_pid" 2>/dev/null || true
    _tries=0
    while [ "$_tries" -lt 10 ] && kill -0 "$_pid" 2>/dev/null; do
      _tries=$((_tries + 1))
      usleep 100000 2>/dev/null || sleep 1
    done
    kill -0 "$_pid" 2>/dev/null && kill -9 "$_pid" 2>/dev/null || true
  fi
  killall tc100-httpsd 2>/dev/null || true
  rm -f "$PIDFILE" 2>/dev/null || true
  echo "$SERVICE_NAME stopped"
  return 0
}

restart()
{
  stop >/dev/null 2>&1 || true
  start
}

case "${1:-start}" in
  start|stop|restart|status|health) "$1" ;;
  *) echo "Usage: $0 {start|stop|restart|status|health}" >&2; exit 1 ;;
esac
