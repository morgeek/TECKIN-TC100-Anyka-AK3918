diff --git a/drivers/net/wireless/realtek/rtl8xxxu/rtl8xxxu_core.c b/drivers/net/wireless/realtek/rtl8xxxu/rtl8xxxu_core.c
index 5d102a124..a1af92238 100644
--- a/drivers/net/wireless/realtek/rtl8xxxu/rtl8xxxu_core.c
+++ b/drivers/net/wireless/realtek/rtl8xxxu/rtl8xxxu_core.c
@@ -877,10 +877,19 @@ rtl8xxxu_writeN(struct rtl8xxxu_priv *priv, u16 addr, u8 *buf, u16 len)
 	remainder = len % blocksize;
 
 	for (i = 0; i < count; i++) {
-		ret = usb_control_msg(udev, usb_sndctrlpipe(udev, 0),
-				      REALTEK_USB_CMD_REQ, REALTEK_USB_WRITE,
-				      addr, 0, buf, blocksize,
-				      RTW_USB_CONTROL_MSG_TIMEOUT);
+		int try;
+
+		/* Anyka AK39 host: an EP0 OUT transfer occasionally fails once;
+		 * the vendor driver retries, so do the same. */
+		for (try = 0; try < 4; try++) {
+			ret = usb_control_msg(udev, usb_sndctrlpipe(udev, 0),
+					      REALTEK_USB_CMD_REQ, REALTEK_USB_WRITE,
+					      addr, 0, buf, blocksize,
+					      RTW_USB_CONTROL_MSG_TIMEOUT);
+			if (ret == blocksize)
+				break;
+			dev_info(&udev->dev, "writeN retry addr %04x ret %d\n", addr, ret);
+		}
 		if (ret != blocksize)
 			goto write_error;
 
@@ -901,8 +910,8 @@ rtl8xxxu_writeN(struct rtl8xxxu_priv *priv, u16 addr, u8 *buf, u16 len)
 
 write_error:
 	dev_info(&udev->dev,
-		 "%s: Failed to write block at addr: %04x size: %04x\n",
-		 __func__, addr, blocksize);
+		 "%s: Failed to write block at addr: %04x size: %04x (ret %d)\n",
+		 __func__, addr, blocksize, ret);
 	return -EAGAIN;
 }
 
