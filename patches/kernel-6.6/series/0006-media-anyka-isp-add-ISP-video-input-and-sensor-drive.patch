+
+    //lenc_reg_18
+    cmd = 0;
+    cmd = (LOW_BITS(p_lsc->lsc_gr_coef.coef_c[5], 10)<< LENS_COEF5_CC_GR)
+    	| (LOW_BITS(p_lsc->lsc_gb_coef.coef_c[5], 10)<< LENS_COEF5_CC_GB)
