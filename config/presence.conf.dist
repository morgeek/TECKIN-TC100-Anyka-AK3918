# Presence profiles. The camera starts in custom mode; the sample profiles do
# nothing until an owner saves and explicitly applies one.
PRESENCE_MODE=custom

# A profile stores only the actions it applies. The live settings remain in
# boot.conf, rtspserver.conf and notify.conf.
PRESENCE_PRESENT_CONFIGURED=0
PRESENCE_PRESENT_PRIVACY=0
PRESENCE_PRESENT_MOTION=0
PRESENCE_PRESENT_RECORDING=0
PRESENCE_PRESENT_NOTIFICATIONS=1

PRESENCE_AWAY_CONFIGURED=0
PRESENCE_AWAY_PRIVACY=0
PRESENCE_AWAY_MOTION=1
PRESENCE_AWAY_RECORDING=1
PRESENCE_AWAY_NOTIFICATIONS=1

PRESENCE_NIGHT_CONFIGURED=0
PRESENCE_NIGHT_PRIVACY=0
PRESENCE_NIGHT_MOTION=1
PRESENCE_NIGHT_RECORDING=1
PRESENCE_NIGHT_NOTIFICATIONS=1
