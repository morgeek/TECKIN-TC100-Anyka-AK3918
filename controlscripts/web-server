#!/bin/sh
# web-server — Unified control script for Elite TC100 Web Services

SERVICE_NAME="Elite Web Server"
CONFIGPATH="/mnt/config"

. /mnt/scripts/common_functions.sh

# httpfront on port 80 hands each connection to busybox httpd
status()
{
    _pid="$(pidof httpfront 2>/dev/null)"; _pid="${_pid%% *}"
    [ -n "$_pid" ] && { echo "PID: $_pid (httpfront)"; return 0; }
    _pid="$(pidof httpd 2>/dev/null)"; _pid="${_pid%% *}"
    [ -n "$_pid" ] && { echo "PID: $_pid (httpd)"; return 0; }
    return 1
}

# the pages need a login, a local request would get 401: the port must listen
health()
{
    status >/dev/null || return 1
    port_listening 80 && { echo "HEALTHY"; return 0; }
    return 1
}

start()
{
    http_server on
}

stop()
{
    http_server off
    rm -f "$PIDFILE" "$ULTRALITE_PIDFILE"
}

restart()
{
    http_server restart
}

if [ $# -eq 0 ]; then
    start
else
    case "$1" in
        start|stop|status|restart|health)
            "$1"
            ;;
        *)
            echo "Usage: $0 {start|stop|status|restart|health}" >&2
            exit 1
            ;;
    esac
fi
