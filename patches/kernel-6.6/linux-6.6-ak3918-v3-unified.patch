+int ak_isp_vo_get_inputdataw(void)
+{
+	int bits;
+	unsigned int cmd;
+
+	cmd = REG32(isp->base + GEN_CTRL_ADDR);
+	cmd >>= DATA_WIDTH;
+	cmd &= 0x3;
+	switch (cmd) {
+		case 0:
+			bits = 12;
+			break;
+		case 1:
+			bits = 10;
+			break;
+		case 2:
+			bits = 8;
+			break;
+		default:
+			bits = 0;
+			break;
+	}
+
+	return bits;
+}
