# macOS Finder metadata
.DS_Store
# Claude Code local overrides (personal, not shared)
.claude/settings.local.json

# Runtime artifacts generated during local upgrade/testing
log/*.log
!log/.gitignore

# Local host-side backup snapshots
backup/package-upgrades/
# Pre-deploy camera snapshots pulled over FTP by tools/deploy-full.sh
# (backup-<camera-ip>-<timestamp>/). Device state, never source.
backup-*/

# Accidental local symlink; runtime script recreates this on camera when needed
lib/libcurl.so.4

# Live configs (may hold credentials) — only the .dist templates are tracked;
# the camera seeds live copies from .dist at boot via install_config.
config/mqtt.conf
config/user.pwd
config/timelapse.conf
# Last-known-good snapshots and corruption quarantine written by the camera
config/.lkg/
config/*.conf.corrupt
node_modules/
# Last deployed commit, written by tools/deploy-full.sh (machine-local state)
.last-deploy-sha

# ── Development-only, not published ──────────────────────────────────────────
# The published repo is runtime-pure: only what runs on the SD card plus user
# docs. Build tooling, tests, CI, AI-assistant config and frontend source stay
# local (kept on disk; git rm --cached'd from the index). www/ ships the built
# assets, so frontend/src is not needed to use the project.
/CLAUDE.md
/package.json
/tools/
/frontend/
/.claude/
/.github/
