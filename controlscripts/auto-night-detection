#!/bin/sh
SERVICE_NAME="Auto Night Detection"
PIDFILE="/var/run/auto-night-detection.pid"

status()
{
  if [ -f "$PIDFILE" ]; then
    _pid="$(cat "$PIDFILE" 2>/dev/null)"
    if [ -n "$_pid" ] && kill -0 "$_pid" >/dev/null 2>&1; then
      echo "PID: $_pid"
      return 0
    fi
  fi
  return 1
}

start()
{
  if ! status >/dev/null 2>&1; then
    /mnt/scripts/auto-night-daemon.sh &
  fi
  /mnt/bin/rwconf /mnt/config/rtspserver.conf w " " daynight 2 2>/dev/null || true
  echo "Auto Night Detection started"
}

stop()
{
  if [ -f "$PIDFILE" ]; then
    _pid="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$_pid" ] && kill "$_pid" 2>/dev/null || true
    rm -f "$PIDFILE" 2>/dev/null || true
  fi
  /mnt/bin/rwconf /mnt/config/rtspserver.conf w " " daynight 3 2>/dev/null || true
  echo "Auto Night Detection stopped"
}

health()
{
  if status >/dev/null 2>&1; then
    echo "ok: running"
  else
    echo "warn: stopped"
  fi
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  status)
    status
    ;;
  health)
    health
    ;;
  *)
    start
    ;;
esac
