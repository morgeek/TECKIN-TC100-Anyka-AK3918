# Live image tuning (needs ISP_TUNE=1 in boot.conf). Applied within ~2 s,
# without restarting the stream. 0 / empty = value from the sensor ISP file.
# Effects: -50..50, relative to the ISP file.
BRIGHTNESS=0
CONTRAST=0
SATURATION=0
SHARPNESS=0
HUE=0
# Mains frequency for anti-flicker: 50 (Europe) or 60. Empty = unchanged.
POWER_HZ=
# Cap the auto-exposure time at a percentage of the ISP file value (10..100).
# Lower = less motion blur at night, darker image. Empty = no cap.
EXPOSURE_MAX_PCT=
# Temporal (3D) noise reduction. NR3D=0 turns it off, removing the line puts
# the ISP file's setting back. Measured on a TC100 (1080p, low indoor light):
# frame rate unchanged, bitrate +39 % (the encoder spends it on noise) —
# leave it on unless testing.
#NR3D=0
# Noise-reduction strength (test), percent of the ISP file's values, 25..400:
# spatial and temporal strengths of every gain level. Stronger = less noise
# and a lower bitrate at night, more smearing of moving things. Empty = 100.
#NR3D_STRENGTH=150
# Hardware privacy masks, drawn in Settings → Privacy & overlay: up to 4 areas,
# x1,y1,x2,y2 in percent of the picture (0,0 = top left). Painted by the ISP
# before encoding (streams, snapshots, recordings, Frigate), no CPU cost.
# MASK_COLOR: black, gray or white.
#MASK1=0,0,25,30
MASK_COLOR=black
