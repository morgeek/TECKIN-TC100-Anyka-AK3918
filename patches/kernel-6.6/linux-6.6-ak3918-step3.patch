+static void ak39_rx_drain(struct ak39_uart *u)
+{
+	struct uart_port *port = &u->port;
+	unsigned int wr, n = 0;
+	u32 st;
+	unsigned long flags;
+
+	spin_lock_irqsave(&port->lock, flags);
+	/*
+	 * After an RX timeout (line idle), a full buffer or a threshold hit the
+	 * receiver pauses until the status is write-cleared and RX_START set
+	 * again (4.4 uart_subint_clear()). Without this, input stops after the
+	 * first pause or 128 bytes.
+	 */
+	st = readl_relaxed(port->membase + UART_CONF2);
+	if (st & (BIT(1) | BIT(2) | BIT(30))) {
+		writel_relaxed((st & CONF2_INT_MASK) | (st & (BIT(1) | BIT(2) | BIT(30))),
+			       port->membase + UART_CONF2);
+		writel_relaxed(readl_relaxed(port->membase + BUF_THRESHOLD) | RX_START,
+			       port->membase + BUF_THRESHOLD);
+	}
+	wr = (readl_relaxed(port->membase + DATA_CONF) >> 13) & 0x7f;
+	while (u->rx_pos != wr) {
+		unsigned char c = readb_relaxed(u->rxbuf + u->rx_pos);
+
+		port->icount.rx++;
+		uart_insert_char(port, 0, 0, c, TTY_NORMAL);
+		u->rx_pos = (u->rx_pos + 1) % RX_RING;
+		n++;
+	}
+	spin_unlock_irqrestore(&port->lock, flags);
+	if (n)
+		tty_flip_buffer_push(&port->state->port);
+}
+
+/* 115200 baud fills the 128-byte ring in ~11 ms: the threshold (32 bytes)
+ * and timeout interrupts drain it; the timer only catches a lost interrupt. */
+static irqreturn_t ak39_rx_irq(int irq, void *dev)
+{
+	ak39_rx_drain(dev);
+	return IRQ_HANDLED;
+}
+
+static void ak39_rx_poll(struct timer_list *t)
+{
+	struct ak39_uart *u = from_timer(u, t, rx_timer);
+
+	ak39_rx_drain(u);
+	mod_timer(&u->rx_timer, jiffies + msecs_to_jiffies(RX_POLL_MS));
+}
+
+static int ak39_startup(struct uart_port *port)
+{
+	struct ak39_uart *u = container_of(port, struct ak39_uart, port);
+	void __iomem *b = port->membase;
+	u32 v;
+
+	/* clear the L2 RX buffer status, then the controller's RX state */
+	v = readl_relaxed(u->l2ctrl + L2_BUF_STATUS);
+	writel_relaxed(v | BIT(17 + port->line * 2), u->l2ctrl + L2_BUF_STATUS);
+	writel_relaxed(readl_relaxed(b + UART_CONF1) | CONF1_EN | CONF1_TIMEOUT_EN |
+		       CONF1_RX_STA_CLR, b + UART_CONF1);
+	writel_relaxed(0x1f << 16, b + STOPBIT_TIMEOUT);
+	v = readl_relaxed(b + BUF_THRESHOLD) & ~0x1f;
+	writel_relaxed(v | 0x1f, b + BUF_THRESHOLD);
+	writel_relaxed(readl_relaxed(b + BUF_THRESHOLD) | RX_TH_CLR, b + BUF_THRESHOLD);
+	udelay(10);
+	writel_relaxed(readl_relaxed(b + BUF_THRESHOLD) & ~RX_TH_CLR, b + BUF_THRESHOLD);
+	udelay(10);
+	writel_relaxed(readl_relaxed(b + BUF_THRESHOLD) | RX_START, b + BUF_THRESHOLD);
+	u->rx_pos = (readl_relaxed(b + DATA_CONF) >> 13) & 0x7f;
+	if (port->irq > 0 && !request_irq(port->irq, ak39_rx_irq, 0, "ak39-uart", u))
+		writel_relaxed((readl_relaxed(b + UART_CONF2) & CONF2_INT_MASK) |
+			       BIT(21) | BIT(22) | BIT(28), b + UART_CONF2);
+	timer_setup(&u->rx_timer, ak39_rx_poll, 0);
+	mod_timer(&u->rx_timer, jiffies + msecs_to_jiffies(RX_POLL_MS));
+	return 0;
+}
+
+static void ak39_shutdown(struct uart_port *port)
+{
+	struct ak39_uart *u = container_of(port, struct ak39_uart, port);
+
+	del_timer_sync(&u->rx_timer);
+	if (port->irq > 0) {
+		writel_relaxed(readl_relaxed(port->membase + UART_CONF2) &
+			       CONF2_INT_MASK & ~(BIT(21) | BIT(22) | BIT(28)),
+			       port->membase + UART_CONF2);
+		free_irq(port->irq, u);
+	}
+}
