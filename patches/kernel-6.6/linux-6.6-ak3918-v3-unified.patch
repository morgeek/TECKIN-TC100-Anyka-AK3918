+int ak_isp_acquire(int (*set_style)(void *context, unsigned int style),
+		   void *context)
+{
+	int err;
+	void *base;
+	AK_ISP_FUNC_CB cb;
+	AK_ISP_SENSOR_CB *sensor_cb;
+
+
+	if (!priv)
+		return -EPROBE_DEFER;
+	mutex_lock(&priv->lock);
+	sensor_cb = ak_sensor_get_sensor_cb();
+	if (!sensor_cb) {
+		err = -EPROBE_DEFER;
+		goto fail_req4reg;
+	}
+
+	if (priv->base) {
+		pr_debug("isp already initialised\n");
+		goto fini;
+	}
+
+	cb.cb_printk	= (ISPDRV_CB_PRINTK)_printk;
+	cb.cb_memcpy	= (ISPDRV_CB_MEMCPY)memcpy;
+	cb.cb_memset	= (ISPDRV_CB_MEMSET)memset;
+	cb.cb_malloc	= (ISPDRV_CB_MALLOC)ispmalloc;
+	cb.cb_free		= (ISPDRV_CB_FREE)ispfree;
+	cb.cb_dmamalloc	= dmamalloc;
+	cb.cb_dmafree	= dmafree;
+	cb.cb_msleep	= (ISPDRV_CB_MSLEEP)msleep;
+	
+	if (!request_mem_region(AKISP_REG_MEM_START, RESOURCE_SIZE, AKISP_DEV_NAME)) {
+		err = -EBUSY;
+		goto fail_req4reg;
+	}
+
+	base = ioremap(AKISP_REG_MEM_START, RESOURCE_SIZE);
+	if (!base) {
+		err = -ENOMEM;
+		goto fail_ior4reg;
+	}
+
+	err = isp2_module_init(&cb, sensor_cb, base);
+	if (err) {
+		goto fail_isp2_init;
+	}
+	priv->base = base;
+
+fini:
+	priv->set_style = set_style;
+	priv->capture_context = context;
+	priv->capture_users++;
+	mutex_unlock(&priv->lock);
+	return 0;
+
+fail_isp2_init:
+	iounmap(base);
+fail_ior4reg:
+	release_mem_region(AKISP_REG_MEM_START, RESOURCE_SIZE);
+fail_req4reg:
+	mutex_unlock(&priv->lock);
+	return err;
+}
+EXPORT_SYMBOL_GPL(ak_isp_acquire);
+
+int ak_isp_prepare(struct device *dev)
+{
+	int ret, sensor_id;
+
+	if (!priv)
+		return -ENODEV;
+	mutex_lock(&priv->lock);
+	if (!priv->capture_users || !priv->base || !priv->sensor_cb ||
+	    !priv->sensor_cb->sensor_read_id_func) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (priv->prepared) {
+		ret = 0;
+		goto out;
+	}
+	sensor_id = priv->sensor_cb->sensor_read_id_func();
+	if (sensor_id <= 0) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (!priv->tuning.firmware) {
+		ret = ak_isp_tuning_load(dev, tuning_firmware, sensor_id, &priv->tuning);
+		if (ret) {
+			/* TC100: no usable tuning; run on the ISP defaults */
+			dev_warn(dev, "ISP tuning not loaded (%d), using defaults\n", ret);
+			priv->tuning_style = 0;
+			priv->prepared = true;
+			ret = 0;
+			goto out;
+		}
+	}
+	ret = ak_isp_tuning_apply(&priv->tuning, 0, priv->sensor_cb, true);
+	if (!ret) {
+		priv->tuning_style = 0;
+		priv->prepared = true;
+	}
+out:
+	mutex_unlock(&priv->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ak_isp_prepare);
+
+int ak_isp_apply_tuning_style(unsigned int style)
+{
+	int ret;
+
+	if (!priv)
+		return -ENODEV;
+	mutex_lock(&priv->lock);
+	if (!priv->capture_users || !priv->prepared) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (style >= priv->tuning.style_count) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = ak_isp_tuning_apply(&priv->tuning, style, priv->sensor_cb, false);
+	if (!ret)
+		priv->tuning_style = style;
+	else
+		priv->prepared = false;
+out:
+	mutex_unlock(&priv->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ak_isp_apply_tuning_style);
+
+int ak_isp_get_awb_auto(int *enabled)
+{
+	AK_ISP_WB_TYPE_ATTR type;
+	int ret;
+
+	if (!priv || !enabled)
+		return -ENODEV;
+	mutex_lock(&priv->lock);
+	if (!priv->capture_users || !priv->prepared) {
+		ret = -ENODEV;
+		goto out;
+	}
+	ret = ak_isp_vp_get_wb_type(&type);
+	if (!ret) {
+		if (type.wb_type > 1)
+			ret = -EIO;
+		else
+			*enabled = type.wb_type;
+	}
+out:
+	mutex_unlock(&priv->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ak_isp_get_awb_auto);
+
+int ak_isp_set_awb_auto(int enabled)
+{
+	AK_ISP_WB_TYPE_ATTR type;
+	int ret;
+
+	if (enabled != 0 && enabled != 1)
+		return -EINVAL;
+	if (!priv)
+		return -ENODEV;
+	mutex_lock(&priv->lock);
+	if (!priv->capture_users || !priv->prepared)
+		ret = -ENODEV;
+	else {
+		type.wb_type = enabled;
+		ret = ak_isp_vp_set_wb_type(&type);
+	}
+	mutex_unlock(&priv->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ak_isp_set_awb_auto);
+
+static void akisp_put_locked(void)
+{
+	if (priv->capture_users)
+		return;
+
+	isp2_module_fini();
+	iounmap(priv->base);
+	release_mem_region(AKISP_REG_MEM_START, RESOURCE_SIZE);
+	priv->base = NULL;
+	ak_isp_tuning_free(&priv->tuning);
+}
+
+void ak_isp_release(void)
+{
+	if (!priv)
+		return;
+	mutex_lock(&priv->lock);
+	if (WARN_ON(!priv->capture_users)) {
+		mutex_unlock(&priv->lock);
+		return;
+	}
+	priv->capture_users--;
+	if (!priv->capture_users) {
+		priv->prepared = false;
+		priv->set_style = NULL;
+		priv->capture_context = NULL;
+	}
+	akisp_put_locked();
+	mutex_unlock(&priv->lock);
+}
+EXPORT_SYMBOL_GPL(ak_isp_release);
+
+static int akisp_open(struct inode *node, struct file *file)
+{
+	int ret = 0;
+
+	if (!priv)
+		return -ENODEV;
+	mutex_lock(&priv->lock);
+	if (!priv->capture_users || !priv->prepared)
+		ret = -ENODEV;
+	mutex_unlock(&priv->lock);
+	return ret;
+}
+
+static int akisp_release(struct inode *node, struct file *file)
+{
+	return 0;
+}
+
+static const struct file_operations akisp_ops = {
+	.owner	= THIS_MODULE,
+	.open	= akisp_open,
+	.release = akisp_release,
+	.unlocked_ioctl	= akisp_ioctl,
+};
+
+static struct miscdevice akisp_dev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = AKISP_DEV_NAME,
+	.fops = &akisp_ops,
+	.mode	= 0600,
+};
+
+int __init akisp_init(void)
+{
+	int err = 0;
+
+	priv = kzalloc(sizeof(struct akisp_char_pirv), GFP_KERNEL);
+	if (!priv) {
+		pr_err("%s: no mem\n", __func__);
+		err = -ENOMEM;
+		return err;
+	}
+
+	mutex_init(&priv->lock);
+
+	/* Install a callback that was registered before priv existed. */
+	if (pending_sensor_cb) {
+		priv->sensor_cb = pending_sensor_cb;
+		pending_sensor_cb = NULL;
+	}
+	err = misc_register(&akisp_dev);
+	if (err) {
+		kfree(priv);
+		priv = NULL;
+		return err;
+	}
+
+	return 0;
+}
+
+void __exit akisp_exit(void)
+{
+	misc_deregister(&akisp_dev);
+	kfree(priv);
+	priv = NULL;
+}
+
+module_init(akisp_init);
+module_exit(akisp_exit);
+
+MODULE_AUTHOR("Anyka Microelectronic Ltd.");
+MODULE_DESCRIPTION("Anyka isp apply for user space control");
+MODULE_ALIAS("Anyka ISP Apply");
+MODULE_LICENSE("GPL");
+
